SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=ChromiumFlags
SQLSERVER_USER=chromium_flags_reader
SQLSERVER_PASSWORD=change-me
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=false
SQLSERVER_REQUEST_TIMEOUT_MS=120000
SQLSERVER_POOL_MAX=10

GERRIT_BASE_URL=https://chromium-review.googlesource.com
GERRIT_PAGE_SIZE=100
GERRIT_MAX_PAGES=0
GERRIT_OPTIONS=81
GERRIT_INITIAL_MERGE_AFTER=
GERRIT_FETCH_RETRY_COUNT=3
GERRIT_FETCH_RETRY_DELAY_MS=1500
GERRIT_PATCH_UPLOAD_URL=
GERRIT_PATCH_UPLOAD_SECRET=
GERRIT_PATCH_UPLOAD_CONCURRENCY=4
GERRIT_PATCH_UPLOAD_BATCH_SIZE=250
GERRIT_PATCH_UPLOAD_TIMEOUT_MS=60000
GERRIT_PATCH_UPLOAD_RETRY_COUNT=3
