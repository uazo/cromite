{
  "name": "cromite-gerrit-tools",
  "private": true,
  "version": "0.1.0",
  "description": "Gerrit synchronization, patch storage, versioning and matching tools.",
  "scripts": {
    "gerrit:sync": "tsx --env-file=.env sync_gerrit.ts",
    "postgerrit:sync": "npm run gerrit:versions",
    "gerrit:versions": "tsx --env-file=.env rebuild_change_versions.ts",
    "test": "tsx --test diff_utils.test.ts patch_upload.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
