@@ -0,0 +1,257 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.privacy.secure_dns;
+
+import android.animation.ValueAnimator;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.RectF;
+import android.graphics.drawable.Drawable;
+import android.util.AttributeSet;
+import android.view.View;
+import android.view.animation.DecelerateInterpolator;
+
+import androidx.annotation.ColorInt;
+import androidx.core.graphics.ColorUtils;
+
+import com.google.android.material.color.MaterialColors;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+/**
+ * CromIKO: the animated top of the CromIKO DNS screen. The DNS icon glows in the middle, inside
+ * orbits like the ring of the CromIKO mascot, with queries going round them and stars of the logo
+ * twinkling around. Off, it is gray and still; testing the provider sends waves from the middle.
+ * The colors are the ones of the theme, so they follow the accent color.
+ */
+@NullMarked
+public class CromikoDnsOrbitView extends View {
+    // The orbits: width and height (in dp), tilt (in degrees) and the time of a turn of a query.
+    private static final float[][] ORBITS = {
+        {150, 52, -18, 5200}, {200, 70, 24, 7300}, {250, 88, -62, 9800},
+    };
+    // The stars: position (fraction of the width and height) and size (in dp).
+    private static final float[][] STARS = {
+        {0.16f, 0.24f, 9}, {0.84f, 0.20f, 12}, {0.10f, 0.74f, 7}, {0.88f, 0.78f, 8},
+        {0.70f, 0.08f, 6},
+    };
+    private static final int TRAIL = 6;
+
+    private final float mDensity;
+    private final Paint mFill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mStroke = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Path mStar = new Path();
+    private final RectF mOval = new RectF();
+    private final @Nullable Drawable mIcon;
+    private final ValueAnimator mClock = ValueAnimator.ofFloat(0f, 1f);
+    private final ValueAnimator mSwitch = ValueAnimator.ofFloat(0f, 1f);
+    private long mStartMs = System.currentTimeMillis();
+    // 0 when off, 1 when on, in between while switching.
+    private float mOn;
+    private boolean mTesting;
+    private long mTestStartMs;
+    private @ColorInt int mResultColor;
+    private long mResultMs;
+
+    /** Constructor for inflating from XML. */
+    public CromikoDnsOrbitView(Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+        mDensity = getResources().getDisplayMetrics().density;
+        mStroke.setStyle(Paint.Style.STROKE);
+        mStroke.setStrokeCap(Paint.Cap.ROUND);
+        mIcon = context.getDrawable(R.drawable.cromiko_ic_dns_24dp);
+        mClock.setDuration(1000);
+        mClock.setRepeatCount(ValueAnimator.INFINITE);
+        mClock.addUpdateListener(animator -> invalidate());
+        mSwitch.setDuration(700);
+        mSwitch.setInterpolator(new DecelerateInterpolator());
+        mSwitch.addUpdateListener(
+                animator -> {
+                    mOn = (float) animator.getAnimatedValue();
+                    invalidate();
+                });
+        setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
+    }
+
+    /** Shows CromIKO DNS on or off, animated unless |animate| is false. */
+    public void setOn(boolean on, boolean animate) {
+        float target = on ? 1f : 0f;
+        mSwitch.cancel();
+        if (!animate || !ValueAnimator.areAnimatorsEnabled()) {
+            mOn = target;
+            invalidate();
+            return;
+        }
+        mSwitch.setFloatValues(mOn, target);
+        mSwitch.start();
+    }
+
+    /** Sends waves from the middle while the provider is tested. */
+    public void setTesting(boolean testing) {
+        mTesting = testing;
+        mTestStartMs = System.currentTimeMillis();
+        updateClock();
+        invalidate();
+    }
+
+    /** Flashes the middle after a test: in the accent color if it worked, in red if not. */
+    public void showResult(boolean ok) {
+        mResultColor = ok ? accent() : MaterialColors.getColor(this, R.attr.colorError);
+        mResultMs = System.currentTimeMillis();
+        invalidate();
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        mStartMs = System.currentTimeMillis();
+        updateClock();
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        mClock.cancel();
+        mSwitch.cancel();
+        super.onDetachedFromWindow();
+    }
+
+    @Override
+    public void onVisibilityAggregated(boolean isVisible) {
+        super.onVisibilityAggregated(isVisible);
+        updateClock();
+    }
+
+    // Runs the clock of the animation while the view shows and animations are on.
+    private void updateClock() {
+        boolean run =
+                isAttachedToWindow()
+                        && isShown()
+                        && ValueAnimator.areAnimatorsEnabled();
+        if (run && !mClock.isStarted()) {
+            mClock.start();
+        } else if (!run && mClock.isStarted()) {
+            mClock.cancel();
+        }
+    }
+
+    private @ColorInt int accent() {
+        return MaterialColors.getColor(this, R.attr.colorPrimary);
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        // Motion only with animations on: otherwise this draws one still frame.
+        float t =
+                ValueAnimator.areAnimatorsEnabled()
+                        ? (System.currentTimeMillis() - mStartMs) / 1000f
+                        : 0.35f;
+        float cx = getWidth() / 2f;
+        float cy = getHeight() / 2f;
+        float d = mDensity;
+        @ColorInt int off = MaterialColors.getColor(this, R.attr.colorOnSurfaceVariant);
+        @ColorInt int color = ColorUtils.blendARGB(off, accent(), mOn);
+        // A smaller drawing that grows when CromIKO DNS turns on.
+        float scale = Math.min(1f, getHeight() / (100 * d * 2.2f)) * (0.86f + 0.14f * mOn);
+
+        // Glow behind the middle.
+        float pulse = 0.5f + 0.5f * (float) Math.sin(t * 2.2);
+        mFill.setColor(color);
+        mFill.setAlpha(Math.round((24 + 20 * pulse) * mOn));
+        canvas.drawCircle(cx, cy, (52 + 8 * pulse) * d * scale, mFill);
+
+        // Orbits, with the queries that go round them.
+        for (int i = 0; i < ORBITS.length; i++) {
+            float[] orbit = ORBITS[i];
+            float rx = orbit[0] / 2 * d * scale;
+            float ry = orbit[1] / 2 * d * scale;
+            canvas.save();
+            canvas.rotate(orbit[2], cx, cy);
+            mStroke.setColor(color);
+            mStroke.setAlpha(Math.round(255 * (0.18f + 0.22f * mOn) * (1 - i * 0.18f)));
+            mStroke.setStrokeWidth(2 * d);
+            mOval.set(cx - rx, cy - ry, cx + rx, cy + ry);
+            canvas.drawOval(mOval, mStroke);
+            if (mOn > 0) {
+                double angle = 2 * Math.PI * (t * 1000 / orbit[3] + i * 0.37);
+                for (int k = TRAIL; k >= 0; k--) {
+                    double a = angle - k * 0.12;
+                    mFill.setColor(color);
+                    mFill.setAlpha(Math.round(255 * mOn * (1 - k / (float) (TRAIL + 1))));
+                    canvas.drawCircle(
+                            cx + rx * (float) Math.cos(a),
+                            cy + ry * (float) Math.sin(a),
+                            (k == 0 ? 4.5f : 3.2f - k * 0.3f) * d,
+                            mFill);
+                }
+            }
+            canvas.restore();
+        }
+
+        // Waves while testing the provider.
+        if (mTesting) {
+            float since = (System.currentTimeMillis() - mTestStartMs) / 1000f;
+            for (int k = 0; k < 3; k++) {
+                float phase = (since + k / 3f) % 1f;
+                mStroke.setColor(accent());
+                mStroke.setAlpha(Math.round(200 * (1 - phase)));
+                mStroke.setStrokeWidth(3 * d);
+                canvas.drawCircle(cx, cy, (40 + 90 * phase) * d * scale, mStroke);
+            }
+        }
+
+        // The middle, with the DNS icon, and the flash of the last test.
+        float radius = 36 * d * scale;
+        mFill.setColor(color);
+        canvas.drawCircle(cx, cy, radius, mFill);
+        float flash = 1 - Math.min(1f, (System.currentTimeMillis() - mResultMs) / 900f);
+        if (flash > 0 && mResultMs > 0) {
+            mStroke.setColor(mResultColor);
+            mStroke.setAlpha(Math.round(255 * flash));
+            mStroke.setStrokeWidth(5 * d);
+            canvas.drawCircle(cx, cy, radius + (1 - flash) * 18 * d, mStroke);
+        }
+        if (mIcon != null) {
+            int half = Math.round(18 * d * scale);
+            mIcon.setTint(
+                    ColorUtils.blendARGB(
+                            Color.WHITE,
+                            MaterialColors.getColor(this, R.attr.colorOnPrimary),
+                            mOn));
+            mIcon.setBounds(
+                    Math.round(cx) - half,
+                    Math.round(cy) - half,
+                    Math.round(cx) + half,
+                    Math.round(cy) + half);
+            mIcon.draw(canvas);
+        }
+
+        // Stars of the logo, twinkling.
+        for (int i = 0; i < STARS.length; i++) {
+            float[] star = STARS[i];
+            float twinkle = 0.5f + 0.5f * (float) Math.sin(t * 1.7 + i * 1.3);
+            float size = star[2] * d * (0.6f + 0.4f * twinkle) * (0.5f + 0.5f * mOn);
+            mFill.setColor(color);
+            mFill.setAlpha(Math.round(255 * (0.25f + 0.75f * mOn) * (0.35f + 0.65f * twinkle)));
+            drawStar(canvas, star[0] * getWidth(), star[1] * getHeight(), size);
+        }
+    }
+
+    // A star with four points, like the one of the CromIKO logo.
+    private void drawStar(Canvas canvas, float x, float y, float r) {
+        float c = r * 0.18f;
+        mStar.reset();
+        mStar.moveTo(x, y - r);
+        mStar.quadTo(x + c, y - c, x + r, y);
+        mStar.quadTo(x + c, y + c, x, y + r);
+        mStar.quadTo(x - c, y + c, x - r, y);
+        mStar.quadTo(x - c, y - c, x, y - r);
+        mStar.close();
+        canvas.drawPath(mStar, mFill);
+    }
+}
