@@ -0,0 +1,98 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.privacy.secure_dns;
+
+import androidx.annotation.IntDef;
+import androidx.annotation.StringRes;
+
+import org.chromium.build.annotations.NullMarked;
+
+import java.lang.annotation.Retention;
+import java.lang.annotation.RetentionPolicy;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * CromIKO: what the providers of CromIKO DNS filter, from their DoH templates, and their order on
+ * the CromIKO DNS screen: Quad9, the default, then the ones that block ads, the family filters, the
+ * ones that block malware, and the unfiltered ones.
+ */
+@NullMarked
+final class CromikoDnsProviders {
+    /** What a provider filters. */
+    @IntDef({Filter.ADS, Filter.FAMILY, Filter.MALWARE, Filter.NONE})
+    @Retention(RetentionPolicy.SOURCE)
+    @interface Filter {
+        int ADS = 0;
+        int FAMILY = 1;
+        int MALWARE = 2;
+        int NONE = 3;
+    }
+
+    /** The DoH template of the provider that CromIKO uses by default. */
+    static final String RECOMMENDED = "https://dns.quad9.net/dns-query";
+
+    private CromikoDnsProviders() {}
+
+    /** Returns what the provider of the DoH template |config| filters. */
+    static @Filter int getFilter(String config) {
+        String template = config.toLowerCase(Locale.ROOT);
+        if (template.contains("family") || template.contains("//clean.")) return Filter.FAMILY;
+        if (template.contains("unfiltered") || template.contains("//blank.")) return Filter.NONE;
+        if (template.contains("adblock")
+                || template.contains("//dns.adguard-dns.com")
+                || template.contains("//dnsforge.de")) {
+            return Filter.ADS;
+        }
+        if (template.contains("quad9")
+                || template.contains("protective")
+                || template.contains("security")
+                || template.contains("opendns")) {
+            return Filter.MALWARE;
+        }
+        return Filter.NONE;
+    }
+
+    /** Returns the name of |filter|, for the tag of the providers. */
+    static @StringRes int getFilterName(@Filter int filter) {
+        switch (filter) {
+            case Filter.ADS:
+                return R.string.cromiko_dns_filter_ads;
+            case Filter.FAMILY:
+                return R.string.cromiko_dns_filter_family;
+            case Filter.MALWARE:
+                return R.string.cromiko_dns_filter_malware;
+            default:
+                return R.string.cromiko_dns_filter_none;
+        }
+    }
+
+    /** Whether |config| is the provider that CromIKO uses by default. */
+    static boolean isRecommended(String config) {
+        return RECOMMENDED.equals(config);
+    }
+
+    /** Returns the first letter or digit of |name|, for the circle of a provider. */
+    static String getMonogram(String name) {
+        for (int i = 0; i < name.length(); i++) {
+            char c = name.charAt(i);
+            if (Character.isLetterOrDigit(c)) {
+                return String.valueOf(c).toUpperCase(Locale.getDefault());
+            }
+        }
+        return "?";
+    }
+
+    /** Returns |providers| in the order of the screen. */
+    static List<SecureDnsBridge.Entry> sort(List<SecureDnsBridge.Entry> providers) {
+        List<SecureDnsBridge.Entry> sorted = new ArrayList<>(providers);
+        sorted.sort(
+                Comparator.<SecureDnsBridge.Entry>comparingInt(e -> isRecommended(e.config) ? 0 : 1)
+                        .thenComparingInt(e -> getFilter(e.config))
+                        .thenComparing(e -> e.name.toLowerCase(Locale.ROOT)));
+        return sorted;
+    }
+}
