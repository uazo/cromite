+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.cromiko;
+
+import org.jni_zero.NativeMethods;
+
+import org.chromium.base.Callback;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.content_public.browser.WebContents;
+
+/**
+ * CromIKO: runs scripts of CromIKO features in the main frame of a page. They run in an isolated
+ * world, so the page cannot see or change their variables, but they share the DOM with it.
+ */
+@NullMarked
+public final class CromikoPageScripts {
+    private CromikoPageScripts() {}
+
+    /**
+     * Runs a script in the main frame of a page.
+     *
+     * @param webContents The page.
+     * @param script The script.
+     * @param callback Called with the value of the script: a string as it is, any other value as
+     *     JSON, or an empty string if the script could not run.
+     */
+    public static void execute(WebContents webContents, String script, Callback<String> callback) {
+        CromikoPageScriptsJni.get().execute(webContents, script, callback);
+    }
+
+    @NativeMethods
+    interface Natives {
+        void execute(WebContents webContents, String script, Callback<String> callback);
+    }
+}
