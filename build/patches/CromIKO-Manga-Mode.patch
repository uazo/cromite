+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+//
+// CromIKO manga mode, run by CromikoMangaMode.java in an isolated world of the
+// page. The Java side replaces the arguments placeholder at the end with
+// (command, config, texts) and reads the returned JSON.
+//
+// Commands:
+//   "pick"  Ask the user to tap the next chapter button, the previous chapter
+//           button and a page of the chapter. Then save the result (read by
+//           "poll") and open the reader.
+//   "poll"  Return the state of "pick": picking, done (with the config),
+//           cancelled or idle.
+//   "read"  Open the reader now, waiting for the chapter images if needed.
+//   "auto"  Like "read", after a page load: only on chapter pages, and not
+//           again on a page where the user closed the reader.
+//   "stop"  Close the picker or the reader.
+//   "state" Return what is running.
+//
+// The reader keeps the page itself and hides everything except the chapter
+// images, which are shown at full width on black. The page keeps scrolling
+// normally, so sites that load their images while scrolling keep working;
+// images that appear later are styled as they come.
+
+(function(command, config, texts) {
+  'use strict';
+  if (!window.__cromikoManga) {
+    window.__cromikoManga = createManga();
+  }
+  return JSON.stringify(window.__cromikoManga.run(command, config, texts));
+
+  function createManga() {
+    const ACCENT = '#5C7CFC';
+    const LAZY_ATTRIBUTES =
+        ['data-src', 'data-lazy-src', 'data-original', 'data-url', 'data-cfsrc'];
+    const NOT_RENDERED =
+        new Set(['SCRIPT', 'STYLE', 'LINK', 'META', 'NOSCRIPT', 'TEMPLATE']);
+    const MEDIA = 'img, canvas';
+    // How long "read" and "auto" wait for the chapter images to appear.
+    const WAIT_MS = 20000;
+
+    let t = {};
+    let picker = null;
+    let reader = null;
+    let waiter = null;
+    let pickState = 'idle';
+    let pickResult = null;
+    // The user closed the reader on this page: "auto" leaves it closed.
+    let dismissed = false;
+
+    function run(cmd, cfg, txt) {
+      if (txt) {
+        t = txt;
+      }
+      switch (cmd) {
+        case 'pick':
+          stopAll();
+          startPicker();
+          return {state: 'picking'};
+        case 'poll': {
+          const result = {state: pickState};
+          if (pickState === 'done') {
+            result.config = pickResult;
+          }
+          if (pickState !== 'picking') {
+            pickState = 'idle';
+          }
+          return result;
+        }
+        case 'read':
+          dismissed = false;
+          stopAll();
+          return {state: waitAndRead(cfg, false)};
+        case 'auto':
+          if (dismissed || reader || picker || waiter) {
+            return {state: 'skipped'};
+          }
+          return {state: waitAndRead(cfg, true)};
+        case 'stop':
+          stopAll();
+          return {state: 'stopped'};
+        case 'state':
+          return {
+            state: picker ? 'picking' : reader ? 'reading' :
+                                                 waiter ? 'waiting' : 'idle',
+            buttonsHidden: !!reader && reader.wrap.classList.contains('hidden'),
+          };
+      }
+      return {state: 'unknown'};
+    }
+
+    function stopAll() {
+      stopWaiting();
+      if (picker) {
+        stopPicker('cancelled');
+      }
+      if (reader) {
+        stopReader();
+      }
+    }
+
+    // ---------------------------------------------------------------------
+    // Helpers
+
+    function norm(text) {
+      return (text || '').replace(/\s+/g, ' ').trim().slice(0, 60);
+    }
+
+    function labelOf(el) {
+      return norm(el.getAttribute('aria-label') || el.getAttribute('title') ||
+                  el.textContent);
+    }
+
+    // Ids and classes that change from page to page, or that only describe a
+    // state, are no use in a selector that must work on the next chapter.
+    function isStableName(name) {
+      return !!name && name.length <= 40 && !/\d{3,}/.test(name) &&
+          !/[0-9a-f]{8,}/i.test(name) &&
+          !/(^|[-_])(active|hover|focus|selected|current|disabled|lazy\w*|loaded|loading|show|shown|visible|hidden|fade\w*|animated?|in-view)$/i
+               .test(name);
+    }
+
+    function stableClasses(el) {
+      return [...el.classList].filter(isStableName).slice(0, 3);
+    }
+
+    function simpleSelector(el) {
+      let selector = el.tagName.toLowerCase();
+      for (const name of stableClasses(el)) {
+        selector += '.' + CSS.escape(name);
+      }
+      return selector;
+    }
+
+    function isUnique(selector, el) {
+      try {
+        const found = document.querySelectorAll(selector);
+        return found.length === 1 && found[0] === el;
+      } catch (e) {
+        return false;
+      }
+    }
+
+    // A CSS selector for |el| that should also find the same element on
+    // other chapters of the site.
+    function selectorFor(el) {
+      if (el.id && isStableName(el.id) && isUnique('#' + CSS.escape(el.id), el)) {
+        return '#' + CSS.escape(el.id);
+      }
+      const own = simpleSelector(el);
+      if (own.includes('.') && isUnique(own, el)) {
+        return own;
+      }
+      const parts = [];
+      for (let node = el; node && node !== document.documentElement;
+           node = node.parentElement) {
+        if (node !== el && node.id && isStableName(node.id)) {
+          parts.unshift('#' + CSS.escape(node.id));
+          break;
+        }
+        let part = simpleSelector(node);
+        const parent = node.parentElement;
+        if (parent) {
+          const sameTag =
+              [...parent.children].filter(c => c.tagName === node.tagName);
+          if (sameTag.length > 1 &&
+              [...parent.children].filter(c => c.matches(part)).length > 1) {
+            part += ':nth-of-type(' + (sameTag.indexOf(node) + 1) + ')';
+          }
+        }
+        parts.unshift(part);
+        if (node === document.body) {
+          break;
+        }
+        const selector = parts.join(' > ');
+        if (isUnique(selector, el)) {
+          return selector;
+        }
+      }
+      return parts.join(' > ');
+    }
+
+    function queryAll(selector) {
+      try {
+        return selector ? [...document.querySelectorAll(selector)] : [];
+      } catch (e) {
+        return [];
+      }
+    }
+
+    function isDisabled(el) {
+      return el.disabled || el.getAttribute('aria-disabled') === 'true' ||
+          el.classList.contains('disabled');
+    }
+
+    function hasLazyHint(el) {
+      return el.tagName === 'IMG' &&
+          (LAZY_ATTRIBUTES.some(name => el.hasAttribute(name)) ||
+           el.loading === 'lazy' || /lazy/i.test(el.className) ||
+           !el.getAttribute('src'));
+    }
+
+    function isPlaceholder(el) {
+      return el.tagName === 'IMG' &&
+          (!el.complete || el.naturalWidth < 50 ||
+           (el.currentSrc || el.src || '').startsWith('data:'));
+    }
+
+    // ---------------------------------------------------------------------
+    // Shadow DOM user interface, outside of <body> so the reader never hides
+    // it.
+
+    function createHost(css) {
+      const host = document.createElement('div');
+      host.setAttribute('data-cromiko-manga', '');
+      for (const [name, value] of Object.entries({
+             all: 'initial',
+             position: 'fixed',
+             top: '0',
+             left: '0',
+             width: '0',
+             height: '0',
+             'z-index': '2147483647',
+           })) {
+        host.style.setProperty(name, value, 'important');
+      }
+      const root = host.attachShadow({mode: 'closed'});
+      // A constructed style sheet is not blocked by the Content Security
+      // Policy of the page, unlike a <style> element.
+      try {
+        const sheet = new CSSStyleSheet();
+        sheet.replaceSync(css);
+        root.adoptedStyleSheets = [sheet];
+      } catch (e) {
+        const style = document.createElement('style');
+        style.textContent = css;
+        root.appendChild(style);
+      }
+      document.documentElement.appendChild(host);
+      return {host, root};
+    }
+
+    function element(tag, className, parent, text) {
+      const el = document.createElement(tag);
+      if (className) {
+        el.className = className;
+      }
+      if (text) {
+        el.textContent = text;
+      }
+      if (parent) {
+        parent.appendChild(el);
+      }
+      return el;
+    }
+
+    const SVG_NS = 'http://www.w3.org/2000/svg';
+
+    function icon(parent, path) {
+      const svg = document.createElementNS(SVG_NS, 'svg');
+      svg.setAttribute('viewBox', '0 0 24 24');
+      svg.setAttribute('aria-hidden', 'true');
+      const p = document.createElementNS(SVG_NS, 'path');
+      p.setAttribute('d', path);
+      svg.appendChild(p);
+      parent.appendChild(svg);
+      return svg;
+    }
+
+    const ICON_PREV = 'M15.4 7.4 14 6l-6 6 6 6 1.4-1.4L10.8 12z';
+    const ICON_NEXT = 'M8.6 16.6 10 18l6-6-6-6-1.4 1.4 4.6 4.6z';
+    const ICON_CLOSE =
+        'M19 6.4 17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12z';
+
+    function isOurs(event, host) {
+      return host && event.composedPath().includes(host);
+    }
+
+    // ---------------------------------------------------------------------
+    // Picker
+
+    const PICKER_CSS = `
+      .bar { position: fixed; left: 8px; right: 8px; top: 8px;
+        background: rgba(20, 22, 28, 0.94); color: #fff; border-radius: 16px;
+        padding: 12px 14px; font: 15px/1.35 system-ui, sans-serif;
+        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.4);
+        border: 1px solid rgba(255, 255, 255, 0.12); }
+      .step { font-size: 12px; color: ${ACCENT}; font-weight: 600;
+        letter-spacing: 0.04em; }
+      .text { margin: 2px 0 10px; font-weight: 600; }
+      .hint { color: #ffb4a8; font-size: 13px; margin: -6px 0 8px; }
+      .hint:empty { display: none; }
+      .buttons { display: flex; gap: 8px; justify-content: flex-end; }
+      button { font: 600 14px system-ui, sans-serif; border: 0;
+        border-radius: 999px; padding: 8px 14px; color: #fff;
+        background: rgba(255, 255, 255, 0.14); }
+      button.skip[hidden] { display: none; }
+      .box { position: fixed; pointer-events: none; border-radius: 6px;
+        border: 3px solid ${ACCENT}; background: rgba(92, 124, 252, 0.18);
+        transition: all 0.08s; display: none; }
+      .box.done { border-color: #3ddc84; background: rgba(61, 220, 132, 0.2); }
+    `;
+
+    function startPicker() {
+      const steps = [
+        {key: 'next', text: t.stepNext || 'Tap the NEXT chapter button'},
+        {key: 'prev', text: t.stepPrev || 'Tap the PREVIOUS chapter button'},
+        {key: 'image', text: t.stepImage || 'Tap a page of the chapter'},
+      ];
+      const ui = createHost(PICKER_CSS);
+      const bar = element('div', 'bar', ui.root);
+      const stepLabel = element('div', 'step', bar);
+      const text = element('div', 'text', bar);
+      const hint = element('div', 'hint', bar);
+      const buttons = element('div', 'buttons', bar);
+      const skip = element('button', 'skip', buttons, t.skip || 'Skip');
+      const cancel = element('button', 'cancel', buttons, t.cancel || 'Cancel');
+      const box = element('div', 'box', ui.root);
+
+      picker = {ui, steps, index: 0, result: {}, box, target: null};
+      pickState = 'picking';
+
+      const show = () => {
+        const step = steps[picker.index];
+        stepLabel.textContent = (picker.index + 1) + ' / ' + steps.length;
+        text.textContent = step.text;
+        hint.textContent = '';
+        // The chapter image cannot be skipped.
+        skip.hidden = step.key === 'image';
+        box.style.display = 'none';
+      };
+      show();
+
+      const advance = () => {
+        picker.index++;
+        if (picker.index < steps.length) {
+          show();
+        } else {
+          finishPicker();
+        }
+      };
+      skip.addEventListener('click', () => {
+        picker.result[steps[picker.index].key] = null;
+        advance();
+      });
+      cancel.addEventListener('click', () => stopPicker('cancelled'));
+
+      const candidate = (event) => {
+        const step = steps[picker.index];
+        return step.key === 'image' ?
+            imageAt(event.clientX, event.clientY, event.target) :
+            clickableAt(event.target);
+      };
+      const highlight = (el, done) => {
+        if (!el) {
+          box.style.display = 'none';
+          return;
+        }
+        const r = el.getBoundingClientRect();
+        box.style.display = 'block';
+        box.style.left = (r.left - 4) + 'px';
+        box.style.top = (r.top - 4) + 'px';
+        box.style.width = (r.width + 8) + 'px';
+        box.style.height = (r.height + 8) + 'px';
+        box.classList.toggle('done', !!done);
+      };
+      picker.highlight = highlight;
+
+      // While picking, taps select elements instead of using them: links do
+      // not navigate and the site's own click handlers do not run.
+      const swallow = (event) => {
+        if (!event.isTrusted || isOurs(event, ui.host)) {
+          return;
+        }
+        event.stopImmediatePropagation();
+        if (event.type === 'pointerdown' || event.type === 'mouseover') {
+          highlight(candidate(event), false);
+        }
+      };
+      const onClick = (event) => {
+        if (!event.isTrusted || isOurs(event, ui.host)) {
+          return;
+        }
+        event.preventDefault();
+        event.stopImmediatePropagation();
+        const step = steps[picker.index];
+        const el = candidate(event);
+        if (!el) {
+          hint.textContent = step.key === 'image' ?
+              (t.notImage || 'That is not a picture, try again') : '';
+          highlight(null);
+          return;
+        }
+        highlight(el, true);
+        picker.result[step.key] = el;
+        if (step.key === 'image') {
+          // Still in the tap: going full screen is allowed now.
+          requestFullscreen();
+        }
+        setTimeout(advance, step.key === 'image' ? 0 : 450);
+      };
+      picker.listeners = [
+        ['click', onClick],
+        ['auxclick', onClick],
+        ['pointerdown', swallow],
+        ['pointerup', swallow],
+        ['mousedown', swallow],
+        ['mouseup', swallow],
+        ['mouseover', swallow],
+        ['touchend', swallow],
+      ];
+      for (const [type, listener] of picker.listeners) {
+        window.addEventListener(type, listener, true);
+      }
+    }
+
+    // The link or button that was tapped (the tap may land on an icon or a
+    // text inside it).
+    function clickableAt(target) {
+      if (!(target instanceof Element)) {
+        return null;
+      }
+      const clickable = target.closest(
+          'a[href], button, [role="button"], [onclick], ' +
+          'input[type="button"], input[type="submit"]');
+      if (clickable) {
+        return clickable;
+      }
+      // An element made clickable with a script: take the outermost one of
+      // the elements that show a pointer cursor.
+      let found = null;
+      let node = target;
+      for (let i = 0; node && node !== document.body && i < 5; i++) {
+        if (getComputedStyle(node).cursor === 'pointer') {
+          found = node;
+        } else if (found) {
+          break;
+        }
+        node = node.parentElement;
+      }
+      return found || target;
+    }
+
+    // The chapter image at a point, also below transparent elements that some
+    // sites put over their images.
+    function imageAt(x, y, target) {
+      for (const el of document.elementsFromPoint(x, y)) {
+        if (el.matches && el.matches(MEDIA)) {
+          return el;
+        }
+        if (el.tagName === 'PICTURE') {
+          const img = el.querySelector('img');
+          if (img) {
+            return img;
+          }
+        }
+      }
+      if (target instanceof Element) {
+        const media = target.querySelectorAll(MEDIA);
+        if (media.length === 1) {
+          return media[0];
+        }
+      }
+      return null;
+    }
+
+    function navSpec(el) {
+      if (!el) {
+        return null;
+      }
+      // Sites often have the same buttons above and below the chapter: a
+      // selector that finds all of them is fine when they say the same.
+      const own = simpleSelector(el);
+      const same = own.includes('.') ? queryAll(own) : [];
+      const sameLabel = same.length > 1 &&
+          same.every(other => labelOf(other) === labelOf(el));
+      return {
+        selector: sameLabel ? own : selectorFor(el),
+        text: labelOf(el),
+        rel: el.getAttribute('rel') || '',
+      };
+    }
+
+    // The element that holds all images of the chapter: the lowest ancestor
+    // of the tapped image with the most chapter-sized images, stopping before
+    // it would include many other images (logos, avatars, banners).
+    function findContainer(img) {
+      const width = img.getBoundingClientRect().width || img.width || 1;
+      const isPage = (el) => {
+        const w = el.getBoundingClientRect().width;
+        return w >= Math.max(0.6 * width, 80) || (w === 0 && hasLazyHint(el));
+      };
+      let best = null;
+      let bestCount = 0;
+      for (let node = img.parentElement;
+           node && node !== document.body && node !== document.documentElement;
+           node = node.parentElement) {
+        const media = [...node.querySelectorAll(MEDIA)];
+        const pages = media.filter(isPage);
+        if (pages.length < 0.75 * media.length) {
+          break;
+        }
+        if (pages.length > bestCount) {
+          best = node;
+          bestCount = pages.length;
+        }
+      }
+      return best || img.parentElement || img;
+    }
+
+    function finishPicker() {
+      const result = picker.result;
+      const container = findContainer(result.image);
+      const cfg = {
+        version: 1,
+        next: navSpec(result.next),
+        prev: navSpec(result.prev),
+        container: selectorFor(container),
+        image: simpleSelector(result.image),
+      };
+      stopPicker('done', cfg);
+      openReader(cfg);
+    }
+
+    function stopPicker(state, cfg) {
+      if (!picker) {
+        return;
+      }
+      for (const [type, listener] of picker.listeners || []) {
+        window.removeEventListener(type, listener, true);
+      }
+      picker.ui.host.remove();
+      picker = null;
+      pickState = state;
+      pickResult = cfg || null;
+    }
+
+    // ---------------------------------------------------------------------
+    // Finding the chapter on a page
+
+    function findChapter(cfg) {
+      let container = queryAll(cfg.container)
+                          .find(el => el.querySelector(MEDIA)) || null;
+      if (!container && cfg.image && cfg.image.includes('.')) {
+        // The container changed: take the lowest element that holds all
+        // images that look like the saved one.
+        const images = queryAll(cfg.image);
+        if (images.length) {
+          container = findContainer(images[0]);
+        }
+      }
+      return container;
+    }
+
+    function findNav(spec) {
+      if (!spec) {
+        return null;
+      }
+      let found = queryAll(spec.selector);
+      if (found.length > 1 && spec.text) {
+        const same = found.filter(el => labelOf(el) === spec.text);
+        if (same.length) {
+          found = same;
+        }
+      }
+      if (!found.length && spec.text) {
+        found = queryAll('a[href], button, [role="button"]')
+                    .filter(el => labelOf(el) === spec.text);
+      }
+      if (!found.length && spec.rel) {
+        found = queryAll('a[rel~="' + CSS.escape(spec.rel) + '"]');
+      }
+      return found.find(el => !isDisabled(el)) || null;
+    }
+
+    // Calls back with the chapter container once it is there, for up to
+    // WAIT_MS: many sites add their images with a script after loading.
+    function waitAndRead(cfg, auto) {
+      if (!cfg || !cfg.container) {
+        return 'no-config';
+      }
+      const ready = () => {
+        const container = findChapter(cfg);
+        if (!container) {
+          return false;
+        }
+        // After a page load, only open on chapter pages: the site's home
+        // page may also match the container.
+        if (auto && (cfg.next || cfg.prev) && !findNav(cfg.next) &&
+            !findNav(cfg.prev)) {
+          return false;
+        }
+        return true;
+      };
+      if (ready()) {
+        openReader(cfg);
+        return 'reading';
+      }
+      const check = throttle(() => {
+        if (waiter && ready()) {
+          stopWaiting();
+          openReader(cfg);
+        }
+      }, 200);
+      const observer = new MutationObserver(check);
+      observer.observe(document.documentElement, {childList: true, subtree: true});
+      waiter = {
+        observer,
+        interval: setInterval(check, 500),
+        timeout: setTimeout(stopWaiting, WAIT_MS),
+      };
+      return 'waiting';
+    }
+
+    function stopWaiting() {
+      if (!waiter) {
+        return;
+      }
+      waiter.observer.disconnect();
+      clearInterval(waiter.interval);
+      clearTimeout(waiter.timeout);
+      waiter = null;
+    }
+
+    // ---------------------------------------------------------------------
+    // Reader
+
+    const BLOCK_STYLE = {
+      display: 'block',
+      position: 'static',
+      float: 'none',
+      margin: '0',
+      padding: '0',
+      border: '0',
+      width: 'auto',
+      'min-width': '0',
+      'max-width': 'none',
+      height: 'auto',
+      'min-height': '0',
+      'max-height': 'none',
+      overflow: 'visible',
+      transform: 'none',
+      'box-shadow': 'none',
+      background: '#000',
+    };
+    const WRAPPER_STYLE = {
+      margin: '0',
+      padding: '0',
+      border: '0',
+      width: 'auto',
+      'max-width': 'none',
+      float: 'none',
+      transform: 'none',
+      background: 'transparent',
+    };
+
+    const READER_CSS = `
+      .bar { position: fixed; display: flex; gap: 6px;
+        top: max(8px, env(safe-area-inset-top)); transition: opacity 0.2s; }
+      .left { left: 8px; }
+      .right { right: 8px; }
+      .hidden .bar { opacity: 0; pointer-events: none; }
+      button { width: 36px; height: 36px; padding: 0; border-radius: 50%;
+        border: 1px solid rgba(255, 255, 255, 0.22);
+        background: rgba(18, 18, 22, 0.6); color: #fff; display: grid;
+        place-items: center; }
+      button:active { background: ${ACCENT}; }
+      button[hidden] { display: none; }
+      button.off { opacity: 0.35; }
+      svg { width: 22px; height: 22px; fill: currentColor; }
+      .toast { position: fixed; left: 50%; bottom: 32px;
+        transform: translateX(-50%); background: rgba(18, 18, 22, 0.9);
+        color: #fff; padding: 8px 14px; border-radius: 999px;
+        font: 14px system-ui, sans-serif; white-space: nowrap;
+        transition: opacity 0.2s; }
+      .toast:empty { opacity: 0; }
+    `;
+
+    function openReader(cfg) {
+      if (reader) {
+        stopReader();
+      }
+      const container = findChapter(cfg);
+      if (!container) {
+        return false;
+      }
+      const ui = createHost(READER_CSS);
+      const wrap = element('div', '', ui.root);
+      const left = element('div', 'bar left', wrap);
+      const prev = element('button', '', left);
+      prev.setAttribute('aria-label', t.prev || 'Previous chapter');
+      icon(prev, ICON_PREV);
+      const next = element('button', '', left);
+      next.setAttribute('aria-label', t.next || 'Next chapter');
+      icon(next, ICON_NEXT);
+      const right = element('div', 'bar right', wrap);
+      const close = element('button', '', right);
+      close.setAttribute('aria-label', t.close || 'Close manga mode');
+      icon(close, ICON_CLOSE);
+      const toast = element('div', 'toast', wrap);
+      toast.setAttribute('role', 'status');
+
+      reader = {
+        cfg,
+        container,
+        ui,
+        wrap,
+        toast,
+        prev,
+        next,
+        saved: new Map(),
+        missing: 0,
+      };
+      prev.hidden = !cfg.prev;
+      next.hidden = !cfg.next;
+      prev.addEventListener('click', () => go('prev'));
+      next.addEventListener('click', () => go('next'));
+      close.addEventListener('click', () => {
+        dismissed = true;
+        stopReader();
+      });
+
+      // Taps on the chapter show and hide the buttons (and go full screen)
+      // instead of reaching the site, which often opens ads or the next page
+      // on a tap.
+      reader.onClick = (event) => {
+        if (!event.isTrusted || isOurs(event, ui.host)) {
+          return;
+        }
+        event.preventDefault();
+        event.stopImmediatePropagation();
+        if (!document.fullscreenElement) {
+          requestFullscreen();
+          wrap.classList.remove('hidden');
+        } else {
+          wrap.classList.toggle('hidden');
+        }
+      };
+      window.addEventListener('click', reader.onClick, true);
+      reader.onLoad = (event) => {
+        if (event.target instanceof Element && event.target.matches(MEDIA)) {
+          styleMedia(event.target);
+        }
+      };
+      document.addEventListener('load', reader.onLoad, true);
+      reader.onScroll = throttle(loadNearbyImages, 250);
+      window.addEventListener('scroll', reader.onScroll, {passive: true});
+
+      // Keep the page isolated while the site adds or replaces elements.
+      reader.observer = new MutationObserver(throttle(() => {
+        if (reader) {
+          isolate();
+        }
+      }, 300));
+      reader.observer.observe(document.documentElement,
+                              {childList: true, subtree: true});
+
+      isolate();
+      updateNavButtons();
+      window.scrollTo(0, 0);
+      loadNearbyImages();
+      return true;
+    }
+
+    function stopReader() {
+      if (!reader) {
+        return;
+      }
+      reader.observer.disconnect();
+      window.removeEventListener('click', reader.onClick, true);
+      document.removeEventListener('load', reader.onLoad, true);
+      window.removeEventListener('scroll', reader.onScroll);
+      for (const [el, cssText] of reader.saved) {
+        if (cssText === null) {
+          el.removeAttribute('style');
+        } else {
+          el.style.cssText = cssText;
+        }
+      }
+      reader.ui.host.remove();
+      reader = null;
+      if (document.fullscreenElement) {
+        document.exitFullscreen().catch(() => {});
+      }
+    }
+
+    function setStyles(el, styles) {
+      if (!reader.saved.has(el)) {
+        reader.saved.set(el, el.hasAttribute('style') ? el.style.cssText : null);
+      }
+      for (const [name, value] of Object.entries(styles)) {
+        if (el.style.getPropertyValue(name) !== value ||
+            el.style.getPropertyPriority(name) !== 'important') {
+          el.style.setProperty(name, value, 'important');
+        }
+      }
+    }
+
+    // Hides everything but the chapter, and lays the chapter out at full
+    // width.
+    function isolate() {
+      if (!reader.container.isConnected) {
+        const container = findChapter(reader.cfg);
+        if (!container) {
+          // The chapter is gone (for example after a navigation inside the
+          // site): close, and open again when a chapter appears.
+          const cfg = reader.cfg;
+          stopReader();
+          waitAndRead(cfg, true);
+          return;
+        }
+        reader.container = container;
+        updateNavButtons();
+      }
+      const container = reader.container;
+      const keep = new Set();
+      for (let node = container; node && node !== document.documentElement;
+           node = node.parentElement) {
+        keep.add(node);
+      }
+      for (let node = container; node && node !== document.body;
+           node = node.parentElement) {
+        const parent = node.parentElement;
+        if (!parent) {
+          break;
+        }
+        for (const sibling of parent.children) {
+          if (!keep.has(sibling) && !NOT_RENDERED.has(sibling.tagName)) {
+            setStyles(sibling, {display: 'none'});
+          }
+        }
+        if (node !== container) {
+          setStyles(node, BLOCK_STYLE);
+        }
+      }
+      setStyles(document.documentElement,
+                {background: '#000', overflow: 'visible', height: 'auto'});
+      setStyles(document.body, BLOCK_STYLE);
+      setStyles(container, Object.assign({}, BLOCK_STYLE, {
+        'text-align': 'center',
+        'line-height': '0',
+        'font-size': '0',
+      }));
+      for (const media of container.querySelectorAll(MEDIA)) {
+        styleMedia(media);
+        for (let node = media.parentElement; node && node !== container;
+             node = node.parentElement) {
+          setStyles(node, WRAPPER_STYLE);
+        }
+      }
+    }
+
+    function styleMedia(media) {
+      if (!reader || !reader.container.contains(media)) {
+        return;
+      }
+      setStyles(media, {
+        display: 'block',
+        position: 'static',
+        float: 'none',
+        width: '100%',
+        'max-width': '100%',
+        height: 'auto',
+        'max-height': 'none',
+        margin: '0 auto',
+        padding: '0',
+        border: '0',
+        transform: 'none',
+        // Keeps the images that are still loading apart, so that the site
+        // loads them one after another while scrolling.
+        'min-height': isPlaceholder(media) ? '60vh' : '0',
+      });
+    }
+
+    // Starts loading the images near the screen whose site script has not
+    // done it yet (their address is still in a data attribute).
+    function loadNearbyImages() {
+      if (!reader) {
+        return;
+      }
+      const limit = window.innerHeight * 2.5;
+      for (const img of reader.container.querySelectorAll('img')) {
+        if (!isPlaceholder(img)) {
+          continue;
+        }
+        const r = img.getBoundingClientRect();
+        if (r.bottom < -window.innerHeight || r.top > limit) {
+          continue;
+        }
+        const name = LAZY_ATTRIBUTES.find(n => img.getAttribute(n));
+        const source = name && img.getAttribute(name).trim();
+        if (source && img.getAttribute('src') !== source &&
+            !img.hasAttribute('data-cromiko-loading')) {
+          img.setAttribute('data-cromiko-loading', '');
+          if (img.getAttribute('data-srcset')) {
+            img.setAttribute('srcset', img.getAttribute('data-srcset'));
+          }
+          img.src = source;
+        }
+      }
+    }
+
+    function updateNavButtons() {
+      for (const key of ['prev', 'next']) {
+        if (reader.cfg[key]) {
+          reader[key].classList.toggle('off', !findNav(reader.cfg[key]));
+        }
+      }
+    }
+
+    function go(key) {
+      const el = findNav(reader.cfg[key]);
+      if (!el) {
+        showToast(key === 'next' ? (t.noNext || 'No next chapter') :
+                                   (t.noPrev || 'No previous chapter'));
+        return;
+      }
+      const href = el.tagName === 'A' ? el.getAttribute('href') || '' : '';
+      if (href && !href.startsWith('#') && !/^javascript:/i.test(href)) {
+        location.href = el.href;
+      } else {
+        // Untrusted, so our own click listener lets it through.
+        el.click();
+      }
+      window.scrollTo(0, 0);
+    }
+
+    function showToast(text) {
+      reader.toast.textContent = text;
+      clearTimeout(reader.toastTimer);
+      reader.toastTimer = setTimeout(() => {
+        if (reader) {
+          reader.toast.textContent = '';
+        }
+      }, 2000);
+    }
+
+    function requestFullscreen() {
+      if (!document.fullscreenElement && document.fullscreenEnabled) {
+        document.documentElement.requestFullscreen({navigationUI: 'hide'})
+            .catch(() => {});
+      }
+    }
+
+    function throttle(fn, ms) {
+      let timer = null;
+      return () => {
+        if (timer === null) {
+          timer = setTimeout(() => {
+            timer = null;
+            fn();
+          }, ms);
+        }
+      };
+    }
+
+    return {run};
+  }
+})(__CROMIKO_ARGS__);
