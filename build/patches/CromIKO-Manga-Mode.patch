@@ -0,0 +1,235 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.cromiko;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.SystemClock;
+
+import androidx.appcompat.app.AlertDialog;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import org.chromium.base.Callback;
+import org.chromium.base.ContextUtils;
+import org.chromium.base.FileUtils;
+import org.chromium.base.Log;
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.TaskTraits;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.tabmodel.TabModelSelector;
+import org.chromium.chrome.browser.tabmodel.TabModelSelectorTabObserver;
+import org.chromium.components.embedder_support.util.UrlConstants;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.ui.widget.Toast;
+import org.chromium.url.GURL;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+
+/**
+ * CromIKO: manga mode. On the sites where the user turned it on, chapters open in a full screen
+ * reader with buttons for the next and the previous chapter. To turn it on, the user taps the
+ * next chapter button, the previous chapter button and a page of a chapter; the page script
+ * (res/raw/cromiko_manga.js) finds them again on the other chapters.
+ */
+@NullMarked
+public final class CromikoMangaMode {
+    private static final String TAG = "CromikoManga";
+    // One entry per site (host name): the configuration made by the page script, as JSON.
+    private static final String PREFS_NAME = "cromiko_manga_mode";
+    private static final String ARGS_PLACEHOLDER = "__CROMIKO_ARGS__";
+    private static final String POLL_SCRIPT =
+            "JSON.stringify(window.__cromikoManga ? window.__cromikoManga.run('poll')"
+                    + " : {state: 'none'})";
+    private static final long POLL_INTERVAL_MS = 500;
+    // The user may need a while to find the buttons on the page.
+    private static final long POLL_TIMEOUT_MS = 10 * 60 * 1000;
+
+    private static @Nullable String sScript;
+
+    private CromikoMangaMode() {}
+
+    /** Handles the "Manga mode" item of the app menu on |tab|. */
+    public static void onMenuItemSelected(Activity activity, @Nullable Tab tab) {
+        Context context = ContextUtils.getApplicationContext();
+        WebContents webContents = tab != null ? tab.getWebContents() : null;
+        String site = tab != null ? siteOf(tab.getUrl()) : null;
+        if (tab == null || webContents == null || site == null) {
+            Toast.makeText(context, R.string.cromiko_manga_mode_no_page, Toast.LENGTH_SHORT)
+                    .show();
+            return;
+        }
+        String config = getConfig(site);
+        if (config == null) {
+            startPicker(tab, webContents, site);
+            return;
+        }
+        new AlertDialog.Builder(activity, R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                .setTitle(R.string.cromiko_manga_mode_menu)
+                .setMessage(activity.getString(R.string.cromiko_manga_mode_on_for_site, site))
+                .setPositiveButton(
+                        R.string.cromiko_manga_mode_read,
+                        (dialog, which) -> run(webContents, "read", config, null))
+                .setNeutralButton(
+                        R.string.cromiko_manga_mode_set_up_again,
+                        (dialog, which) -> startPicker(tab, webContents, site))
+                .setNegativeButton(
+                        R.string.cromiko_manga_mode_turn_off,
+                        (dialog, which) -> {
+                            prefs().edit().remove(site).apply();
+                            run(webContents, "stop", null, null);
+                        })
+                .show();
+    }
+
+    /**
+     * Opens the reader on chapter pages of the sites where manga mode is on, after they load.
+     *
+     * @return The observer, to destroy with the activity.
+     */
+    public static TabModelSelectorTabObserver observeTabs(TabModelSelector tabModelSelector) {
+        return new TabModelSelectorTabObserver(tabModelSelector) {
+            @Override
+            public void onPageLoadFinished(Tab tab, GURL url) {
+                String site = siteOf(url);
+                String config = site != null ? getConfig(site) : null;
+                WebContents webContents = tab.getWebContents();
+                if (config != null && webContents != null) {
+                    run(webContents, "auto", config, null);
+                }
+            }
+        };
+    }
+
+    private static void startPicker(Tab tab, WebContents webContents, String site) {
+        long startTime = SystemClock.elapsedRealtime();
+        run(webContents, "pick", null, result -> poll(tab, webContents, site, startTime));
+    }
+
+    // The page script cannot call back: ask it until the user has tapped the three elements.
+    private static void poll(Tab tab, WebContents webContents, String site, long startTime) {
+        if (tab.isDestroyed()
+                || tab.getWebContents() != webContents
+                || SystemClock.elapsedRealtime() - startTime > POLL_TIMEOUT_MS) {
+            return;
+        }
+        CromikoPageScripts.execute(
+                webContents,
+                POLL_SCRIPT,
+                result -> {
+                    JSONObject state = parse(result);
+                    String name = state != null ? state.optString("state") : "";
+                    if ("picking".equals(name)) {
+                        PostTask.postDelayedTask(
+                                TaskTraits.UI_DEFAULT,
+                                () -> poll(tab, webContents, site, startTime),
+                                POLL_INTERVAL_MS);
+                    } else if ("done".equals(name)) {
+                        JSONObject config = state.optJSONObject("config");
+                        if (config != null) {
+                            prefs().edit().putString(site, config.toString()).apply();
+                            Context context = ContextUtils.getApplicationContext();
+                            Toast.makeText(
+                                            context,
+                                            context.getString(
+                                                    R.string.cromiko_manga_mode_on_for_site,
+                                                    site),
+                                            Toast.LENGTH_SHORT)
+                                    .show();
+                        }
+                    }
+                });
+    }
+
+    private static void run(
+            WebContents webContents,
+            String command,
+            @Nullable String config,
+            @Nullable Callback<String> callback) {
+        String script = getScript();
+        if (script == null) return;
+        String args =
+                JSONObject.quote(command)
+                        + ", "
+                        + (config != null ? config : "null")
+                        + ", "
+                        + texts();
+        CromikoPageScripts.execute(
+                webContents,
+                script.replace(ARGS_PLACEHOLDER, args),
+                callback != null ? callback : result -> {});
+    }
+
+    /** The site of |url| (its host name) if manga mode can work there. */
+    private static @Nullable String siteOf(@Nullable GURL url) {
+        if (url == null || !url.isValid()) return null;
+        String scheme = url.getScheme();
+        if (!UrlConstants.HTTP_SCHEME.equals(scheme) && !UrlConstants.HTTPS_SCHEME.equals(scheme)) {
+            return null;
+        }
+        String host = url.getHost();
+        return host.isEmpty() ? null : host;
+    }
+
+    private static SharedPreferences prefs() {
+        return ContextUtils.getApplicationContext()
+                .getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE);
+    }
+
+    /** The saved configuration of |site|, as a JSON object literal for the page script. */
+    private static @Nullable String getConfig(String site) {
+        JSONObject config = parse(prefs().getString(site, null));
+        return config != null ? config.toString() : null;
+    }
+
+    private static @Nullable JSONObject parse(@Nullable String json) {
+        if (json == null || json.isEmpty()) return null;
+        try {
+            return new JSONObject(json);
+        } catch (JSONException e) {
+            return null;
+        }
+    }
+
+    private static @Nullable String getScript() {
+        if (sScript == null) {
+            Context context = ContextUtils.getApplicationContext();
+            try (InputStream stream = context.getResources().openRawResource(R.raw.cromiko_manga)) {
+                sScript = new String(FileUtils.readStream(stream), StandardCharsets.UTF_8);
+            } catch (IOException e) {
+                Log.e(TAG, "Cannot read the manga mode script", e);
+            }
+        }
+        return sScript;
+    }
+
+    /** The texts of the page script, in the language of the app. */
+    private static String texts() {
+        Context context = ContextUtils.getApplicationContext();
+        JSONObject texts = new JSONObject();
+        try {
+            texts.put("stepNext", context.getString(R.string.cromiko_manga_mode_step_next));
+            texts.put("stepPrev", context.getString(R.string.cromiko_manga_mode_step_prev));
+            texts.put("stepImage", context.getString(R.string.cromiko_manga_mode_step_image));
+            texts.put("skip", context.getString(R.string.cromiko_manga_mode_skip));
+            texts.put("cancel", context.getString(R.string.cancel));
+            texts.put("notImage", context.getString(R.string.cromiko_manga_mode_not_image));
+            texts.put("prev", context.getString(R.string.cromiko_manga_mode_prev));
+            texts.put("next", context.getString(R.string.cromiko_manga_mode_next));
+            texts.put("close", context.getString(R.string.cromiko_manga_mode_close));
+            texts.put("noPrev", context.getString(R.string.cromiko_manga_mode_no_prev));
+            texts.put("noNext", context.getString(R.string.cromiko_manga_mode_no_next));
+        } catch (JSONException e) {
+            // Not reached: the names and values are never null.
+        }
+        return texts.toString();
+    }
+}
