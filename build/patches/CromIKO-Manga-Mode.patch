new file mode 100644
--- /dev/null
+++ b/chrome/browser/cromiko/android/cromiko_page_scripts.cc
@@ -0,0 +1,59 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+#include <string>
+#include <utility>
+
+#include "base/android/callback_android.h"
+#include "base/android/jni_android.h"
+#include "base/android/jni_string.h"
+#include "base/android/scoped_java_ref.h"
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/values.h"
+#include "chrome/common/chrome_isolated_world_ids.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+
+// Must come after all headers that specialize FromJniType() / ToJniType().
+#include "chrome/browser/cromiko/jni_headers/CromikoPageScripts_jni.h"
+
+using base::android::JavaParamRef;
+using base::android::ScopedJavaGlobalRef;
+
+namespace {
+
+void OnScriptResult(const ScopedJavaGlobalRef<jobject>& callback,
+                    base::Value result) {
+  std::string text;
+  if (result.is_string()) {
+    text = result.GetString();
+  } else if (!result.is_none()) {
+    text = base::WriteJson(result).value_or(std::string());
+  }
+  base::android::RunStringCallbackAndroid(callback, text);
+}
+
+}  // namespace
+
+static void JNI_CromikoPageScripts_Execute(
+    JNIEnv* env,
+    const JavaParamRef<jobject>& j_web_contents,
+    const JavaParamRef<jstring>& j_script,
+    const JavaParamRef<jobject>& j_callback) {
+  ScopedJavaGlobalRef<jobject> callback(env, j_callback);
+  content::WebContents* web_contents =
+      content::WebContents::FromJavaWebContents(j_web_contents);
+  content::RenderFrameHost* frame =
+      web_contents ? web_contents->GetPrimaryMainFrame() : nullptr;
+  if (!frame || !frame->IsRenderFrameLive()) {
+    base::android::RunStringCallbackAndroid(callback, std::string());
+    return;
+  }
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      base::android::ConvertJavaStringToUTF16(env, j_script),
+      base::BindOnce(&OnScriptResult, std::move(callback)),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+DEFINE_JNI(CromikoPageScripts)
