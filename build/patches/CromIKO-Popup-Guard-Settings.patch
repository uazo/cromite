+
+package org.chromium.chrome.browser.cromiko;
+
+import android.content.Context;
+import android.util.AttributeSet;
+
+import androidx.preference.Preference;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.components.browser_ui.widget.containment.ContainmentItem;
+
+/**
+ * CromIKO: a preference with a card of its own, like the tops of the CromIKO settings pages. The
+ * settings put every preference into a rounded container and replace the background of its view;
+ * this one stays out of them. Its layout has the card inside a frame without a background.
+ */
+@NullMarked
+public class CromikoCardPreference extends Preference implements ContainmentItem {
+    public CromikoCardPreference(Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+    }
+
+    @Override
+    public @BackgroundStyle int getCustomBackgroundStyle() {
+        return BackgroundStyle.NONE;
+    }
+}
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoPopupGuardSettings.java b/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoPopupGuardSettings.java
new file mode 100644
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoPopupGuardSettings.java
@@ -0,0 +1,202 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.cromiko;
+
+import android.os.Bundle;
+
+import androidx.annotation.VisibleForTesting;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import org.chromium.base.Log;
+import org.chromium.base.supplier.MonotonicObservableSupplier;
+import org.chromium.base.supplier.ObservableSuppliers;
+import org.chromium.base.supplier.SettableMonotonicObservableSupplier;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.components.browser_ui.settings.ChromeImageViewPreference;
+import org.chromium.components.browser_ui.settings.ChromeSwitchPreference;
+import org.chromium.components.browser_ui.settings.SettingsUtils;
+import org.chromium.components.browser_ui.site_settings.ContentSettingException;
+import org.chromium.components.browser_ui.site_settings.WebsitePreferenceBridge;
+import org.chromium.components.content_settings.ContentSetting;
+import org.chromium.components.content_settings.ContentSettingsType;
+import org.chromium.components.content_settings.ProviderType;
+
+import java.text.NumberFormat;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * CromIKO: the settings of the pop-up guard, in the CromIKO settings and the weekly shield report.
+ * They show how many pop-ups and redirects it held this week, whether it holds all of them (the
+ * "Block all pop-ups" setting, CromIKO's default) or only the ones that Chromium blocks, and the
+ * sites where the user allowed pop-ups and redirects with "Always allow" of the pop-up guard menu,
+ * to remove them again. The count comes from cromiko_shield_stats.cc, the setting and the sites are
+ * the pop-up content settings, which Site settings shows too.
+ */
+@NullMarked
+public class CromikoPopupGuardSettings extends ChromeBaseSettingsFragment
+        implements Preference.OnPreferenceChangeListener {
+    private static final String TAG = "CromikoPopupGuard";
+
+    // The keys of the preferences in cromiko_popup_guard_preferences.xml.
+    private static final String PREF_HEADER = "header";
+    private static final String PREF_HOLD_ALL = "hold_all";
+    private static final String PREF_ALLOWED = "allowed";
+
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getString(R.string.cromiko_popup_guard_settings_title));
+        SettingsUtils.addPreferencesFromResource(this, R.xml.cromiko_popup_guard_preferences);
+        findPreference(PREF_HOLD_ALL).setOnPreferenceChangeListener(this);
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        // The pop-up guard menu can allow sites while this page is in the background.
+        showCount();
+        showHoldAll();
+        showAllowedSites();
+    }
+
+    // The settings are the ones of the regular profile, which the pop-up guard menu changes.
+    private Profile getOriginalProfile() {
+        return getProfile().getOriginalProfile();
+    }
+
+    private void showCount() {
+        JSONObject report;
+        try {
+            report = new JSONObject(CromikoShieldReportBridge.getReport(getProfile()));
+        } catch (JSONException e) {
+            Log.e(TAG, "Bad report", e);
+            report = new JSONObject();
+        }
+        NumberFormat format = NumberFormat.getIntegerInstance();
+        Preference header = findPreference(PREF_HEADER);
+        header.setTitle(format.format(report.optInt("held")));
+        JSONObject lastWeek = report.optJSONObject("last_week");
+        header.setSummary(
+                lastWeek == null
+                        ? null
+                        : getString(
+                                R.string.cromiko_popup_guard_held_last_week,
+                                format.format(lastWeek.optInt("held"))));
+    }
+
+    private void showHoldAll() {
+        @ContentSetting int setting =
+                WebsitePreferenceBridge.getDefaultContentSetting(
+                        getOriginalProfile(), ContentSettingsType.POPUPS);
+        ChromeSwitchPreference holdAll = (ChromeSwitchPreference) findPreference(PREF_HOLD_ALL);
+        holdAll.setChecked(setting == ContentSetting.ASK);
+        holdAll.setSummary(
+                setting == ContentSetting.ASK
+                        ? R.string.cromiko_popup_guard_hold_all_on
+                        : setting == ContentSetting.ALLOW
+                                ? R.string.cromiko_popup_guard_all_allowed
+                                : R.string.cromiko_popup_guard_hold_all_off);
+    }
+
+    private void showAllowedSites() {
+        PreferenceCategory category = (PreferenceCategory) findPreference(PREF_ALLOWED);
+        category.removeAll();
+        List<ContentSettingException> allowed = new ArrayList<>();
+        for (ContentSettingException exception :
+                new WebsitePreferenceBridge()
+                        .getContentSettingsExceptions(
+                                getOriginalProfile(), ContentSettingsType.POPUPS)) {
+            // Only the sites that the user allowed, not the ones of policies.
+            if (exception.getContentSetting() == ContentSetting.ALLOW
+                    && exception.getSource() == ProviderType.PREF_PROVIDER) {
+                allowed.add(exception);
+            }
+        }
+        allowed.sort(
+                (a, b) ->
+                        getSite(a.getPrimaryPattern())
+                                .compareToIgnoreCase(getSite(b.getPrimaryPattern())));
+
+        if (allowed.isEmpty()) {
+            Preference empty = new Preference(getPreferenceManager().getContext());
+            empty.setSummary(R.string.cromiko_popup_guard_no_allowed_sites);
+            empty.setSelectable(false);
+            category.addPreference(empty);
+            return;
+        }
+        for (ContentSettingException exception : allowed) {
+            String site = getSite(exception.getPrimaryPattern());
+            ChromeImageViewPreference row =
+                    new ChromeImageViewPreference(getPreferenceManager().getContext());
+            row.setTitle(site);
+            row.setSelectable(false);
+            row.setImageView(
+                    R.drawable.cromiko_ic_guard_close,
+                    getString(R.string.cromiko_popup_guard_remove_site, site),
+                    view -> {
+                        // Back to the default: pop-ups and redirects are held again.
+                        exception.setContentSetting(getOriginalProfile(), ContentSetting.DEFAULT);
+                        showAllowedSites();
+                    });
+            category.addPreference(row);
+        }
+    }
+
+    /**
+     * Returns the site of the pattern of a pop-up setting, for the list: "example.com" for
+     * "https://[*.]example.com:443". Other ports and http stay, to tell them apart.
+     */
+    @VisibleForTesting
+    static String getSite(String pattern) {
+        String site = pattern;
+        boolean https = site.startsWith("https://");
+        int scheme = site.indexOf("://");
+        if (scheme >= 0 && (https || site.startsWith("http://"))) {
+            site = site.substring(scheme + 3);
+        }
+        if (site.startsWith("[*.]")) site = site.substring(4);
+        if (site.endsWith("/*")) site = site.substring(0, site.length() - 2);
+        if (https && site.endsWith(":443")) site = site.substring(0, site.length() - 4);
+        if (!https && site.endsWith(":80")) site = site.substring(0, site.length() - 3);
+        return pattern.startsWith("http://") ? "http://" + site : site;
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        if (PREF_HOLD_ALL.equals(preference.getKey())) {
+            // Off is Chromium's pop-up blocker: it holds the pop-ups opened without a tap and
+            // the redirects of its interventions.
+            WebsitePreferenceBridge.setDefaultContentSetting(
+                    getOriginalProfile(),
+                    ContentSettingsType.POPUPS,
+                    (boolean) newValue ? ContentSetting.ASK : ContentSetting.BLOCK);
+            preference.setSummary(
+                    (boolean) newValue
+                            ? R.string.cromiko_popup_guard_hold_all_on
+                            : R.string.cromiko_popup_guard_hold_all_off);
+        }
+        return true;
+    }
+
+    @Override
