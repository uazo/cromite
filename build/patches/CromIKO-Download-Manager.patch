diff --git a/chrome/browser/download/cromiko_download_queue.cc b/chrome/browser/download/cromiko_download_queue.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/download/cromiko_download_queue.cc
@@ -0,0 +1,347 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+#include "chrome/browser/download/cromiko_download_queue.h"
+
+#include <algorithm>
+#include <climits>
+#include <memory>
+#include <vector>
+
+#include "base/auto_reset.h"
+#include "base/functional/bind.h"
+#include "base/values.h"
+#include "components/download/public/common/parallel_download_configs.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+
+namespace {
+
+// Profile prefs. The first three are also used in CromikoDownloadSettings.java.
+// The number of connections of a parallel download.
+constexpr char kConnectionsPref[] = "cromiko.downloads.connections";
+// The number of downloads that run at the same time, 0 for no limit.
+constexpr char kMaxActivePref[] = "cromiko.downloads.max_active";
+// Whether downloads wait while the device is on mobile data.
+constexpr char kWifiOnlyPref[] = "cromiko.downloads.wifi_only";
+// The GUIDs of the waiting downloads, so that they still wait after a restart.
+constexpr char kQueuePref[] = "cromiko.downloads.queue";
+
+constexpr int kDefaultConnections = 4;
+constexpr int kMaxConnections = 8;
+constexpr int kDefaultMaxActive = 3;
+
+// The user data of the downloads: why a download waits (WaitReasonData), its
+// status at the last update (StatusData), and whether the user paused it.
+constexpr char kWaitReasonKey[] = "cromiko_download_queue_wait_reason";
+constexpr char kStatusKey[] = "cromiko_download_queue_status";
+constexpr char kUserPausedKey[] = "cromiko_download_queue_user_paused";
+
+class WaitReasonData : public base::SupportsUserData::Data {
+ public:
+  explicit WaitReasonData(CromikoDownloadQueue::WaitReason reason)
+      : reason(reason) {}
+
+  const CromikoDownloadQueue::WaitReason reason;
+};
+
+class StatusData : public base::SupportsUserData::Data {
+ public:
+  explicit StatusData(int status) : status(status) {}
+
+  const int status;
+};
+
+bool IsRunning(const download::DownloadItem* item) {
+  return item->GetState() == download::DownloadItem::IN_PROGRESS &&
+         !item->IsPaused();
+}
+
+// Whether the queue may pause |item| and resume it later.
+bool CanWait(const download::DownloadItem* item) {
+  return !item->IsTransient() && !item->IsTemporary() &&
+         !item->IsSavePackageDownload() && !item->IsDangerous() &&
+         !item->IsInsecure() && !item->AllDataSaved() &&
+         // The user still has to choose where to save it.
+         !item->GetTargetFilePath().empty() &&
+         // Without a validator, a download that stops cannot continue.
+         (!item->GetETag().empty() || !item->GetLastModifiedTime().empty());
+}
+
+// What the queue looks at, to update only when it changes.
+int StatusOf(const download::DownloadItem* item) {
+  return item->GetState() * 8 + item->IsPaused() * 4 + CanWait(item) * 2 +
+         item->AllDataSaved();
+}
+
+bool IsOnMobileData() {
+  net::NetworkChangeNotifier::ConnectionType type =
+      net::NetworkChangeNotifier::GetConnectionType();
+  if (type == net::NetworkChangeNotifier::CONNECTION_NONE) {
+    return false;
+  }
+  return net::NetworkChangeNotifier::IsConnectionCellular(type) ||
+         net::NetworkChangeNotifier::GetConnectionCost() ==
+             net::NetworkChangeNotifier::CONNECTION_COST_METERED;
+}
+
+bool StartedBefore(const download::DownloadItem* a,
+                   const download::DownloadItem* b) {
+  return a->GetStartTime() < b->GetStartTime();
+}
+
+}  // namespace
+
+CromikoDownloadQueue::CromikoDownloadQueue(content::DownloadManager* manager,
+                                           PrefService* prefs,
+                                           bool off_the_record)
+    : manager_(manager), prefs_(prefs), off_the_record_(off_the_record) {
+  pref_change_registrar_.Init(prefs_);
+  pref_change_registrar_.Add(
+      kConnectionsPref,
+      base::BindRepeating(&CromikoDownloadQueue::OnConnectionsChanged,
+                          base::Unretained(this)));
+  pref_change_registrar_.Add(kMaxActivePref,
+                             base::BindRepeating(&CromikoDownloadQueue::Update,
+                                                 base::Unretained(this)));
+  pref_change_registrar_.Add(kWifiOnlyPref,
+                             base::BindRepeating(&CromikoDownloadQueue::Update,
+                                                 base::Unretained(this)));
+  OnConnectionsChanged();
+
+  net::NetworkChangeNotifier::AddNetworkChangeObserver(this);
+  net::NetworkChangeNotifier::AddConnectionCostObserver(this);
+
+  manager_observation_.Observe(manager_);
+  download::SimpleDownloadManager::DownloadVector items;
+  manager_->GetAllDownloads(&items);
+  for (download::DownloadItem* item : items) {
+    Observe(item);
+  }
+  if (manager_->IsManagerInitialized()) {
+    PruneSavedQueue();
+  }
+  Update();
+}
+
+CromikoDownloadQueue::~CromikoDownloadQueue() {
+  net::NetworkChangeNotifier::RemoveConnectionCostObserver(this);
+  net::NetworkChangeNotifier::RemoveNetworkChangeObserver(this);
+}
+
+// static
+void CromikoDownloadQueue::RegisterProfilePrefs(
+    user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterIntegerPref(kConnectionsPref, kDefaultConnections);
+  registry->RegisterIntegerPref(kMaxActivePref, kDefaultMaxActive);
+  registry->RegisterBooleanPref(kWifiOnlyPref, false);
+  registry->RegisterListPref(kQueuePref);
+}
+
+// static
+CromikoDownloadQueue::WaitReason CromikoDownloadQueue::GetWaitReason(
+    const download::DownloadItem* item) {
+  auto* data = static_cast<WaitReasonData*>(item->GetUserData(kWaitReasonKey));
+  return data && item->IsPaused() && !item->IsDone() ? data->reason
+                                                     : WaitReason::kNone;
+}
+
+// static
+int CromikoDownloadQueue::GetConnectionCount(
+    const download::DownloadItem* item) {
+  if (!IsRunning(item) || item->AllDataSaved()) {
+    return 0;
+  }
+  if (!item->IsParallelDownload()) {
+    return 1;
+  }
+  // Each connection of a parallel download writes its own slice of the file.
+  int unfinished_slices = static_cast<int>(std::ranges::count_if(
+      item->GetReceivedSlices(),
+      [](const download::DownloadItem::ReceivedSlice& slice) {
+        return !slice.finished;
+      }));
+  return std::max(1, unfinished_slices);
+}
+
+void CromikoDownloadQueue::OnDownloadCreated(content::DownloadManager* manager,
+                                             download::DownloadItem* item) {
+  Observe(item);
+  Update();
+}
+
+void CromikoDownloadQueue::OnManagerInitialized() {
+  PruneSavedQueue();
+  Update();
+}
+
+void CromikoDownloadQueue::ManagerGoingDown(content::DownloadManager* manager) {
+  item_observations_.RemoveAllObservations();
+  manager_observation_.Reset();
+  manager_ = nullptr;
+}
+
+void CromikoDownloadQueue::OnDownloadUpdated(download::DownloadItem* item) {
+  if (updating_) {
+    return;
+  }
+  auto* data = static_cast<StatusData*>(item->GetUserData(kStatusKey));
+  if (data && data->status == StatusOf(item)) {
+    // Only the progress changed.
+    return;
+  }
+  if (item->IsDone()) {
+    item_observations_.RemoveObservation(item);
+    forced_.erase(item->GetGuid());
+    SetWaitReason(item, WaitReason::kNone);
+  }
+  Update();
+}
+
+void CromikoDownloadQueue::OnDownloadDestroyed(download::DownloadItem* item) {
+  item_observations_.RemoveObservation(item);
+  forced_.erase(item->GetGuid());
+  // The user removed the download: it no longer waits. (When the browser shuts
+  // down, the downloads are destroyed after ManagerGoingDown(), and keep their
+  // place in the queue.)
+  SetWaitReason(item, WaitReason::kNone);
+}
+
+void CromikoDownloadQueue::OnNetworkChanged(
+    net::NetworkChangeNotifier::ConnectionType type) {
+  Update();
+}
+
+void CromikoDownloadQueue::OnConnectionCostChanged(
+    net::NetworkChangeNotifier::ConnectionCost cost) {
+  Update();
+}
+
+void CromikoDownloadQueue::Observe(download::DownloadItem* item) {
+  if (item->IsDone() || item_observations_.IsObservingSource(item)) {
+    return;
+  }
+  item_observations_.AddObservation(item);
+  // A download that waited before the browser restarted still waits.
+  if (!off_the_record_ &&
+      prefs_->GetList(kQueuePref).contains(item->GetGuid())) {
+    if (item->IsPaused()) {
+      item->SetUserData(kWaitReasonKey,
+                        std::make_unique<WaitReasonData>(WaitReason::kQueue));
+    } else {
+      SetWaitReason(item, WaitReason::kNone);
+    }
+  }
+}
+
+void CromikoDownloadQueue::OnConnectionsChanged() {
+  download::SetParallelRequestCountOverride(
+      std::clamp(prefs_->GetInteger(kConnectionsPref), 1, kMaxConnections));
+}
+
+void CromikoDownloadQueue::Update() {
+  if (!manager_ || updating_) {
+    return;
+  }
+  base::AutoReset<bool> updating(&updating_, true);
+
+  download::SimpleDownloadManager::DownloadVector items;
+  manager_->GetAllDownloads(&items);
+  std::vector<download::DownloadItem*> running;
+  std::vector<download::DownloadItem*> waiting;
+  for (download::DownloadItem* item : items) {
+    if (!item_observations_.IsObservingSource(item)) {
+      continue;
+    }
+    item->SetUserData(kStatusKey, std::make_unique<StatusData>(StatusOf(item)));
+    const std::string& guid = item->GetGuid();
+    bool marked = item->GetUserData(kWaitReasonKey) != nullptr;
+    if (marked && item->IsPaused() && !item->IsDone()) {
+      waiting.push_back(item);
+      continue;
+    }
+    if (marked) {
+      SetWaitReason(item, WaitReason::kNone);
+    }
+    if (IsRunning(item)) {
+      // A download resumed by the user runs, whatever the limit and the
+      // network are.
+      if (marked || item->GetUserData(kUserPausedKey)) {
+        forced_.insert(guid);
+      }
+      item->RemoveUserData(kUserPausedKey);
+      running.push_back(item);
+    } else if (item->IsPaused()) {
+      item->SetUserData(kUserPausedKey,
+                        std::make_unique<base::SupportsUserData::Data>());
+      forced_.erase(guid);
+    }
+  }
+  std::ranges::sort(running, StartedBefore);
+  std::ranges::sort(waiting, StartedBefore);
+
+  const bool wifi_wait = prefs_->GetBoolean(kWifiOnlyPref) && IsOnMobileData();
+  const int max_active = prefs_->GetInteger(kMaxActivePref);
+  const int limit = max_active > 0 ? max_active : INT_MAX;
+
+  // The oldest downloads run, the newest ones wait.
+  int active = 0;
+  for (download::DownloadItem* item : running) {
+    if (forced_.contains(item->GetGuid()) || item->AllDataSaved()) {
+      continue;
+    }
+    if (CanWait(item) && (wifi_wait || active >= limit)) {
+      // Mark it first, so that the observers of the pause see why it waits.
+      SetWaitReason(item, wifi_wait ? WaitReason::kWifi : WaitReason::kQueue);
+      item->Pause();
+      continue;
+    }
+    ++active;
+  }
+  for (download::DownloadItem* item : waiting) {
+    if (wifi_wait) {
+      SetWaitReason(item, WaitReason::kWifi);
+    } else if (active >= limit) {
+      SetWaitReason(item, WaitReason::kQueue);
+    } else {
+      SetWaitReason(item, WaitReason::kNone);
+      if (item->CanResume()) {
+        item->Resume(/*user_resume=*/true);
+        ++active;
+      }
+    }
+  }
+}
+
+void CromikoDownloadQueue::SetWaitReason(download::DownloadItem* item,
+                                         WaitReason reason) {
+  if (reason == WaitReason::kNone) {
+    item->RemoveUserData(kWaitReasonKey);
+  } else {
+    item->SetUserData(kWaitReasonKey,
+                      std::make_unique<WaitReasonData>(reason));
+  }
+  if (off_the_record_) {
+    return;
+  }
+  const std::string& guid = item->GetGuid();
+  bool saved = prefs_->GetList(kQueuePref).contains(guid);
+  if (reason != WaitReason::kNone && !saved) {
+    ScopedListPrefUpdate(prefs_, kQueuePref)->Append(guid);
+  } else if (reason == WaitReason::kNone && saved) {
+    ScopedListPrefUpdate(prefs_, kQueuePref)->EraseValue(base::Value(guid));
+  }
+}
+
+void CromikoDownloadQueue::PruneSavedQueue() {
+  if (off_the_record_ || !manager_) {
+    return;
+  }
+  auto is_gone = [this](const base::Value& guid) {
+    return !guid.is_string() || !manager_->GetDownloadByGuid(guid.GetString());
+  };
+  if (std::ranges::any_of(prefs_->GetList(kQueuePref), is_gone)) {
+    ScopedListPrefUpdate(prefs_, kQueuePref)->EraseIf(is_gone);
+  }
+}
