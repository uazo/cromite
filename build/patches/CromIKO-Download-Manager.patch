+    /**
+     * CromIKO: the folder for a new download if the user turned on "Sort into folders" in the
+     * CromIKO download settings (CromikoDownloadSettings.java), or null.
+     *
+     * @param mimeType Mime type of the file.
+     * @param fileName Name of the file.
+     * @return The folder, relative to the download folder.
+     */
+    private static @Nullable String getCromikoFolder(String mimeType, String fileName) {
+        if (!ContextUtils.getAppSharedPreferences()
+                .getBoolean(CROMIKO_SORT_DOWNLOADS_PREF, false)) {
+            return null;
+        }
+        String type = mimeType.toLowerCase(Locale.ROOT);
+        String name = fileName.toLowerCase(Locale.ROOT);
+        String folder;
+        if (type.startsWith("video/")) {
+            folder = "Videos";
+        } else if (type.startsWith("audio/")) {
+            folder = "Music";
+        } else if (type.startsWith("image/")) {
+            folder = "Pictures";
+        } else if (type.equals("application/vnd.android.package-archive")
+                || name.endsWith(".apk")
+                || name.endsWith(".apks")
+                || name.endsWith(".xapk")) {
+            folder = "Apps";
+        } else if (CROMIKO_ARCHIVE_TYPES.contains(type)
+                || CROMIKO_ARCHIVE_EXTENSIONS.contains(getExtension(name))) {
+            folder = "Archives";
+        } else if (type.startsWith("text/")
+                || type.equals("application/pdf")
+                || type.equals("application/rtf")
+                || type.equals("application/epub+zip")
+                || type.equals("application/msword")
+                || type.startsWith("application/vnd.ms-")
+                || type.startsWith("application/vnd.openxmlformats-officedocument.")
+                || type.startsWith("application/vnd.oasis.opendocument.")) {
+            folder = "Documents";
+        } else {
+            return null;
+        }
+        return "CromIKO/" + folder;
+    }
+
+    private static String getExtension(String fileName) {
+        int index = fileName.lastIndexOf('.');
+        return index == -1 ? "" : fileName.substring(index + 1);
+    }
