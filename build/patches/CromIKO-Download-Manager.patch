+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.cromiko;
+
+import android.os.Bundle;
+
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.base.supplier.MonotonicObservableSupplier;
+import org.chromium.base.supplier.ObservableSuppliers;
+import org.chromium.base.supplier.SettableMonotonicObservableSupplier;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.components.browser_ui.settings.ChromeSwitchPreference;
+import org.chromium.components.browser_ui.settings.SettingsUtils;
+import org.chromium.components.prefs.PrefService;
+import org.chromium.components.user_prefs.UserPrefs;
+
+/**
+ * CromIKO: the settings of the CromIKO download manager, in Settings > Downloads: the number of
+ * connections per file, the number of downloads at the same time, "Wi-Fi only", and the sorting of
+ * new files into folders. chrome/browser/download/cromiko_download_queue.cc uses the first three,
+ * DownloadCollectionBridge.java the last one.
+ */
+@NullMarked
+public class CromikoDownloadSettings extends ChromeBaseSettingsFragment
+        implements Preference.OnPreferenceChangeListener {
+    // The keys of the preferences in cromiko_download_preferences.xml.
+    private static final String PREF_CONNECTIONS = "connections";
+    private static final String PREF_MAX_ACTIVE = "max_active";
+    private static final String PREF_WIFI_ONLY = "wifi_only";
+    private static final String PREF_SORT = "sort";
+
+    // The profile prefs of cromiko_download_queue.cc.
+    private static final String CONNECTIONS_PREF = "cromiko.downloads.connections";
+    private static final String MAX_ACTIVE_PREF = "cromiko.downloads.max_active";
+    private static final String WIFI_ONLY_PREF = "cromiko.downloads.wifi_only";
+    // The app shared preference of DownloadCollectionBridge.java.
+    private static final String SORT_PREF = "cromiko_sort_downloads";
+
+    private static final int[] CONNECTIONS = {1, 2, 3, 4, 6, 8};
+    // 0 is no limit.
+    private static final int[] MAX_ACTIVE = {1, 2, 3, 4, 5, 0};
+
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getString(R.string.cromiko_download_settings_title));
+        SettingsUtils.addPreferencesFromResource(this, R.xml.cromiko_download_preferences);
+        PrefService prefs = getPrefs();
+
+        String[] connections = new String[CONNECTIONS.length];
+        for (int i = 0; i < CONNECTIONS.length; i++) {
+            connections[i] =
+                    CONNECTIONS[i] == 1
+                            ? getString(R.string.cromiko_download_one_connection)
+                            : getString(R.string.cromiko_download_connections, CONNECTIONS[i]);
+        }
+        setUpList(PREF_CONNECTIONS, CONNECTIONS, connections, prefs.getInteger(CONNECTIONS_PREF));
+
+        String[] maxActive = new String[MAX_ACTIVE.length];
+        for (int i = 0; i < MAX_ACTIVE.length; i++) {
+            maxActive[i] =
+                    MAX_ACTIVE[i] == 0
+                            ? getString(R.string.cromiko_download_no_limit)
+                            : String.valueOf(MAX_ACTIVE[i]);
+        }
+        setUpList(PREF_MAX_ACTIVE, MAX_ACTIVE, maxActive, prefs.getInteger(MAX_ACTIVE_PREF));
+
+        ChromeSwitchPreference wifiOnly = (ChromeSwitchPreference) findPreference(PREF_WIFI_ONLY);
+        wifiOnly.setChecked(prefs.getBoolean(WIFI_ONLY_PREF));
+        wifiOnly.setOnPreferenceChangeListener(this);
+
+        ChromeSwitchPreference sort = (ChromeSwitchPreference) findPreference(PREF_SORT);
+        sort.setChecked(ContextUtils.getAppSharedPreferences().getBoolean(SORT_PREF, false));
+        sort.setOnPreferenceChangeListener(this);
+    }
+
+    private void setUpList(String key, int[] values, String[] entries, int value) {
+        ListPreference list = (ListPreference) findPreference(key);
+        String[] entryValues = new String[values.length];
+        for (int i = 0; i < values.length; i++) entryValues[i] = String.valueOf(values[i]);
+        list.setEntries(entries);
+        list.setEntryValues(entryValues);
+        list.setValue(String.valueOf(value));
+        list.setSummaryProvider(ListPreference.SimpleSummaryProvider.getInstance());
+        list.setOnPreferenceChangeListener(this);
+    }
+
+    private PrefService getPrefs() {
+        return UserPrefs.get(getProfile().getOriginalProfile());
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        String key = preference.getKey();
+        if (PREF_CONNECTIONS.equals(key)) {
+            getPrefs().setInteger(CONNECTIONS_PREF, Integer.parseInt((String) newValue));
+        } else if (PREF_MAX_ACTIVE.equals(key)) {
+            getPrefs().setInteger(MAX_ACTIVE_PREF, Integer.parseInt((String) newValue));
+        } else if (PREF_WIFI_ONLY.equals(key)) {
+            getPrefs().setBoolean(WIFI_ONLY_PREF, (boolean) newValue);
+        } else if (PREF_SORT.equals(key)) {
+            ContextUtils.getAppSharedPreferences()
+                    .edit()
+                    .putBoolean(SORT_PREF, (boolean) newValue)
+                    .apply();
+        }
+        return true;
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    @Override
+    public @AnimationType int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }
+
+    @Override
+    public @Nullable String getMainMenuKey() {
+        return "downloads";
+    }
+}
