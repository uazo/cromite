+++ b/chrome/browser/download/android/java/src/org/chromium/chrome/browser/download/CromikoDownloadStatus.java
@@ -0,0 +1,118 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.download;
+
+import android.content.Context;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.components.browser_ui.util.DownloadUtils;
+import org.chromium.components.offline_items_collection.ContentId;
+
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * CromIKO: what the CromIKO download manager shows about the downloads that run or wait: their
+ * speed, their number of connections, and why they wait in the queue of
+ * chrome/browser/download/cromiko_download_queue.cc. The native side sends it with each update of
+ * a download, see {@link DownloadInfo}.
+ */
+@NullMarked
+public final class CromikoDownloadStatus {
+    // The values of CromikoDownloadQueue::WaitReason.
+    private static final int WAIT_REASON_NONE = 0;
+    private static final int WAIT_REASON_QUEUE = 1;
+    private static final int WAIT_REASON_WIFI = 2;
+
+    private static final class Status {
+        final int mWaitReason;
+        final long mBytesPerSecond;
+        final int mConnections;
+
+        Status(int waitReason, long bytesPerSecond, int connections) {
+            mWaitReason = waitReason;
+            mBytesPerSecond = bytesPerSecond;
+            mConnections = connections;
+        }
+    }
+
+    // By download GUID, only for the downloads that run or wait.
+    private static final Map<String, Status> sStatuses = new ConcurrentHashMap<>();
+
+    private CromikoDownloadStatus() {}
+
+    /**
+     * Keeps the status of a download.
+     *
+     * @param guid The GUID of the download.
+     * @param waitReason Why the download waits in the queue.
+     * @param bytesPerSecond The speed of the download, 0 if it does not run.
+     * @param connections The number of connections that the download uses, 0 if it does not run.
+     */
+    static void update(String guid, int waitReason, long bytesPerSecond, int connections) {
+        if (waitReason == WAIT_REASON_NONE && connections <= 0) {
+            sStatuses.remove(guid);
+        } else {
+            sStatuses.put(guid, new Status(waitReason, bytesPerSecond, connections));
+        }
+    }
+
+    /** Whether the download with |id| waits in the queue of the CromIKO download manager. */
+    public static boolean isWaiting(@Nullable ContentId id) {
+        Status status = get(id);
+        return status != null && status.mWaitReason != WAIT_REASON_NONE;
+    }
+
+    /**
+     * Why the download with |id| waits, for its notification, or null if it does not wait.
+     *
+     * @param forList Whether the text is part of a caption of the download list, which is
+     *     lowercase.
+     */
+    public static @Nullable String getWaitText(
+            Context context, @Nullable ContentId id, boolean forList) {
+        Status status = get(id);
+        if (status == null) return null;
+        switch (status.mWaitReason) {
+            case WAIT_REASON_QUEUE:
+                return context.getString(
+                        forList
+                                ? R.string.cromiko_download_manager_queued
+                                : R.string.cromiko_download_queued);
+            case WAIT_REASON_WIFI:
+                return context.getString(
+                        forList
+                                ? R.string.cromiko_download_manager_waiting_for_wifi
+                                : R.string.cromiko_download_waiting_for_wifi);
+            default:
+                return null;
+        }
+    }
+
+    /**
+     * The speed of the running download with |id|, like "2.4 MB/s", or null if it is not known.
+     *
+     * @param withConnections Whether to add the number of connections when there are several, like
+     *     "2.4 MB/s • 4 connections".
+     */
+    public static @Nullable String getSpeedText(
+            Context context, @Nullable ContentId id, boolean withConnections) {
+        Status status = get(id);
+        if (status == null || status.mBytesPerSecond <= 0) return null;
+        String speed =
+                context.getString(
+                        R.string.cromiko_download_speed,
+                        DownloadUtils.getStringForBytes(context, status.mBytesPerSecond));
+        if (!withConnections || status.mConnections <= 1) return speed;
+        return context.getString(
+                R.string.download_manager_in_progress_description,
+                speed,
+                context.getString(R.string.cromiko_download_connections, status.mConnections));
+    }
+
+    private static @Nullable Status get(@Nullable ContentId id) {
+        return id != null && id.id != null ? sStatuses.get(id.id) : null;
+    }
+}
