+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+#ifndef CHROME_BROWSER_DOWNLOAD_CROMIKO_DOWNLOAD_QUEUE_H_
+#define CHROME_BROWSER_DOWNLOAD_CROMIKO_DOWNLOAD_QUEUE_H_
+
+#include <set>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_multi_source_observation.h"
+#include "base/scoped_observation.h"
+#include "components/download/public/common/download_item.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "content/public/browser/download_manager.h"
+#include "net/base/network_change_notifier.h"
+
+class PrefService;
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}
+
+// CromIKO: the queue of the CromIKO download manager. It lets only a number of
+// downloads run at the same time and pauses the others until it is their turn,
+// keeps downloads waiting while the user is on mobile data if they turned on
+// "Wi-Fi only", and sets the number of connections of parallel downloads. A
+// waiting download that the user resumes runs right away. The settings are
+// profile prefs, changed in CromikoDownloadSettings.java.
+class CromikoDownloadQueue
+    : public content::DownloadManager::Observer,
+      public download::DownloadItem::Observer,
+      public net::NetworkChangeNotifier::NetworkChangeObserver,
+      public net::NetworkChangeNotifier::ConnectionCostObserver {
+ public:
+  // Why a download waits. Java uses the same values, see
+  // CromikoDownloadStatus.java.
+  enum class WaitReason {
+    kNone = 0,
+    kQueue = 1,
+    kWifi = 2,
+  };
+
+  CromikoDownloadQueue(content::DownloadManager* manager,
+                       PrefService* prefs,
+                       bool off_the_record);
+  CromikoDownloadQueue(const CromikoDownloadQueue&) = delete;
+  CromikoDownloadQueue& operator=(const CromikoDownloadQueue&) = delete;
+  ~CromikoDownloadQueue() override;
+
+  static void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+  // Why |item| waits in the queue.
+  static WaitReason GetWaitReason(const download::DownloadItem* item);
+
+  // The number of connections that |item| uses now.
+  static int GetConnectionCount(const download::DownloadItem* item);
+
+  // content::DownloadManager::Observer:
+  void OnDownloadCreated(content::DownloadManager* manager,
+                         download::DownloadItem* item) override;
+  void OnManagerInitialized() override;
+  void ManagerGoingDown(content::DownloadManager* manager) override;
+
+  // download::DownloadItem::Observer:
+  void OnDownloadUpdated(download::DownloadItem* item) override;
+  void OnDownloadDestroyed(download::DownloadItem* item) override;
+
+  // net::NetworkChangeNotifier::NetworkChangeObserver:
+  void OnNetworkChanged(
+      net::NetworkChangeNotifier::ConnectionType type) override;
+
+  // net::NetworkChangeNotifier::ConnectionCostObserver:
+  void OnConnectionCostChanged(
+      net::NetworkChangeNotifier::ConnectionCost cost) override;
+
+ private:
+  void Observe(download::DownloadItem* item);
+  void OnConnectionsChanged();
+  void Update();
+  void SetWaitReason(download::DownloadItem* item, WaitReason reason);
+  // Removes the downloads that no longer exist from the saved queue.
+  void PruneSavedQueue();
+
+  raw_ptr<content::DownloadManager> manager_;
+  raw_ptr<PrefService> prefs_;
+  // Off the record downloads do not survive a restart: their queue is not
+  // saved.
+  const bool off_the_record_;
+  PrefChangeRegistrar pref_change_registrar_;
+  // The downloads the user resumed while they waited: they run whatever the
+  // limit and the network are.
+  std::set<std::string> forced_;
+  // Guards against the updates that Update() causes itself.
+  bool updating_ = false;
+
+  base::ScopedObservation<content::DownloadManager,
+                          content::DownloadManager::Observer>
+      manager_observation_{this};
+  base::ScopedMultiSourceObservation<download::DownloadItem,
+                                     download::DownloadItem::Observer>
+      item_observations_{this};
+};
+
+#endif  // CHROME_BROWSER_DOWNLOAD_CROMIKO_DOWNLOAD_QUEUE_H_
