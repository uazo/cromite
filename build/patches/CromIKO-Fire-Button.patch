+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.app.tabmodel.ArchivedTabModelOrchestrator;
+import org.chromium.chrome.browser.browsing_data.BrowsingDataBridge;
+import org.chromium.chrome.browser.browsing_data.BrowsingDataType;
+import org.chromium.chrome.browser.browsing_data.TimePeriod;
+import org.chromium.chrome.browser.preferences.Pref;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.chrome.browser.tabmodel.TabClosureParams;
+import org.chromium.chrome.browser.tabmodel.TabCreator;
+import org.chromium.chrome.browser.tabmodel.TabCreatorUtil;
+import org.chromium.chrome.browser.tabmodel.TabModel;
+import org.chromium.chrome.browser.tabmodel.TabModelSelector;
+import org.chromium.components.browser_ui.styles.SemanticColorUtils;
+import org.chromium.components.user_prefs.UserPrefs;
+import org.chromium.ui.widget.Toast;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * CromIKO: the Fire button of the app menu. After a confirmation it closes all tabs (also the
+ * incognito tabs) and deletes the browsing history, cookies, site data and cache, while the mascot
+ * plays a short animation. Then it opens a new tab.
+ */
+@NullMarked
+public final class CromikoFireButton {
+    // The animation stays on screen at least this long, also when deleting is faster.
+    private static final long MIN_ANIMATION_MS = 1600;
+    private static final long FADE_MS = 250;
+    private static final int FLAME_SIZE_DP = 48;
+
+    private final Activity mActivity;
+    private final Profile mProfile;
+    private final TabModelSelector mTabModelSelector;
+    private final TabCreator mTabCreator;
+    private final List<Animator> mAnimators = new ArrayList<>();
+    private @Nullable View mOverlay;
+    private @Nullable ImageView mMascot;
+    private long mStartTime;
+
+    private CromikoFireButton(
+            Activity activity,
+            Profile profile,
+            TabModelSelector tabModelSelector,
+            TabCreator tabCreator) {
+        mActivity = activity;
+        mProfile = profile;
+        mTabModelSelector = tabModelSelector;
+        mTabCreator = tabCreator;
+    }
+
+    /**
+     * Asks for confirmation, then closes all tabs and deletes the browsing data.
+     *
+     * @param activity The tabbed activity.
+     * @param profile The profile whose data is deleted (its original profile is used).
+     * @param tabModelSelector The tab models of the activity.
+     * @param tabCreator The creator of regular tabs, for the new tab opened at the end.
+     */
+    public static void show(
+            Activity activity,
+            Profile profile,
+            TabModelSelector tabModelSelector,
+            TabCreator tabCreator) {
+        CromikoFireButton fireButton =
+                new CromikoFireButton(
+                        activity, profile.getOriginalProfile(), tabModelSelector, tabCreator);
+        new AlertDialog.Builder(activity, R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                .setTitle(R.string.cromiko_fire_button_dialog_title)
+                .setMessage(R.string.cromiko_fire_button_dialog_message)
+                .setNegativeButton(R.string.cancel, null)
+                .setPositiveButton(
+                        R.string.cromiko_fire_button_confirm, (dialog, which) -> fireButton.burn())
+                .show();
+    }
+
+    private void burn() {
+        if (mActivity.isFinishing() || mActivity.isDestroyed()) return;
+        mStartTime = SystemClock.elapsedRealtime();
+
+        View overlay = createOverlay();
+        mOverlay = overlay;
+        ((ViewGroup) mActivity.getWindow().getDecorView())
+                .addView(
+                        overlay,
+                        new FrameLayout.LayoutParams(
+                                ViewGroup.LayoutParams.MATCH_PARENT,
+                                ViewGroup.LayoutParams.MATCH_PARENT));
+        overlay.setAlpha(0f);
+        overlay.animate()
+                .alpha(1f)
+                .setDuration(FADE_MS)
+                .withEndAction(this::closeTabsAndDeleteData)
+                .start();
+    }
+
+    /** The full screen view with the animated mascot, which also blocks touches meanwhile. */
+    private View createOverlay() {
+        float density = mActivity.getResources().getDisplayMetrics().density;
+
+        ImageView mascot = new ImageView(mActivity);
+        mascot.setImageResource(R.drawable.cromiko_welcome_mascot);
+        if (mascot.getDrawable() instanceof Animatable animatable) animatable.start();
+        mascot.setScaleX(0.6f);
+        mascot.setScaleY(0.6f);
+        mascot.animate()
+                .scaleX(1f)
+                .scaleY(1f)
+                .setDuration(450)
+                .setInterpolator(new OvershootInterpolator())
+                .start();
+        // The mascot wiggles while the data burns.
+        startRepeating(ObjectAnimator.ofFloat(mascot, View.ROTATION, -6f, 6f), 180);
+        mMascot = mascot;
+
+        ImageView flame = new ImageView(mActivity);
+        flame.setImageResource(R.drawable.cromiko_ic_fire_24dp);
+        flame.setImageTintList(
+                ColorStateList.valueOf(mActivity.getColor(R.color.cromiko_accent_color)));
+        int flameSize = Math.round(FLAME_SIZE_DP * density);
+        flame.setPivotX(flameSize / 2f);
+        flame.setPivotY(flameSize);
+        startRepeating(ObjectAnimator.ofFloat(flame, View.SCALE_Y, 0.85f, 1.15f), 240);
+        startRepeating(ObjectAnimator.ofFloat(flame, View.SCALE_X, 1.05f, 0.92f), 310);
+
+        TextView text = new TextView(mActivity);
+        text.setTextAppearance(R.style.TextAppearance_Headline_Primary);
+        text.setGravity(Gravity.CENTER);
+        text.setText(R.string.cromiko_fire_button_progress);
+
+        LinearLayout column = new LinearLayout(mActivity);
+        column.setOrientation(LinearLayout.VERTICAL);
+        column.setGravity(Gravity.CENTER);
+        column.addView(mascot);
+        LinearLayout.LayoutParams flameParams =
+                new LinearLayout.LayoutParams(flameSize, flameSize);
+        flameParams.topMargin = Math.round(16 * density);
+        flameParams.bottomMargin = Math.round(16 * density);
+        column.addView(flame, flameParams);
+        column.addView(text);
+
+        FrameLayout overlay = new FrameLayout(mActivity);
+        overlay.setBackgroundColor(SemanticColorUtils.getDefaultBgColor(mActivity));
+        overlay.setClickable(true);
+        overlay.setFocusable(true);
+        overlay.addView(
+                column,
+                new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.WRAP_CONTENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT,
+                        Gravity.CENTER));
+        return overlay;
+    }
+
+    private void startRepeating(ObjectAnimator animator, long duration) {
+        animator.setDuration(duration);
+        animator.setRepeatCount(ValueAnimator.INFINITE);
+        animator.setRepeatMode(ValueAnimator.REVERSE);
+        animator.start();
+        mAnimators.add(animator);
+    }
+
+    private void closeTabsAndDeleteData() {
+        // The tabs are closed first, so that no page writes new data while it is deleted. They are
+        // not kept in "Recent tabs" either.
+        closeAllTabs(mTabModelSelector.getModel(/* incognito= */ true));
+        closeAllTabs(mTabModelSelector.getModel(/* incognito= */ false));
+        ArchivedTabModelOrchestrator archived = ArchivedTabModelOrchestrator.getForProfile(mProfile);
+        TabModel archivedTabs = archived.areTabModelsInitialized() ? archived.getTabModel() : null;
+        if (archivedTabs != null) closeAllTabs(archivedTabs);
+
+        // Same data types as "Delete browsing data" in the menu, for all time.
+        int[] dataTypes;
+        if (UserPrefs.get(mProfile).getBoolean(Pref.ALLOW_DELETING_BROWSER_HISTORY)) {
+            dataTypes =
+                    new int[] {
+                        BrowsingDataType.HISTORY, BrowsingDataType.SITE_DATA, BrowsingDataType.CACHE
+                    };
+        } else {
+            dataTypes = new int[] {BrowsingDataType.SITE_DATA, BrowsingDataType.CACHE};
+        }
+        BrowsingDataBridge.getForProfile(mProfile)
+                .clearBrowsingData(this::onDataDeleted, dataTypes, TimePeriod.ALL_TIME);
+    }
+
+    private static void closeAllTabs(TabModel tabModel) {
+        tabModel.getTabRemover()
+                .closeTabs(
+                        TabClosureParams.closeAllTabs()
+                                .allowUndo(false)
+                                .saveToTabRestoreService(false)
+                                .build(),
+                        /* allowDialog= */ false);
+    }
+
+    private void onDataDeleted() {
+        long elapsed = SystemClock.elapsedRealtime() - mStartTime;
+        PostTask.postDelayedTask(
+                TaskTraits.UI_DEFAULT, this::finish, Math.max(0, MIN_ANIMATION_MS - elapsed));
+    }
+
+    private void finish() {
+        View overlay = mOverlay;
+        mOverlay = null;
+        if (overlay == null) return;
+        if (mActivity.isFinishing() || mActivity.isDestroyed()) {
+            removeOverlay(overlay);
+            return;
+        }
+
+        TabCreatorUtil.launchNtp(mTabCreator);
+        Toast.makeText(mActivity, R.string.cromiko_fire_button_done, Toast.LENGTH_SHORT).show();
+        if (mMascot != null) {
+            mMascot.animate().scaleX(1.2f).scaleY(1.2f).setDuration(FADE_MS).start();
+        }
+        overlay.animate()
+                .alpha(0f)
+                .setDuration(FADE_MS)
+                .withEndAction(() -> removeOverlay(overlay))
+                .start();
+    }
+
+    private void removeOverlay(View overlay) {
+        for (Animator animator : mAnimators) animator.cancel();
+        mAnimators.clear();
+        if (mMascot != null && mMascot.getDrawable() instanceof Animatable animatable) {
+            animatable.stop();
+        }
+        mMascot = null;
+        if (overlay.getParent() instanceof ViewGroup parent) parent.removeView(overlay);
+    }
+}
