From: PupJune2 <PupJune2@users.noreply.github.com>
Date: Mon, 19 Oct 2026 12:00:00 +0000
Subject: CromIKO for Google Play

Only in the Google Play version of CromIKO (build/cromiko_play_patches_list.txt,
applied after all other patches when tools/cromiko/build-android.sh builds with
CROMIKO_FLAVOR=play). The GitHub version does not get it.

- No update check: Google Play updates the app, and Play apps may not update
  themselves another way. The "allow updates" switch in Settings > About
  CromIKO is hidden.
- No background play in the CromIKO player on YouTube (also YouTube videos
  embedded in other sites): YouTube's terms do not allow it. Other sites keep
  it.

License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
---
 chrome/android/java/res/raw/cromiko_video.js           | 10 ++++++++--
 .../browser/about_settings/AboutChromeSettings.java    |  2 ++
 .../omaha/inline/BromiteInlineUpdateController.java    |  4 ++++
 3 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/chrome/android/java/res/raw/cromiko_video.js b/chrome/android/java/res/raw/cromiko_video.js
--- a/chrome/android/java/res/raw/cromiko_video.js
+++ b/chrome/android/java/res/raw/cromiko_video.js
@@ -44,6 +44,10 @@
         new Set(['SCRIPT', 'STYLE', 'LINK', 'META', 'NOSCRIPT', 'TEMPLATE']);
     const POSITIONS_KEY = 'cromiko-player-positions';
     const SETTINGS_KEY = 'cromiko-player-settings';
+    // CromIKO for Google Play: YouTube's terms do not allow playing its videos in the
+    // background, also when embedded in other sites.
+    const NO_BACKGROUND_PLAY =
+        /(^|\.)(youtube\.com|youtube-nocookie\.com|youtu\.be)$/.test(location.hostname);
 
     // |hex|, like '#5C7CFC', with an opacity, for CSS.
     function alpha(hex, opacity) {
@@ -826,7 +830,7 @@
         fit: 'contain',
         brightness: 1,
         locked: false,
-        background: s.background,
+        background: s.background && !NO_BACKGROUND_PLAY,
         sleepMinutes: 0,
         sleepTimer: null,
         pointers: new Map(),
@@ -1614,7 +1618,9 @@
         const on = t.on || 'On';
         const off = t.off || 'Off';
         item('loop', t.loop || 'Loop', m.loop ? on : off);
-        item('background', t.background || 'Background play', p.background ? on : off);
+        if (!NO_BACKGROUND_PLAY) {
+          item('background', t.background || 'Background play', p.background ? on : off);
+        }
         item('sleep', t.sleep || 'Sleep timer',
              p.sleepMinutes ? p.sleepMinutes + ' min' : off);
       }
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/about_settings/AboutChromeSettings.java b/chrome/android/java/src/org/chromium/chrome/browser/about_settings/AboutChromeSettings.java
--- a/chrome/android/java/src/org/chromium/chrome/browser/about_settings/AboutChromeSettings.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/about_settings/AboutChromeSettings.java
@@ -95,6 +95,8 @@ public class AboutChromeSettings extends ChromeBaseSettingsFragment
             OmahaPrefUtils.getSharedPreferences()
                           .getBoolean(OmahaPrefUtils.PREF_ALLOW_INLINE_UPDATE, false));
         allowInlineUpdate.setOnPreferenceChangeListener(this);
+        // CromIKO for Google Play: Google Play updates the app.
+        allowInlineUpdate.setVisible(false);
     }
 
     @Override
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/omaha/inline/BromiteInlineUpdateController.java b/chrome/android/java/src/org/chromium/chrome/browser/omaha/inline/BromiteInlineUpdateController.java
--- a/chrome/android/java/src/org/chromium/chrome/browser/omaha/inline/BromiteInlineUpdateController.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/omaha/inline/BromiteInlineUpdateController.java
@@ -155,6 +155,10 @@ public class BromiteInlineUpdateController implements InlineUpdateController {
     }
 
     private void pullCurrentState() {
+        // CromIKO for Google Play: Google Play updates the app, and Play apps may not update
+        // themselves another way.
+        if (true) return;
+
         if (OmahaPrefUtils.getSharedPreferences()
                 .getBoolean(OmahaPrefUtils.PREF_ALLOW_INLINE_UPDATE, false) == false) {
             Log.i(TAG, "BromiteUpdater: disabled by user");
