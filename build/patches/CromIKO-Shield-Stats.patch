+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.cromiko;
+
+import android.content.Context;
+import android.util.AttributeSet;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.profiles.ProfileManager;
+import org.chromium.chrome.browser.settings.AdBlockPreferences;
+import org.chromium.chrome.browser.settings.SettingsNavigationFactory;
+import org.chromium.components.prefs.PrefService;
+import org.chromium.components.user_prefs.UserPrefs;
+
+import java.text.NumberFormat;
+import java.time.DayOfWeek;
+import java.time.LocalDate;
+import java.time.temporal.TemporalAdjusters;
+
+/**
+ * CromIKO: the shield card on the new tab page. It shows how many requests the ad blocker blocked
+ * this week, as counted by components/subresource_filter/content/browser/cromiko_shield_stats.cc.
+ * Tapping it opens the ad blocker settings.
+ */
+@NullMarked
+public class CromikoShieldStatsView extends LinearLayout {
+    // Profile prefs written by cromiko_shield_stats.cc: the week of the count, as the day number of
+    // its Monday, and the count.
+    private static final String WEEK_PREF = "cromiko.shield_stats.week";
+    private static final String BLOCKED_PREF = "cromiko.shield_stats.blocked";
+
+    private @Nullable TextView mCount;
+
+    /** Constructor for inflating from XML. */
+    public CromikoShieldStatsView(Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+    }
+
+    @Override
+    protected void onFinishInflate() {
+        super.onFinishInflate();
+        mCount = findViewById(R.id.cromiko_shield_stats_count);
+        setOnClickListener(
+                view ->
+                        SettingsNavigationFactory.createSettingsNavigation()
+                                .startSettings(getContext(), AdBlockPreferences.class));
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        updateCount();
+    }
+
+    @Override
+    protected void onWindowVisibilityChanged(int visibility) {
+        super.onWindowVisibilityChanged(visibility);
+        if (visibility == VISIBLE) updateCount();
+    }
+
+    private void updateCount() {
+        if (mCount == null || !ProfileManager.isInitialized()) return;
+        PrefService prefs = UserPrefs.get(ProfileManager.getLastUsedRegularProfile());
+        int week =
+                (int)
+                        LocalDate.now()
+                                .with(TemporalAdjusters.previousOrSame(DayOfWeek.MONDAY))
+                                .toEpochDay();
+        int blocked = prefs.getInteger(WEEK_PREF) == week ? prefs.getInteger(BLOCKED_PREF) : 0;
+        mCount.setText(NumberFormat.getIntegerInstance().format(blocked));
+    }
+}
