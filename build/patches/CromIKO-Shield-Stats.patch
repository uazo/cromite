diff --git a/components/subresource_filter/content/browser/cromiko_shield_stats.cc b/components/subresource_filter/content/browser/cromiko_shield_stats.cc
new file mode 100644
--- /dev/null
+++ b/components/subresource_filter/content/browser/cromiko_shield_stats.cc
@@ -0,0 +1,53 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+#include "components/subresource_filter/content/browser/cromiko_shield_stats.h"
+
+#include "base/numerics/clamped_math.h"
+#include "base/time/time.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "components/user_prefs/user_prefs.h"
+#include "content/public/browser/browser_context.h"
+
+namespace subresource_filter::cromiko_shield_stats {
+
+namespace {
+
+int CurrentWeek() {
+  base::Time::Exploded now;
+  base::Time::Now().LocalExplode(&now);
+  base::Time::Exploded today = {};
+  today.year = now.year;
+  today.month = now.month;
+  today.day_of_month = now.day_of_month;
+  base::Time today_midnight;
+  if (!base::Time::FromUTCExploded(today, &today_midnight)) {
+    return 0;
+  }
+  // day_of_week is 0 on Sunday, weeks start on Monday.
+  return (today_midnight - base::Time::UnixEpoch()).InDays() -
+         (now.day_of_week + 6) % 7;
+}
+
+}  // namespace
+
+void RegisterProfilePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterIntegerPref(kWeekPref, 0);
+  registry->RegisterIntegerPref(kBlockedPref, 0);
+}
+
+void RecordBlockedRequests(content::BrowserContext* context, int count) {
+  // Nothing is recorded for incognito tabs.
+  if (count <= 0 || !context || context->IsOffTheRecord()) {
+    return;
+  }
+  PrefService* prefs = user_prefs::UserPrefs::Get(context);
+  const int week = CurrentWeek();
+  const int blocked =
+      prefs->GetInteger(kWeekPref) == week ? prefs->GetInteger(kBlockedPref) : 0;
+  prefs->SetInteger(kWeekPref, week);
+  prefs->SetInteger(kBlockedPref, base::ClampAdd(blocked, count));
+}
+
+}  // namespace subresource_filter::cromiko_shield_stats
