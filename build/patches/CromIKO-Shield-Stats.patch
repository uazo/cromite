+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+#ifndef COMPONENTS_SUBRESOURCE_FILTER_CONTENT_BROWSER_CROMIKO_SHIELD_STATS_H_
+#define COMPONENTS_SUBRESOURCE_FILTER_CONTENT_BROWSER_CROMIKO_SHIELD_STATS_H_
+
+class PrefRegistrySimple;
+
+namespace content {
+class BrowserContext;
+}  // namespace content
+
+// CromIKO: counts the requests that the ad blocker blocked in the current week,
+// for the shield card on the new tab page. CromikoShieldStatsView.java reads
+// the same prefs.
+namespace subresource_filter::cromiko_shield_stats {
+
+// The week of the count: the day number (days since 1970-01-01) of its Monday,
+// in local time.
+inline constexpr char kWeekPref[] = "cromiko.shield_stats.week";
+// The number of requests blocked in that week.
+inline constexpr char kBlockedPref[] = "cromiko.shield_stats.blocked";
+
+void RegisterProfilePrefs(PrefRegistrySimple* registry);
+
+// Adds `count` blocked requests to the count of the current week.
+void RecordBlockedRequests(content::BrowserContext* context, int count);
+
+}  // namespace subresource_filter::cromiko_shield_stats
+
+#endif  // COMPONENTS_SUBRESOURCE_FILTER_CONTENT_BROWSER_CROMIKO_SHIELD_STATS_H_
