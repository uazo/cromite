+        const dy = Math.max(r.top - y, 0, y - r.bottom);
+        const distance = dx * dx + dy * dy;
+        const area = r.width * r.height;
+        if (distance < bestDistance ||
+            (distance === bestDistance && area > bestArea)) {
+          best = el;
+          bestDistance = distance;
+          bestArea = area;
+        }
+      }
+      return best;
