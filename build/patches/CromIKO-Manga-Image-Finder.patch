+    function isBig(el) {
+      const r = el.getBoundingClientRect();
+      return r.width >= MIN_PAGE_SIZE && r.height >= MIN_PAGE_SIZE;
+    }
+
+    // The address of the image file that an element shows or will load, or
+    // an empty string.
+    function imageFileOf(el) {
+      const values = IMAGE_ATTRIBUTES.map(name => el.getAttribute(name));
+      if (el.tagName === 'IMG') {
+        values.push(el.currentSrc, el.getAttribute('src'));
+      }
+      for (const value of values) {
