+    function isPageImage(el) {
+      const big = isBig(el);
+      if (el.tagName === 'CANVAS') {
+        return big;
+      }
+      const loaded = el.complete && el.naturalWidth >= MIN_PAGE_SIZE;
+      return (big || hasLazyHint(el)) && (loaded || !!imageFileOf(el));
