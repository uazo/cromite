+    // Attributes where sites keep the address of an image they load later.
+    const IMAGE_ATTRIBUTES = LAZY_ATTRIBUTES.concat(
+        ['data-srcset', 'data-lazy', 'data-image', 'data-img', 'data-bg',
+         'data-background', 'data-full', 'data-hi-res', 'srcset', 'href']);
+    // Smaller pictures are icons, avatars or buttons, not chapter pages.
+    const MIN_PAGE_SIZE = 80;
+    // How far from a tap on a gap, a page number or the frame of a page the
+    // page can be.
+    const NEAR_PAGE = 48;
     // How long "read" and "auto" wait for the chapter images to appear.
     const WAIT_MS = 20000;
