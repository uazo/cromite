+    function nearestImage(root, x, y, maxDistance) {
+      let best = null;
+      let bestDistance = maxDistance ** 2;
+      let bestArea = 0;
+      for (const el of root.querySelectorAll(MEDIA)) {
+        if (!isPageImage(el)) {
