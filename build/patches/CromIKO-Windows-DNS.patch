+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+/**
+ * @fileoverview 'cromiko-dns-orbit' is the animated picture of CromIKO DNS, as
+ * on the CromIKO DNS screen of Android (CromikoDnsOrbitView.java): the DNS icon
+ * glows in the middle of orbits like the ring of the CromIKO mascot, queries go
+ * round them and stars of the logo twinkle. Off, it is gray and still. While
+ * the provider is tested, waves go out of the middle, which then flashes with
+ * the result. With "reduce motion" in the system, it stands still.
+ *
+ * The colors come from CSS, so they follow the theme and the accent color:
+ * --cromiko-dns-on (on), --cromiko-dns-off (off), --cromiko-dns-on-icon and
+ * --cromiko-dns-off-icon (the icon in the middle) and --cromiko-dns-error (a
+ * failed test).
+ */
+
+// The orbits: width and height (in px), tilt (in degrees) and the time of a
+// turn of a query (in ms).
+const ORBITS: Array<[number, number, number, number]> = [
+  [150, 52, -18, 5200],
+  [200, 70, 24, 7300],
+  [250, 88, -62, 9800],
+];
+// The stars: position (fraction of the width and height) and size (in px).
+const STARS: Array<[number, number, number]> = [
+  [0.16, 0.24, 9],
+  [0.84, 0.20, 12],
+  [0.10, 0.74, 7],
+  [0.88, 0.78, 8],
+  [0.70, 0.08, 6],
+];
+const TRAIL = 6;
+const SWITCH_MS = 700;
+const FLASH_MS = 900;
+
+// The DNS icon of CromIKO in a 24x24 box (the "dns" icon of
+// tools/cromiko/gen_feature_icons.py): the servers, filled even-odd, and the
+// star of the logo.
+const DNS_ICON_SERVERS =
+    'M5.1,4 H13.4 A2.6,2.6 0 0 1 16,6.6 V8.4 A2.6,2.6 0 0 1 13.4,11 ' +
+    'H5.1 A2.6,2.6 0 0 1 2.5,8.4 V6.6 A2.6,2.6 0 0 1 5.1,4Z' +
+    'M5.1,13 H18.9 A2.6,2.6 0 0 1 21.5,15.6 V17.9 A2.6,2.6 0 0 1 ' +
+    '18.9,20.5 H5.1 A2.6,2.6 0 0 1 2.5,17.9 V15.6 A2.6,2.6 0 0 1 5.1,13Z' +
+    'M4.9,7.5 A1.3,1.3 0 1 0 7.5,7.5 A1.3,1.3 0 1 0 4.9,7.5Z' +
+    'M4.9,16.75 A1.3,1.3 0 1 0 7.5,16.75 A1.3,1.3 0 1 0 4.9,16.75Z' +
+    'M9.7,6.8 H12.9 A0.7,0.7 0 0 1 13.6,7.5 V7.5 A0.7,0.7 0 0 1 ' +
+    '12.9,8.2 H9.7 A0.7,0.7 0 0 1 9,7.5 V7.5 A0.7,0.7 0 0 1 9.7,6.8Z' +
+    'M9.7,16.05 H17.7 A0.7,0.7 0 0 1 18.4,16.75 V16.75 A0.7,0.7 0 0 1 ' +
+    '17.7,17.45 H9.7 A0.7,0.7 0 0 1 9,16.75 V16.75 A0.7,0.7 0 0 1 ' +
+    '9.7,16.05Z';
+const DNS_ICON_STAR =
+    'M19.94,2.48C20.06,2.60 20.48,3.86 20.65,4.13C21.08,4.85 22.25,5.15 ' +
+    '23.00,5.35C20.90,5.96 20.57,6.24 19.98,8.32C19.18,6.16 19.27,5.97 ' +
+    '16.90,5.37C18.98,4.72 19.31,4.58 19.94,2.48Z';
+
+type Rgb = [number, number, number];
+
+export class CromikoDnsOrbitElement extends HTMLElement {
+  private canvas_: HTMLCanvasElement;
+  private context_: CanvasRenderingContext2D|null;
+  private servers_ = new Path2D(DNS_ICON_SERVERS);
+  private star_ = new Path2D(DNS_ICON_STAR);
+  private reducedMotion_ = window.matchMedia('(prefers-reduced-motion: reduce)');
+  private resizeObserver_ = new ResizeObserver(() => this.resize_());
+  private intersectionObserver_ = new IntersectionObserver(entries => {
+    this.visible_ = entries.some(entry => entry.isIntersecting);
+    this.update_();
+  });
+  private visible_ = false;
+  private frame_: number|null = null;
+  private start_ = performance.now();
+  // 1 when on, 0 when off, and the switch between them.
+  private on_ = false;
+  private switchFrom_ = 0;
+  private switchStart_ = -SWITCH_MS;
+  private testing_ = false;
+  private testStart_ = 0;
+  private resultOk_ = true;
+  private resultTime_ = -FLASH_MS;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({mode: 'open'});
+    root.innerHTML = '<style>:host{display:block}canvas{display:block;' +
+        'width:100%;height:100%}</style><canvas></canvas>';
+    this.canvas_ = root.querySelector('canvas')!;
+    this.context_ = this.canvas_.getContext('2d');
+  }
+
+  /** Whether CromIKO DNS is on. The picture lights up or goes gray. */
+  set on(on: boolean) {
+    if (on === this.on_) {
+      return;
+    }
+    const now = performance.now();
+    this.switchFrom_ = this.amountOn_(now);
+    this.switchStart_ = this.isConnected ? now : -SWITCH_MS;
+    this.on_ = on;
+    this.update_();
+  }
+
+  get on(): boolean {
+    return this.on_;
+  }
+
+  /** Whether the provider is tested: waves go out of the middle. */
+  set testing(testing: boolean) {
+    this.testing_ = testing;
+    this.testStart_ = performance.now();
+    this.update_();
+  }
+
+  get testing(): boolean {
+    return this.testing_;
+  }
+
+  /** Flashes the middle after a test: accent color if it worked, else red. */
+  showResult(ok: boolean) {
+    this.resultOk_ = ok;
+    this.resultTime_ = performance.now();
+    this.update_();
+  }
+
+  connectedCallback() {
+    this.start_ = performance.now();
+    this.resizeObserver_.observe(this);
+    this.intersectionObserver_.observe(this);
+    this.reducedMotion_.addEventListener('change', this.onMotionChanged_);
+    this.resize_();
+  }
+
+  disconnectedCallback() {
+    this.resizeObserver_.disconnect();
+    this.intersectionObserver_.disconnect();
+    this.reducedMotion_.removeEventListener('change', this.onMotionChanged_);
+    this.stop_();
+  }
+
+  private onMotionChanged_ = () => this.update_();
+
+  private resize_() {
+    const ratio = window.devicePixelRatio || 1;
+    const width = Math.round(this.clientWidth * ratio);
+    const height = Math.round(this.clientHeight * ratio);
+    if (width !== this.canvas_.width || height !== this.canvas_.height) {
+      this.canvas_.width = width;
+      this.canvas_.height = height;
+    }
+    this.draw_(performance.now());
+  }
+
+  // Runs the animation while the picture shows, is on and motion is allowed
+  // (and while it switches or flashes), and otherwise draws one still frame.
+  private update_() {
+    const now = performance.now();
+    const switching = now - this.switchStart_ < SWITCH_MS;
+    const flashing = now - this.resultTime_ < FLASH_MS;
+    const moving = !this.reducedMotion_.matches && (this.on_ || this.testing_);
+    const run = this.isConnected && this.visible_ &&
+        (moving || switching || flashing);
+    if (run && this.frame_ === null) {
+      this.frame_ = requestAnimationFrame(this.onFrame_);
+    } else if (!run) {
+      this.stop_();
+      this.draw_(now);
+    }
+  }
+
+  private stop_() {
+    if (this.frame_ !== null) {
+      cancelAnimationFrame(this.frame_);
+      this.frame_ = null;
+    }
+  }
+
+  private onFrame_ = (now: number) => {
+    this.frame_ = null;
+    this.draw_(now);
+    this.update_();
+  };
+
+  private amountOn_(now: number): number {
+    const target = this.on_ ? 1 : 0;
+    const progress = Math.min(1, (now - this.switchStart_) / SWITCH_MS);
+    // Decelerates, like the Android switch.
+    const eased = 1 - (1 - progress) * (1 - progress);
+    return this.switchFrom_ + (target - this.switchFrom_) * eased;
+  }
+
+  private color_(property: string, fallback: string): Rgb {
+    const value =
+        getComputedStyle(this).getPropertyValue(property).trim() || fallback;
+    const context = this.context_!;
+    // The canvas turns any CSS color into #rrggbb or rgba(...).
+    context.fillStyle = fallback;
+    context.fillStyle = value;
+    const color = context.fillStyle;
+    if (color.startsWith('#')) {
+      return [
+        parseInt(color.slice(1, 3), 16),
+        parseInt(color.slice(3, 5), 16),
+        parseInt(color.slice(5, 7), 16),
+      ];
+    }
+    const parts = color.match(/[\d.]+/g) || ['0', '0', '0'];
+    return [Number(parts[0]), Number(parts[1]), Number(parts[2])];
+  }
+
+  private draw_(now: number) {
+    const context = this.context_;
+    if (!context || !this.canvas_.width || !this.canvas_.height) {
+      return;
+    }
+    const ratio = window.devicePixelRatio || 1;
+    const width = this.canvas_.width / ratio;
+    const height = this.canvas_.height / ratio;
+    context.setTransform(ratio, 0, 0, ratio, 0, 0);
+    context.clearRect(0, 0, width, height);
+
+    const still = this.reducedMotion_.matches;
+    // Motion only when it is allowed: otherwise one still frame.
+    const t = still ? 0.35 : (now - this.start_) / 1000;
+    const on = this.amountOn_(now);
+    const accent = this.color_('--cromiko-dns-on', '#5c7cfc');
+    const off = this.color_('--cromiko-dns-off', '#6b7a90');
+    const blend = (from: Rgb, to: Rgb) =>
+        [0, 1, 2].map(i => from[i] + (to[i] - from[i]) * on) as Rgb;
+    const color = blend(off, accent);
+    const rgba = (c: Rgb, alpha: number) =>
+        `rgba(${Math.round(c[0])}, ${Math.round(c[1])}, ${Math.round(c[2])}, ${
+            Math.max(0, Math.min(1, alpha))})`;
+    const cx = width / 2;
+    const cy = height / 2;
+    // As big as fits (the orbits reach 112 px up and down and 93 px to the
+    // sides at full size), smaller while off, growing when CromIKO DNS turns
+    // on.
+    const scale = Math.min(1, (height / 2 - 6) / 112, (width / 2 - 6) / 93) *
+        (0.86 + 0.14 * on);
+
+    // The glow behind the middle.
+    const pulse = 0.5 + 0.5 * Math.sin(t * 2.2);
+    context.fillStyle = rgba(color, ((24 + 20 * pulse) / 255) * on);
+    context.beginPath();
+    context.arc(cx, cy, (52 + 8 * pulse) * scale, 0, 2 * Math.PI);
+    context.fill();
+
+    // The orbits, with the queries going round them.
+    ORBITS.forEach(([orbitWidth, orbitHeight, tilt, turnMs], i) => {
+      const rx = orbitWidth / 2 * scale;
+      const ry = orbitHeight / 2 * scale;
+      context.save();
+      context.translate(cx, cy);
+      context.rotate(tilt * Math.PI / 180);
+      context.strokeStyle = rgba(color, (0.18 + 0.22 * on) * (1 - i * 0.18));
+      context.lineWidth = 2;
+      context.beginPath();
+      context.ellipse(0, 0, rx, ry, 0, 0, 2 * Math.PI);
+      context.stroke();
+      if (on > 0) {
+        const angle = 2 * Math.PI * (t * 1000 / turnMs + i * 0.37);
+        for (let k = TRAIL; k >= 0; k--) {
+          const a = angle - k * 0.12;
+          context.fillStyle = rgba(color, on * (1 - k / (TRAIL + 1)));
+          context.beginPath();
+          context.arc(
+              rx * Math.cos(a), ry * Math.sin(a), k === 0 ? 4.5 : 3.2 - k * 0.3,
+              0, 2 * Math.PI);
+          context.fill();
+        }
+      }
+      context.restore();
+    });
+
+    // Waves while the provider is tested.
+    if (this.testing_) {
+      const since = (now - this.testStart_) / 1000;
+      for (let k = 0; k < 3; k++) {
+        const phase = (since + k / 3) % 1;
+        context.strokeStyle = rgba(accent, (200 / 255) * (1 - phase));
+        context.lineWidth = 3;
+        context.beginPath();
+        context.arc(cx, cy, (40 + 90 * phase) * scale, 0, 2 * Math.PI);
+        context.stroke();
+      }
+    }
+
+    // The middle, with the DNS icon, and the flash of the last test.
+    const radius = 36 * scale;
+    context.fillStyle = rgba(color, 1);
+    context.beginPath();
+    context.arc(cx, cy, radius, 0, 2 * Math.PI);
+    context.fill();
+    const flash = 1 - Math.min(1, (now - this.resultTime_) / FLASH_MS);
+    if (flash > 0) {
+      const result = this.resultOk_ ?
+          accent :
+          this.color_('--cromiko-dns-error', '#d93025');
+      context.strokeStyle = rgba(result, flash);
+      context.lineWidth = 5;
+      context.beginPath();
+      context.arc(cx, cy, radius + (1 - flash) * 18, 0, 2 * Math.PI);
+      context.stroke();
+    }
+    const iconColor = blend(
+        this.color_('--cromiko-dns-off-icon', '#ffffff'),
+        this.color_('--cromiko-dns-on-icon', '#ffffff'));
+    const iconSize = 36 * scale;
+    context.save();
+    context.translate(cx - iconSize / 2, cy - iconSize / 2);
+    context.scale(iconSize / 24, iconSize / 24);
+    context.fillStyle = rgba(iconColor, 1);
+    context.fill(this.servers_, 'evenodd');
+    context.fill(this.star_);
+    context.restore();
+
+    // The stars of the logo, twinkling.
+    STARS.forEach(([x, y, size], i) => {
+      const twinkle = 0.5 + 0.5 * Math.sin(t * 1.7 + i * 1.3);
+      const r = size * (0.6 + 0.4 * twinkle) * (0.5 + 0.5 * on);
+      context.fillStyle =
+          rgba(color, (0.25 + 0.75 * on) * (0.35 + 0.65 * twinkle));
+      this.drawStar_(context, x * width, y * height, r);
+    });
+  }
+
+  // A star with four points, like the one of the CromIKO logo.
+  private drawStar_(
+      context: CanvasRenderingContext2D, x: number, y: number, r: number) {
