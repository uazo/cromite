+// CromIKO: what a provider of CromIKO DNS filters, from its DoH template, as
+// on the CromIKO DNS screen of Android (CromikoDnsProviders.java). The order is
+// the one of the list.
+enum class CromikoDnsFilter { kAds, kFamily, kMalware, kNone };
+
+// The DoH template of the provider that CromIKO uses by default.
+constexpr char kCromikoRecommendedDns[] = "https://dns.quad9.net/dns-query";
+
+CromikoDnsFilter GetCromikoDnsFilter(std::string_view config) {
+  const std::string doh_template = base::ToLowerASCII(config);
+  auto has = [&doh_template](std::string_view part) {
+    return doh_template.find(part) != std::string::npos;
+  };
+  if (has("family") || has("//clean.")) {
+    return CromikoDnsFilter::kFamily;
+  }
+  if (has("unfiltered") || has("//blank.")) {
+    return CromikoDnsFilter::kNone;
+  }
+  if (has("adblock") || has("//dns.adguard-dns.com") || has("//dnsforge.de")) {
+    return CromikoDnsFilter::kAds;
+  }
+  if (has("quad9") || has("protective") || has("security") ||
+      has("opendns")) {
+    return CromikoDnsFilter::kMalware;
+  }
+  return CromikoDnsFilter::kNone;
+}
+
+int GetCromikoDnsFilterName(CromikoDnsFilter filter) {
+  switch (filter) {
+    case CromikoDnsFilter::kAds:
+      return IDS_CROMIKO_SETTINGS_DNS_FILTER_ADS;
+    case CromikoDnsFilter::kFamily:
+      return IDS_CROMIKO_SETTINGS_DNS_FILTER_FAMILY;
+    case CromikoDnsFilter::kMalware:
+      return IDS_CROMIKO_SETTINGS_DNS_FILTER_MALWARE;
+    case CromikoDnsFilter::kNone:
+      break;
+  }
+  return IDS_CROMIKO_SETTINGS_DNS_FILTER_NONE;
+}
+
 base::DictValue CreateSecureDnsSettingDict(
     content::BrowserContext* browser_context) {
   // Fetch the current host resolver configuration. It is not sufficient to read
@@ -123,17 +173,47 @@ void SecureDnsHandler::OnJavascriptDisallowed() {
 }
 
 base::ListValue SecureDnsHandler::GetSecureDnsResolverList() {
-  base::ListValue resolvers;
+  // CromIKO: instead of a random order, Quad9 (the default) first, then the
+  // providers that block ads, the family filters, the ones that block malware
+  // and the unfiltered ones, each with what it filters after its name.
+  struct Provider {
+    bool recommended;
+    CromikoDnsFilter filter;
+    std::string name;
+    std::string value;
+    std::string policy;
+  };
+  std::vector<Provider> providers;
   for (const net::DohProviderEntry* entry : providers_) {
     net::DnsOverHttpsConfig doh_config({entry->doh_server_config});
+    std::string value = doh_config.ToString();
+    providers.push_back(
+        {value == kCromikoRecommendedDns, GetCromikoDnsFilter(value),
+         std::string(entry->ui_name_cromite.empty() ? entry->provider
+                                                    : entry->ui_name_cromite),
+         value, std::string(entry->privacy_policy)});
+  }
+  std::ranges::sort(providers, [](const Provider& a, const Provider& b) {
+    return std::make_tuple(!a.recommended, a.filter,
+                           base::ToLowerASCII(a.name)) <
+           std::make_tuple(!b.recommended, b.filter,
+                           base::ToLowerASCII(b.name));
+  });
+
+  base::ListValue resolvers;
+  for (const Provider& provider : providers) {
     base::DictValue dict;
-    dict.Set("name", entry->ui_name_cromite.empty() ? entry->provider : entry->ui_name_cromite);
-    dict.Set("value", doh_config.ToString());
-    dict.Set("policy", entry->privacy_policy);
+    dict.Set("name", l10n_util::GetStringFUTF8(
+                         provider.recommended
+                             ? IDS_CROMIKO_SETTINGS_DNS_PROVIDER_RECOMMENDED
+                             : IDS_CROMIKO_SETTINGS_DNS_PROVIDER,
+                         base::UTF8ToUTF16(provider.name),
+                         l10n_util::GetStringUTF16(
+                             GetCromikoDnsFilterName(provider.filter))));
+    dict.Set("value", provider.value);
+    dict.Set("policy", provider.policy);
     resolvers.Append(std::move(dict));
   }
-
-  base::RandomShuffle(resolvers.begin(), resolvers.end());
   return resolvers;
 }
 
