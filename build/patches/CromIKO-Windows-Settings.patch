+      Blocked this week: <ph name="BLOCKED">$1<ex>1,234</ex></ph>
+    </message>
+    <message name="IDS_CROMIKO_PAGE_PRIVACY" desc="Title of the group of the privacy features in the CromIKO section of the settings.">
+      Privacy
+    </message>
