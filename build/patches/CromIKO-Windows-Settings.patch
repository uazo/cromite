+/* Copyright 2026 The CromIKO Authors
+ * License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #css_wrapper_metadata_end */
+
+/* The styles of the CromIKO pages of the settings. */
+:host {
+  --cromiko-accent: var(--color-sys-primary, var(--cr-checked-color));
+  --cromiko-card: var(--cr-card-background-color, white);
+  --cromiko-tint: color-mix(in srgb, var(--cromiko-accent) 13%,
+      var(--cromiko-card));
+}
+
+/* The titles of the groups of rows. */
+.cromiko-group {
+  color: var(--cr-primary-text-color);
+  font-size: 13px;
+  font-weight: 500;
+  margin: 0;
+  padding: 20px var(--cr-section-padding) 6px;
+}
+
+/* A row with the icon of a CromIKO feature. */
+.cromiko-row {
+  align-items: center;
+  cursor: pointer;
+  display: flex;
+  min-height: 64px;
+  padding-inline-start: var(--cr-section-padding);
+}
+
+.cromiko-row cr-link-row {
+  flex: 1;
+  padding-inline-start: 0;
+}
+
+.cromiko-row > .cr-padded-text {
+  cursor: default;
+}
+
+.cromiko-row:has(cr-button) {
+  cursor: default;
+  padding-inline-end: var(--cr-section-padding);
+}
+
+.cromiko-icon {
+  align-items: center;
+  background: var(--cromiko-tint);
+  border-radius: 12px;
+  display: flex;
+  flex: none;
+  height: 40px;
+  justify-content: center;
+  margin-inline-end: 16px;
+  width: 40px;
+}
+
+.cromiko-icon svg {
+  height: 24px;
+  width: 24px;
+}
+
+/* The two colors of the icons of the logo: the ink, and the star in the
+   accent color. */
+.ink {
+  fill: var(--cr-primary-text-color);
+}
+
+.ink-stroke {
+  fill: none;
+  stroke: var(--cr-primary-text-color);
+}
+
+.star {
+  fill: var(--cromiko-accent);
+}
+
+.face {
+  fill: var(--cromiko-card);
+}
