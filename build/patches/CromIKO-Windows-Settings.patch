+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+#include "chrome/browser/ui/webui/settings/cromiko_handler.h"
+
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/values.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "components/subresource_filter/content/browser/cromiko_shield_stats.h"
+#include "content/public/browser/web_ui.h"
+
+namespace settings {
+
+namespace {
+
+// The report of cromiko_shield_stats::GetReport() for the page, with the keys
+// in camel case ("lastWeek").
+base::DictValue GetShieldReportForPage(Profile* profile) {
+  base::DictValue report =
+      subresource_filter::cromiko_shield_stats::GetReport(profile->GetPrefs());
+  if (std::optional<base::Value> last_week = report.Extract("last_week")) {
+    report.Set("lastWeek", std::move(*last_week));
+  }
+  return report;
+}
+
+}  // namespace
+
+CromikoHandler::CromikoHandler(Profile* profile) : profile_(profile) {}
+
+CromikoHandler::~CromikoHandler() = default;
+
+void CromikoHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getCromikoShieldReport",
+      base::BindRepeating(&CromikoHandler::HandleGetShieldReport,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "cromikoBurnTabsAndData",
+      base::BindRepeating(&CromikoHandler::HandleBurnTabsAndData,
+                          base::Unretained(this)));
+}
+
+void CromikoHandler::HandleGetShieldReport(const base::ListValue& args) {
+  AllowJavascript();
+  const base::Value& callback_id = args[0];
+  ResolveJavascriptCallback(callback_id, GetShieldReportForPage(profile_));
+}
+
+void CromikoHandler::HandleBurnTabsAndData(const base::ListValue& args) {
+  // Like "Customize Chrome" of the appearance settings: the window of the
+  // settings is the active one.
+  BrowserWindowInterface* browser =
+      GlobalBrowserCollection::GetInstance()->GetLastActiveBrowser();
+  if (!browser) {
+    return;
+  }
+  chrome::ExecuteCommand(browser, IDC_CROMIKO_BURN);
+}
+
+}  // namespace settings
