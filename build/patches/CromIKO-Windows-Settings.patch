@@ -0,0 +1,86 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+import 'chrome://resources/cr_elements/cr_view_manager/cr_view_manager.js';
+import './cromiko_page.js';
+import './cromiko_report_page.js';
+
+import type {CrViewManagerElement} from 'chrome://resources/cr_elements/cr_view_manager/cr_view_manager.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {routes} from '../route.js';
+import type {Route, SettingsRoutes} from '../router.js';
+import {RouteObserverMixinLit} from '../router.js';
+import type {SettingsPlugin} from '../settings_main/settings_plugin.js';
+import {SearchableViewContainerMixinLit} from '../settings_page/searchable_view_container_mixin_lit.js';
+
+import {getCss} from './cromiko_page_index.css.js';
+import {getHtml} from './cromiko_page_index.html.js';
+
+export interface SettingsCromikoPageIndexElement {
+  $: {
+    viewManager: CrViewManagerElement,
+  };
+}
+
+const SettingsCromikoPageIndexElementBase =
+    SearchableViewContainerMixinLit(RouteObserverMixinLit(CrLitElement));
+
+// CromIKO: the CromIKO section at the top of Settings, like the CromIKO
+// settings of the Android app: all CromIKO features in one place (the parent
+// view), and the weekly shield report (a child view).
+export class SettingsCromikoPageIndexElement extends
+    SettingsCromikoPageIndexElementBase implements SettingsPlugin {
+  static get is() {
+    return 'settings-cromiko-page-index';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      routes_: {type: Object},
+    };
+  }
+
+  protected accessor routes_: SettingsRoutes = routes;
+
+  override currentRouteChanged(newRoute: Route, oldRoute?: Route) {
+    super.currentRouteChanged(newRoute, oldRoute);
+
+    // Need to wait for currentRouteChanged observers on child views to run
+    // first, before switching views.
+    queueMicrotask(() => {
+      switch (newRoute) {
+        case routes.CROMIKO_REPORT:
+          this.$.viewManager.switchView(
+              'report', 'no-animation', 'no-animation');
+          break;
+        case routes.CROMIKO:
+        case routes.BASIC:
+          this.$.viewManager.switchView(
+              'parent', 'no-animation', 'no-animation');
+          break;
+        default:
+          // Nothing to do. Other parent elements are responsible for updating
+          // the displayed contents.
+          break;
+      }
+    });
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-cromiko-page-index': SettingsCromikoPageIndexElement;
+  }
+}
+
+customElements.define(
+    SettingsCromikoPageIndexElement.is, SettingsCromikoPageIndexElement);
diff --git a/chrome/browser/resources/settings/cromiko_page/cromiko_report_page.css b/chrome/browser/resources/settings/cromiko_page/cromiko_report_page.css
new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/settings/cromiko_page/cromiko_report_page.css
@@ -0,0 +1,193 @@
+/* Copyright 2026 The CromIKO Authors
+ * License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #import=../settings_shared_lit.css.js
+ * #import=./cromiko_shared.css.js
+ * #include=settings-shared-lit cromiko-shared
+ * #css_wrapper_metadata_end */
+
+/* The top of the report: the count of the week and the chart of the days, on
+   a card tinted with the accent color. */
+#summary {
+  background: linear-gradient(160deg,
+      color-mix(in srgb, var(--cromiko-accent) 16%, var(--cromiko-card)),
+      color-mix(in srgb, var(--cromiko-accent) 4%, var(--cromiko-card)));
+  border-radius: 20px;
+  margin: 8px var(--cr-section-padding) 4px;
+  padding: 20px 22px 16px;
+}
+
+#summaryTop {
+  align-items: center;
+  display: flex;
+  gap: 16px;
+}
+
+#shield {
+  align-items: center;
+  background: var(--cromiko-card);
+  border-radius: 18px;
+  display: flex;
+  flex: none;
+  height: 56px;
+  justify-content: center;
+  width: 56px;
+}
+
+#shield svg {
+  height: 34px;
+  width: 34px;
+}
+
+#count {
+  color: var(--cr-primary-text-color);
+  font-size: 34px;
+  font-variant-numeric: tabular-nums;
+  font-weight: 500;
+  letter-spacing: -0.5px;
+  line-height: 40px;
+}
+
+#comparison {
+  background: color-mix(in srgb, var(--cromiko-accent) 14%, transparent);
+  border-radius: 12px;
+  color: var(--cr-primary-text-color);
+  display: inline-block;
+  font-weight: 500;
+  margin-top: 14px;
+  padding: 4px 12px;
+}
+
+#lastWeek {
+  margin-top: 8px;
+}
+
+/* The chart of the week, from Monday to Sunday, today in the accent color. */
+#chart {
+  align-items: flex-end;
+  display: flex;
+  gap: 8px;
+  margin-top: 18px;
+}
+
+.day {
+  align-items: center;
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: 6px;
+  min-width: 0;
+}
+
+.day-count {
+  color: var(--cr-secondary-text-color);
+  font-size: 11px;
+  font-variant-numeric: tabular-nums;
+  line-height: 14px;
+  min-height: 14px;
+}
+
+.track {
+  align-items: flex-end;
+  display: flex;
+  height: 96px;
+  justify-content: center;
+  width: 100%;
+}
+
+.bar {
+  background: color-mix(in srgb, var(--cromiko-accent) 38%, transparent);
+  border-radius: 8px 8px 4px 4px;
+  height: max(6px, calc(var(--height) * 96px));
+  max-width: 40px;
+  transition: height 400ms ease-out;
+  width: 100%;
+}
+
+.day[today] .bar {
+  background: var(--cromiko-accent);
+}
+
+.day[today] .day-count,
+.day[today] .day-name {
+  color: var(--cromiko-accent);
+  font-weight: 700;
+}
+
+.day[future] .bar {
+  background: color-mix(in srgb, var(--cr-secondary-text-color) 18%,
+      transparent);
+  height: 6px;
+}
+
+.day-name {
+  color: var(--cr-secondary-text-color);
+  font-size: 12px;
+  line-height: 16px;
+}
+
+/* The sites and trackers, with a bar for their part of the first one. */
+.entry {
+  align-items: center;
+  display: flex;
+  gap: 16px;
+  min-height: 56px;
+  padding: 0 var(--cr-section-padding);
+}
+
+.entry site-favicon {
+  flex: none;
+}
+
+.tracker-icon {
+  align-items: center;
+  background: var(--cromiko-tint);
+  border-radius: 50%;
+  display: flex;
+  flex: none;
+  height: 24px;
+  justify-content: center;
+  width: 24px;
+}
+
+.tracker-icon svg {
+  height: 16px;
+  width: 16px;
+}
+
+.domain {
+  color: var(--cr-primary-text-color);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.share {
+  background: color-mix(in srgb, var(--cromiko-accent) 10%, transparent);
+  border-radius: 3px;
+  height: 6px;
+  margin-top: 6px;
+  overflow: hidden;
+}
+
+.share-bar {
+  background: color-mix(in srgb, var(--cromiko-accent) 70%, transparent);
+  border-radius: 3px;
+  height: 100%;
+  width: calc(var(--share) * 100%);
+}
+
+/* Wide enough for most counts, so that the bars end at the same place. */
+.entry-count {
+  color: var(--cr-secondary-text-color);
+  flex: none;
+  font-variant-numeric: tabular-nums;
+  min-width: 96px;
+  text-align: end;
+}
+
+#note {
+  padding: 16px var(--cr-section-padding) 8px;
+}
