+// CromIKO: the CromIKO section and its weekly shield report.
+void AddCromikoStrings(content::WebUIDataSource* html_source) {
+  static constexpr webui::LocalizedString kLocalizedStrings[] = {
+      {"cromikoPageTitle", IDS_CROMIKO_PAGE_TITLE},
+      {"cromikoPageHeader", IDS_CROMIKO_PAGE_HEADER},
+      {"cromikoPageHeaderDetail", IDS_CROMIKO_PAGE_HEADER_DETAIL},
+      {"cromikoPageProtection", IDS_CROMIKO_PAGE_PROTECTION},
+      {"cromikoPagePopupGuard", IDS_CROMIKO_PAGE_POPUP_GUARD},
+      {"cromikoPagePopupGuardDetail", IDS_CROMIKO_PAGE_POPUP_GUARD_DETAIL},
+      {"cromikoPageAdblock", IDS_CROMIKO_PAGE_ADBLOCK},
+      {"cromikoPageAdblockDetail", IDS_CROMIKO_PAGE_ADBLOCK_DETAIL},
+      {"cromikoPageReportDetail", IDS_CROMIKO_PAGE_REPORT_DETAIL},
+      {"cromikoPagePrivacy", IDS_CROMIKO_PAGE_PRIVACY},
+      {"cromikoPageFire", IDS_CROMIKO_PAGE_FIRE},
+      {"cromikoPageFireDetail", IDS_CROMIKO_PAGE_FIRE_DETAIL},
+      {"cromikoPageFireButton", IDS_CROMIKO_BURN_MENU},
+      {"cromikoPageLook", IDS_CROMIKO_PAGE_LOOK},
+      {"cromikoPageColors", IDS_CROMIKO_PAGE_COLORS},
+      {"cromikoPageColorsDetail", IDS_CROMIKO_PAGE_COLORS_DETAIL},
+      {"cromikoPageNewTabPage", IDS_CROMIKO_PAGE_NEW_TAB_PAGE},
+      {"cromikoPageNewTabPageDetail", IDS_CROMIKO_PAGE_NEW_TAB_PAGE_DETAIL},
+      {"cromikoPageDownloads", IDS_CROMIKO_PAGE_DOWNLOADS},
+      {"cromikoPageDownloadsDetail", IDS_CROMIKO_PAGE_DOWNLOADS_DETAIL},
+      {"cromikoReportTitle", IDS_CROMIKO_REPORT_TITLE},
+      {"cromikoReportLabel", IDS_CROMIKO_NTP_SHIELD_LABEL},
