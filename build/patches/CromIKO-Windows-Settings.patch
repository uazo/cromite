+++ b/chrome/browser/resources/settings/cromiko_page/cromiko_page.ts
@@ -0,0 +1,138 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_link_row/cr_link_row.js';
+import '../settings_page/settings_section.js';
+
+import {PrefServiceObserverMixinLit} from '/shared/settings/prefs2/pref_service_observer_mixin_lit.js';
+import {assert} from 'chrome://resources/js/assert.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {AppearanceBrowserProxyImpl} from '../appearance_page/appearance_browser_proxy.js';
+import {loadTimeData} from '../i18n_setup.js';
+import {routes} from '../route.js';
+import {Router} from '../router.js';
+import {SettingsViewMixinLit} from '../settings_page/settings_view_mixin_lit.js';
+
+import type {CromikoBrowserProxy} from './cromiko_browser_proxy.js';
+import {CromikoBrowserProxyImpl} from './cromiko_browser_proxy.js';
+import {getCss} from './cromiko_page.css.js';
+import {getHtml} from './cromiko_page.html.js';
+
+// The text under CromIKO DNS for a mode of the secure DNS pref.
+export function getDnsStatus(mode: string|undefined): string {
+  switch (mode) {
+    case 'secure':
+      return loadTimeData.getString('cromikoDnsStatusOn');
+    case 'automatic':
+      return loadTimeData.getString('cromikoDnsStatusAutomatic');
+    default:
+      return loadTimeData.getString('cromikoDnsStatusOff');
+  }
+}
+
+const SettingsCromikoPageElementBase =
+    SettingsViewMixinLit(PrefServiceObserverMixinLit(CrLitElement));
+
+// CromIKO: all CromIKO features in one place, with the icons of the logo, like
+// the CromIKO settings of the Android app. The settings stay where Chromium
+// has them too: the rows open them.
+export class SettingsCromikoPageElement extends SettingsCromikoPageElementBase {
+  static get is() {
+    return 'settings-cromiko-page';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      dnsModePref_: {type: Object},
+      reportSummary_: {type: String},
+    };
+  }
+
+  protected accessor dnsModePref_:
+      chrome.settingsPrivate.PrefObject<string>|undefined = undefined;
+  protected accessor reportSummary_: string = '';
+
+  private browserProxy_: CromikoBrowserProxy =
+      CromikoBrowserProxyImpl.getInstance();
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.mirrorPref('dns_over_https.mode', 'dnsModePref_');
+    this.browserProxy_.getShieldReport().then(report => {
+      this.reportSummary_ = loadTimeData.getStringF(
+          'cromikoPageReportDetail',
+          new Intl.NumberFormat(document.documentElement.lang || undefined)
+              .format(report.blocked));
+    });
+  }
+
+  protected getDnsStatus_(mode: string|undefined): string {
+    return getDnsStatus(mode);
+  }
+
+  protected onDnsClick_() {
+    Router.getInstance().navigateTo(
+        routes.SECURITY, new URLSearchParams('q=dns'));
+  }
+
+  protected onPopupGuardClick_() {
+    Router.getInstance().navigateTo(routes.SITE_SETTINGS_POPUPS);
+  }
+
+  protected onAdblockClick_() {
+    Router.getInstance().navigateTo(routes.ADBLOCK);
+  }
+
+  protected onReportClick_() {
+    Router.getInstance().navigateTo(routes.CROMIKO_REPORT);
+  }
+
+  protected onBurnClick_() {
+    this.browserProxy_.burnTabsAndData();
+  }
+
+  // The accent colors and the new tab page are in Customize CromIKO.
+  protected onCustomizeClick_() {
+    AppearanceBrowserProxyImpl.getInstance().openCustomizeChrome();
+  }
+
+  protected onDownloadsClick_() {
+    Router.getInstance().navigateTo(routes.DOWNLOADS);
+  }
+
+  // SettingsViewMixin implementation.
+  override getFocusConfig() {
+    const map = new Map();
+    if (routes.CROMIKO_REPORT) {
+      map.set(routes.CROMIKO_REPORT.path, '#report');
+    }
+    return map;
+  }
+
+  // SettingsViewMixin implementation.
+  override getAssociatedControlFor(childViewId: string): HTMLElement {
+    assert(childViewId === 'report');
+    const control = this.shadowRoot.querySelector<HTMLElement>('#report');
+    assert(control);
+    return control;
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-cromiko-page': SettingsCromikoPageElement;
+  }
+}
+
+customElements.define(
+    SettingsCromikoPageElement.is, SettingsCromikoPageElement);
