@@ -0,0 +1,57 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+// The counts of a week of the shield report, by registrable domain.
+export type CromikoShieldCounts = Record<string, number>;
+
+// The week before, kept when a new week starts.
+export interface CromikoShieldLastWeek {
+  week: number;
+  blocked: number;
+  held: number;
+  sites?: CromikoShieldCounts;
+  trackers?: CromikoShieldCounts;
+}
+
+// The weekly shield report of cromiko_shield_stats.cc. Days are day numbers
+// (days since 1970-01-01, local time); week is the one of this Monday.
+export interface CromikoShieldReport {
+  today: number;
+  week: number;
+  blocked: number;
+  held: number;
+  // The counts of the last 14 days, by day number.
+  days: CromikoShieldCounts;
+  sites: CromikoShieldCounts;
+  trackers: CromikoShieldCounts;
+  lastWeek?: CromikoShieldLastWeek;
+}
+
+export interface CromikoBrowserProxy {
+  getShieldReport(): Promise<CromikoShieldReport>;
+
+  // Opens the dialog of the Fire button in the window of the settings.
+  burnTabsAndData(): void;
+}
+
+export class CromikoBrowserProxyImpl implements CromikoBrowserProxy {
+  getShieldReport() {
+    return sendWithPromise<CromikoShieldReport>('getCromikoShieldReport');
+  }
+
+  burnTabsAndData() {
+    chrome.send('cromikoBurnTabsAndData');
+  }
+
+  static getInstance(): CromikoBrowserProxy {
+    return instance || (instance = new CromikoBrowserProxyImpl());
+  }
+
+  static setInstance(obj: CromikoBrowserProxy) {
+    instance = obj;
+  }
+}
+
+let instance: CromikoBrowserProxy|null = null;
