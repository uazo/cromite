+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SETTINGS_CROMIKO_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SETTINGS_CROMIKO_HANDLER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/values.h"
+#include "chrome/browser/ui/webui/settings/settings_page_ui_handler.h"
+
+class Profile;
+
+namespace settings {
+
+// CromIKO: the handler of the CromIKO section of the settings: the weekly
+// shield report, and the Fire button.
+class CromikoHandler : public SettingsPageUIHandler {
+ public:
+  explicit CromikoHandler(Profile* profile);
+
+  CromikoHandler(const CromikoHandler&) = delete;
+  CromikoHandler& operator=(const CromikoHandler&) = delete;
+
+  ~CromikoHandler() override;
+
+  // SettingsPageUIHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override {}
+  void OnJavascriptDisallowed() override {}
+
+ private:
+  // Callback for the "getCromikoShieldReport" message.
+  void HandleGetShieldReport(const base::ListValue& args);
+
+  // Callback for the "cromikoBurnTabsAndData" message: the Fire button.
+  void HandleBurnTabsAndData(const base::ListValue& args);
+
+  raw_ptr<Profile> profile_;
+};
+
+}  // namespace settings
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SETTINGS_CROMIKO_HANDLER_H_
