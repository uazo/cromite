+// The sites and trackers listed.
+const TOP = 5;
+// Changes smaller than this are "about the same".
+const SAME = 0.05;
+
+// A day of the chart, from Monday to Sunday.
+export interface CromikoReportDay {
+  name: string;
+  // The count of the day, short ("1.2K"), and its description for screen
+  // readers.
+  count: string;
+  description: string;
+  // The count as a part of the highest count of the week.
+  height: number;
+  isToday: boolean;
+  isFuture: boolean;
+}
+
+// A site or tracker of the lists.
+export interface CromikoReportEntry {
+  domain: string;
+  count: string;
+  // The count as a part of the first one of the list.
+  share: number;
+}
+
+export interface CromikoReportView {
+  count: string;
+  // How it compares with the same days of last week, and whether it is more.
+  comparison: string;
+  more: boolean;
+  lastWeek: string;
+  days: CromikoReportDay[];
+  sitesTitle: string;
+  sites: CromikoReportEntry[];
+  trackersTitle: string;
+  trackers: CromikoReportEntry[];
+}
+
+// Returns the keys of `counts` with the largest counts, the largest first.
+export function getTop(counts: CromikoShieldCounts, max: number): string[] {
+  return Object.keys(counts)
+      .sort((a, b) => (counts[b] - counts[a]) || (a < b ? -1 : a > b ? 1 : 0))
+      .slice(0, max);
+}
+
+// What the report page shows for `report`, in the language `lang`, like the
+// weekly shield report of the Android app (CromikoShieldReport.java).
+export function getReportView(
+    report: CromikoShieldReport, lang: string): CromikoReportView {
+  const locale = lang || undefined;
+  const number = new Intl.NumberFormat(locale);
+  const short = new Intl.NumberFormat(
+      locale, {notation: 'compact', maximumFractionDigits: 1});
+  const dayName = new Intl.DateTimeFormat(
+      locale, {weekday: 'short', timeZone: 'UTC'});
+  const dayLongName = new Intl.DateTimeFormat(
+      locale, {weekday: 'long', timeZone: 'UTC'});
+  const days = report.days || {};
+
+  // The days of this week and of last week, and the sums of the days before
+  // today, which are complete, to compare the same days.
+  const thisWeek: number[] = [];
+  let thisWeekDays = 0;
+  let lastWeekDays = 0;
+  let thisWeekBeforeToday = 0;
+  let lastWeekBeforeToday = 0;
+  for (let i = 0; i < 7; i++) {
+    const count = days[String(report.week + i)] || 0;
+    const lastWeekCount = days[String(report.week - 7 + i)] || 0;
+    thisWeek.push(count);
+    thisWeekDays += count;
+    lastWeekDays += lastWeekCount;
+    if (report.week + i < report.today) {
+      thisWeekBeforeToday += count;
+      lastWeekBeforeToday += lastWeekCount;
+    }
+  }
+
+  let comparison = '';
+  let more = false;
+  let lastWeekText = '';
+  const lastWeek = report.lastWeek;
+  if (lastWeek) {
+    lastWeekText = loadTimeData.getStringF(
+        'cromikoReportLastWeek', number.format(lastWeek.blocked));
+    // Only when the days of both weeks are all there: older versions only
+    // kept the totals.
+    if (thisWeekDays === report.blocked && lastWeekDays === lastWeek.blocked &&
+        lastWeekBeforeToday > 0) {
+      const change =
+          (thisWeekBeforeToday - lastWeekBeforeToday) / lastWeekBeforeToday;
+      more = change > 0;
+      if (Math.abs(change) < SAME) {
+        comparison = loadTimeData.getString('cromikoReportSame');
+      } else {
+        comparison = loadTimeData.getStringF(
+            more ? 'cromikoReportMore' : 'cromikoReportFewer',
+            new Intl.NumberFormat(locale, {style: 'percent'})
+                .format(Math.abs(change)));
+      }
+    }
+  }
+
+  const highest = Math.max(1, ...thisWeek);
+  const chart = thisWeek.map((count, i) => {
+    // 2024-01-01 was a Monday.
+    const date = new Date(Date.UTC(2024, 0, 1 + i));
+    const isFuture = report.week + i > report.today;
+    return {
+      name: dayName.format(date),
+      count: isFuture ? '' : short.format(count),
+      description: loadTimeData.getStringF(
+          'cromikoReportChartDay', dayLongName.format(date),
+          number.format(count)),
+      height: count / highest,
+      isToday: report.week + i === report.today,
+      isFuture,
+    };
+  });
+
+  // Early in the week, the lists of last week say more.
+  let sites = report.sites || {};
+  let trackers = report.trackers || {};
+  const showLastWeek = Object.keys(sites).length === 0 && !!lastWeek;
+  if (showLastWeek) {
+    sites = lastWeek.sites || {};
+    trackers = lastWeek.trackers || {};
+  }
+  const entries = (counts: CromikoShieldCounts) => {
+    const top = getTop(counts, TOP);
+    const first = top.length ? counts[top[0]] : 1;
+    return top.map(domain => ({
+                     domain,
+                     count: loadTimeData.getStringF(
+                         'cromikoReportBlocked', number.format(counts[domain])),
+                     share: counts[domain] / first,
+                   }));
+  };
+
+  return {
+    count: number.format(report.blocked),
+    comparison,
+    more,
+    lastWeek: lastWeekText,
+    days: chart,
+    sitesTitle: loadTimeData.getString(
+        showLastWeek ? 'cromikoReportSitesLastWeek' : 'cromikoReportSites'),
+    sites: entries(sites),
+    trackersTitle: loadTimeData.getString(
+        showLastWeek ? 'cromikoReportTrackersLastWeek' :
+                       'cromikoReportTrackers'),
+    trackers: entries(trackers),
+  };
+}
+
+const SettingsCromikoReportPageElementBase = SettingsViewMixinLit(CrLitElement);
+
+// CromIKO: the weekly shield report, opened from the CromIKO page and the
+// shield card of the new tab page: the ads and trackers blocked this week, day
+// by day and compared with last week, the sites where CromIKO blocked the most
+// and the trackers it blocked the most. The counts come from
+// components/subresource_filter/content/browser/cromiko_shield_stats.cc.
+export class SettingsCromikoReportPageElement extends
+    SettingsCromikoReportPageElementBase {
+  static get is() {
+    return 'settings-cromiko-report-page';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      view_: {type: Object},
+    };
+  }
+
+  protected accessor view_: CromikoReportView|null = null;
+
+  private browserProxy_: CromikoBrowserProxy =
+      CromikoBrowserProxyImpl.getInstance();
+
+  override currentRouteChanged(newRoute: Route, oldRoute?: Route) {
+    super.currentRouteChanged(newRoute, oldRoute);
+    // The counts change while browsing: read them each time the page opens.
+    if (newRoute === routes.CROMIKO_REPORT) {
+      this.browserProxy_.getShieldReport().then(report => {
+        this.view_ = getReportView(report, document.documentElement.lang);
+      });
+    }
+  }
+
+  protected onAdblockClick_() {
+    Router.getInstance().navigateTo(routes.ADBLOCK);
+  }
+
+  override focusBackButton() {
+    this.shadowRoot.querySelector('settings-subpage')!.focusBackButton();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-cromiko-report-page': SettingsCromikoReportPageElement;
+  }
+}
+
+customElements.define(
+    SettingsCromikoReportPageElement.is, SettingsCromikoReportPageElement);
