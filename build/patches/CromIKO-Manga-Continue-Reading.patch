+/**
+ * CromIKO: the "Continue reading" row on the new tab page, with the series that the user read in
+ * manga mode (CromikoMangaReading). A tap opens the chapter where the user stopped, or the next one
+ * if they finished it; a long press offers to remove the series.
+ */
+@NullMarked
+public class CromikoContinueReadingView extends LinearLayout {
+    private @Nullable NativePageHost mHost;
+    private @Nullable LinearLayout mItems;
+    // The entries shown, to rebuild the row only when they change.
+    private String mShown = "";
+
+    /** Constructor for inflating from XML. */
+    public CromikoContinueReadingView(Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+    }
+
+    /** Sets the new tab page that opens the chapters, or null to hide the row. */
+    public void setNativePageHost(@Nullable NativePageHost host) {
+        mHost = host;
+        update();
+    }
+
+    @Override
+    protected void onFinishInflate() {
+        super.onFinishInflate();
+        mItems = findViewById(R.id.cromiko_continue_reading_items);
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        update();
+    }
+
+    @Override
+    protected void onWindowVisibilityChanged(int visibility) {
+        super.onWindowVisibilityChanged(visibility);
+        if (visibility == VISIBLE) update();
+    }
+
+    private void update() {
+        List<Entry> entries =
+                mHost != null ? CromikoMangaReading.getEntries() : Collections.emptyList();
+        StringBuilder shown = new StringBuilder();
+        for (Entry entry : entries) {
+            shown.append(entry.key)
+                    .append(' ')
+                    .append(entry.url)
+                    .append(' ')
+                    .append(entry.progress)
+                    .append(' ')
+                    .append(entry.hasCover())
+                    .append('\n');
+        }
+        setVisibility(entries.isEmpty() ? GONE : VISIBLE);
+        if (mItems == null || shown.toString().equals(mShown)) return;
+        mShown = shown.toString();
+        mItems.removeAllViews();
+        LayoutInflater inflater = LayoutInflater.from(getContext());
+        for (Entry entry : entries) {
+            View item = inflater.inflate(R.layout.cromiko_continue_reading_item, mItems, false);
+            bind(item, entry);
+            mItems.addView(item);
+        }
+    }
+
+    private void bind(View item, Entry entry) {
+        Context context = getContext();
+        TextView series = item.findViewById(R.id.cromiko_continue_reading_series);
+        series.setText(entry.series.isEmpty() ? hostOf(entry.url) : entry.series);
+        TextView chapter = item.findViewById(R.id.cromiko_continue_reading_chapter);
+        boolean showNext = entry.isRead() && !entry.next.isEmpty();
+        String chapterText;
+        if (showNext) {
+            chapterText = context.getString(R.string.cromiko_continue_reading_next);
+        } else if (!entry.chapter.isEmpty()) {
+            chapterText =
+                    context.getString(R.string.cromiko_continue_reading_chapter, entry.chapter);
+        } else {
+            chapterText = hostOf(entry.url);
+        }
+        chapter.setText(chapterText);
+        ProgressBar progress = item.findViewById(R.id.cromiko_continue_reading_progress);
+        progress.setProgress(showNext ? 0 : (int) Math.round(entry.progress * 100));
+        item.setContentDescription(series.getText() + ", " + chapterText);
+
+        item.setOnClickListener(
+                view -> {
+                    if (mHost == null) return;
+                    mHost.loadUrl(
+                            new LoadUrlParams(entry.getContinueUrl(), PageTransition.AUTO_BOOKMARK),
+                            /* incognito= */ false);
+                });
+        item.setOnLongClickListener(
+                view -> {
+                    PopupMenu menu = new PopupMenu(context, view);
+                    menu.getMenu().add(R.string.cromiko_continue_reading_remove);
+                    menu.setOnMenuItemClickListener(
+                            menuItem -> {
+                                CromikoMangaReading.remove(entry.key);
+                                update();
+                                return true;
+                            });
+                    menu.show();
+                    return true;
+                });
+
+        ViewGroup frame = item.findViewById(R.id.cromiko_continue_reading_cover_frame);
+        frame.setClipToOutline(true);
+        ImageView cover = item.findViewById(R.id.cromiko_continue_reading_cover);
+        cover.setTag(entry.key);
+        if (!entry.hasCover()) return;
+        PostTask.postTask(
+                TaskTraits.USER_VISIBLE_MAY_BLOCK,
+                () -> {
+                    Bitmap bitmap = CromikoMangaReading.loadCover(entry);
+                    if (bitmap == null) return;
+                    PostTask.postTask(
+                            TaskTraits.UI_USER_VISIBLE,
+                            () -> {
+                                if (!entry.key.equals(cover.getTag())) return;
+                                cover.setPadding(0, 0, 0, 0);
+                                cover.setScaleType(ImageView.ScaleType.CENTER_CROP);
+                                cover.setImageBitmap(bitmap);
+                            });
+                });
+    }
+
+    private static String hostOf(String url) {
+        GURL gurl = new GURL(url);
+        return gurl.isValid() ? gurl.getHost() : url;
+    }
+}
