+/**
+ * CromIKO: "Continue reading" of manga mode. While the manga reader is open, this asks the page
+ * script (the "progress" command of res/raw/cromiko_manga.js) where the user is, and keeps the last
+ * chapter of each series with the place in it and a cover, for the "Continue reading" row of the
+ * new tab page (CromikoContinueReadingView). Opening that chapter again goes back to the place.
+ * Nothing is kept for incognito tabs.
+ */
+@NullMarked
+public final class CromikoMangaReading {
+    private static final String TAG = "CromikoReading";
+    // One entry per series, by the key from the page script: the last chapter read, as JSON.
+    private static final String PREFS_NAME = "cromiko_manga_reading";
+    private static final String COVERS_DIR = "cromiko_manga_covers";
+    private static final String PROGRESS_SCRIPT =
+            "JSON.stringify(window.__cromikoManga ? window.__cromikoManga.run('progress')"
+                    + " : {state: 'none'})";
+    private static final long POLL_INTERVAL_MS = 2000;
+    // The page script waits up to 20 seconds for the chapter images to appear.
+    private static final int MAX_WAITING_POLLS = 12;
+    private static final int MAX_ENTRIES = 12;
+    // A chapter read up to here is read: "Continue reading" goes on with the next one.
+    private static final double READ_PROGRESS = 0.98;
+    private static final int COVER_WIDTH = 240;
+    private static final int COVER_HEIGHT = 336;
+    // The longest side of the downloaded cover image.
+    private static final int COVER_DOWNLOAD_SIZE = 720;
+
+    /** The last chapter read of a series. */
+    public static final class Entry {
+        /** The key of the series, the same on all its chapters. */
+        public final String key;
+
+        public final String series;
+
+        /** The chapter number, or an empty string. */
+        public final String chapter;
+
+        public final String url;
+
+        /** The address of the next chapter, or an empty string. */
+        public final String next;
+
+        /** How much of the chapter the user read, 0 to 1. */
+        public final double progress;
+
+        // Where the user is: the image at the top of the screen and how far into it.
+        final int mIndex;
+        final double mOffset;
+        // The address of the cover image.
+        final String mCover;
+        final long mTime;
+
+        Entry(JSONObject json, String key) {
+            this.key = key;
+            series = json.optString("series");
+            chapter = json.optString("chapter");
+            url = json.optString("url");
+            next = json.optString("next");
+            progress = Math.max(0, Math.min(1, json.optDouble("progress", 0)));
+            mIndex = Math.max(0, json.optInt("index", 0));
+            mOffset = Math.max(0, Math.min(1, json.optDouble("offset", 0)));
+            mCover = json.optString("cover");
+            mTime = json.optLong("time", 0);
+        }
+
+        /** Whether the cover of the series is there. */
+        public boolean hasCover() {
+            return !mCover.isEmpty();
+        }
+
+        /** Whether the user read the whole chapter. */
+        public boolean isRead() {
+            return progress >= READ_PROGRESS;
+        }
+
+        /** The page that continues the series: the next chapter once this one is read. */
+        public String getContinueUrl() {
+            return isRead() && !next.isEmpty() ? next : url;
+        }
+
+        JSONObject toJson() throws JSONException {
+            return new JSONObject()
+                    .put("series", series)
+                    .put("chapter", chapter)
+                    .put("url", url)
+                    .put("next", next)
+                    .put("progress", progress)
+                    .put("index", mIndex)
+                    .put("offset", mOffset)
+                    .put("cover", mCover)
+                    .put("time", mTime);
+        }
+    }
+
+    // The reader that each tab tracks, so that a new page stops tracking the old one.
+    private static final Map<Tab, Integer> sTracking = new WeakHashMap<>();
+    private static int sLastTrackingId;
+    // The series whose cover is downloading.
+    private static final Set<String> sCoverDownloads = new HashSet<>();
+
+    private CromikoMangaReading() {}
+
+    /** Keeps where the user is in the manga reader of |tab| while it is open. */
+    public static void track(Tab tab, WebContents webContents) {
+        if (tab.isOffTheRecord()) return;
+        int id = ++sLastTrackingId;
+        sTracking.put(tab, id);
+        poll(tab, webContents, id, 0);
+    }
+
+    private static void poll(Tab tab, WebContents webContents, int id, int waitingPolls) {
+        Integer current = sTracking.get(tab);
+        if (current == null || current != id) return;
+        if (tab.isDestroyed() || tab.getWebContents() != webContents) {
+            sTracking.remove(tab);
+            return;
+        }
+        CromikoPageScripts.execute(
+                webContents,
+                PROGRESS_SCRIPT,
+                result -> {
+                    JSONObject state = parse(result);
+                    String name = state != null ? state.optString("state") : "";
+                    int waits = waitingPolls;
+                    if ("reading".equals(name)) {
+                        save(webContents, state);
+                        waits = 0;
+                    } else if (!"waiting".equals(name) || ++waits > MAX_WAITING_POLLS) {
+                        // The reader is closed.
+                        Integer tracking = sTracking.get(tab);
+                        if (tracking != null && tracking == id) sTracking.remove(tab);
+                        return;
+                    }
+                    int nextWaits = waits;
+                    PostTask.postDelayedTask(
+                            TaskTraits.UI_DEFAULT,
+                            () -> poll(tab, webContents, id, nextWaits),
+                            POLL_INTERVAL_MS);
+                });
+    }
+
+    private static void save(WebContents webContents, JSONObject state) {
+        String key = state.optString("key");
+        String url = state.optString("url");
+        if (key.isEmpty() || url.isEmpty()) return;
+        Entry old = get(key);
+        JSONObject json;
+        try {
+            json =
+                    new JSONObject()
+                            .put("series", state.optString("series"))
+                            .put("chapter", state.optString("chapter"))
+                            .put("url", url)
+                            .put("next", state.optString("next"))
+                            .put("progress", state.optDouble("progress", 0))
+                            .put("index", state.optInt("index", 0))
+                            .put("offset", state.optDouble("offset", 0))
+                            .put("cover", old != null ? old.mCover : "")
+                            .put("time", System.currentTimeMillis());
+        } catch (JSONException e) {
+            return;
+        }
+        Entry entry = new Entry(json, key);
+        boolean moved =
+                old == null
+                        || !old.url.equals(entry.url)
+                        || !old.next.equals(entry.next)
+                        || old.mIndex != entry.mIndex
+                        || Math.abs(old.mOffset - entry.mOffset) >= 0.01
+                        || Math.abs(old.progress - entry.progress) >= 0.01;
+        if (moved) {
+            prefs().edit().putString(key, json.toString()).apply();
+            prune();
+        }
+
+        // The cover of a series is the one found the first time: the series cover of sites that
+        // have one in their page (og:image), else the first page of the chapter.
+        String cover = state.optString("cover");
+        if (!cover.isEmpty() && entry.mCover.isEmpty() && sCoverDownloads.add(key)) {
+            downloadCover(webContents, key, cover);
+        }
+    }
+
+    // Keeps the MAX_ENTRIES series read last.
+    private static void prune() {
+        List<Entry> entries = getEntries();
+        if (entries.size() <= MAX_ENTRIES) return;
+        for (Entry entry : entries.subList(MAX_ENTRIES, entries.size())) {
+            remove(entry.key);
+        }
+    }
+
+    // Downloads the cover through the page, which sends the cookies and referrer that sites may
+    // need for their images, and usually has it in its cache already.
+    private static void downloadCover(WebContents webContents, String key, String cover) {
+        GURL url = new GURL(cover);
+        if (!url.isValid()) return;
+        webContents.downloadImage(
+                url,
+                /* isFavicon= */ false,
+                COVER_DOWNLOAD_SIZE,
+                /* bypassCache= */ false,
+                (id, httpStatusCode, imageUrl, bitmaps, originalImageSizes) -> {
+                    Bitmap largest = null;
+                    for (Bitmap bitmap : bitmaps) {
+                        if (largest == null || bitmap.getWidth() > largest.getWidth()) {
+                            largest = bitmap;
+                        }
+                    }
+                    if (largest == null || get(key) == null) {
+                        sCoverDownloads.remove(key);
+                        return;
+                    }
+                    Bitmap image = largest;
+                    PostTask.postTask(
+                            TaskTraits.BEST_EFFORT_MAY_BLOCK,
+                            () -> setCover(key, writeCover(key, image) ? cover : null));
+                });
+    }
+
+    // Crops the image to the shape of a book cover (the top of a tall page, the middle of a wide
+    // picture) and writes it.
+    private static boolean writeCover(String key, Bitmap image) {
+        int width = image.getWidth();
+        int height = image.getHeight();
+        if (width <= 0 || height <= 0) return false;
+        Rect source;
+        if (width * COVER_HEIGHT > height * COVER_WIDTH) {
+            int cropWidth = height * COVER_WIDTH / COVER_HEIGHT;
+            source = new Rect((width - cropWidth) / 2, 0, (width + cropWidth) / 2, height);
+        } else {
+            source = new Rect(0, 0, width, width * COVER_HEIGHT / COVER_WIDTH);
+        }
+        Bitmap cover = Bitmap.createBitmap(COVER_WIDTH, COVER_HEIGHT, Bitmap.Config.ARGB_8888);
+        new Canvas(cover)
+                .drawBitmap(
+                        image,
+                        source,
+                        new Rect(0, 0, COVER_WIDTH, COVER_HEIGHT),
+                        new Paint(Paint.FILTER_BITMAP_FLAG));
+        File file = coverFile(key);
+        File parent = file.getParentFile();
+        if (parent != null) parent.mkdirs();
+        try (OutputStream stream = new FileOutputStream(file)) {
+            return cover.compress(Bitmap.CompressFormat.JPEG, 85, stream);
+        } catch (IOException e) {
+            Log.w(TAG, "Cannot write the cover", e);
+            return false;
+        } finally {
+            cover.recycle();
+        }
+    }
+
+    private static void setCover(String key, @Nullable String cover) {
+        PostTask.postTask(
+                TaskTraits.UI_DEFAULT,
+                () -> {
+                    sCoverDownloads.remove(key);
+                    JSONObject entry = parse(prefs().getString(key, null));
+                    if (entry == null) {
+                        // The series was removed while its cover was downloading.
+                        if (cover != null) remove(key);
+                        return;
+                    }
+                    if (cover == null) return;
+                    try {
+                        entry.put("cover", cover);
+                    } catch (JSONException e) {
+                        return;
+                    }
+                    prefs().edit().putString(key, entry.toString()).apply();
+                });
+    }
+
+    /** The series the user read, the last one first. */
+    public static List<Entry> getEntries() {
+        List<Entry> entries = new ArrayList<>();
+        for (Map.Entry<String, ?> pref : prefs().getAll().entrySet()) {
+            Object value = pref.getValue();
+            JSONObject json = value instanceof String ? parse((String) value) : null;
+            if (json != null) entries.add(new Entry(json, pref.getKey()));
+        }
+        entries.sort((a, b) -> Long.compare(b.mTime, a.mTime));
+        return entries;
+    }
+
+    private static @Nullable Entry get(String key) {
+        JSONObject json = parse(prefs().getString(key, null));
+        return json != null ? new Entry(json, key) : null;
+    }
+
+    /**
+     * Where to resume reading the chapter at |url|, as the "resume" option of the page script, or
+     * null if the user has not read it.
+     */
+    public static @Nullable JSONObject getResumePosition(String url) {
+        for (Entry entry : getEntries()) {
+            if (!entry.url.equals(url) || entry.isRead()) continue;
+            try {
+                return new JSONObject()
+                        .put("url", entry.url)
+                        .put("index", entry.mIndex)
+                        .put("offset", entry.mOffset);
+            } catch (JSONException e) {
+                return null;
+            }
+        }
+        return null;
+    }
+
+    /** Loads the cover of |entry|, or returns null if there is none. Call off the UI thread. */
+    public static @Nullable Bitmap loadCover(Entry entry) {
+        File file = coverFile(entry.key);
+        return file.exists() ? BitmapFactory.decodeFile(file.getPath()) : null;
+    }
+
+    /** Removes a series from "Continue reading". */
+    public static void remove(String key) {
+        prefs().edit().remove(key).apply();
+        File file = coverFile(key);
+        PostTask.postTask(TaskTraits.BEST_EFFORT_MAY_BLOCK, () -> file.delete());
+    }
+
+    /** Forgets all series, for the Fire button. */
+    public static void clear() {
+        sTracking.clear();
+        prefs().edit().clear().apply();
+        File dir = coversDir();
+        PostTask.postTask(
+                TaskTraits.BEST_EFFORT_MAY_BLOCK,
+                () -> FileUtils.recursivelyDeleteFile(dir, name -> true));
+    }
+
+    private static SharedPreferences prefs() {
+        return ContextUtils.getApplicationContext()
+                .getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE);
+    }
+
+    private static File coversDir() {
+        return new File(ContextUtils.getApplicationContext().getFilesDir(), COVERS_DIR);
+    }
+
+    private static File coverFile(String key) {
+        String name;
+        try {
+            byte[] hash =
+                    MessageDigest.getInstance("SHA-1").digest(key.getBytes(StandardCharsets.UTF_8));
+            StringBuilder hex = new StringBuilder();
+            for (byte b : hash) hex.append(String.format("%02x", b));
+            name = hex.toString();
+        } catch (NoSuchAlgorithmException e) {
+            name = Integer.toHexString(key.hashCode());
+        }
+        return new File(coversDir(), name + ".jpg");
+    }
+
+    private static @Nullable JSONObject parse(@Nullable String json) {
+        if (json == null || json.isEmpty()) return null;
+        try {
+            return new JSONObject(json);
+        } catch (JSONException e) {
+            return null;
+        }
+    }
+}
