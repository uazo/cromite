+    // What the chapter is: its series (and a key for it that is the same on
+    // all chapters), chapter number, cover and next chapter.
+    function describeChapter() {
+      let found = null;
+      for (const text of [metaContent('og:title'), document.title,
+                          (document.querySelector('h1') || {}).textContent]) {
+        const parsed = parseTitle(text);
+        if (parsed && (!found || !found.series)) {
+          found = {series: parsed.series || (found && found.series) || '',
+                   chapter: (found && found.chapter) || parsed.chapter};
+        }
+        if (found && found.series) {
+          break;
+        }
+      }
+      const fromUrl = parseUrl();
+      const series = (found && found.series) || (fromUrl && fromUrl.series) ||
+          location.hostname;
+      const chapter = (found && found.chapter) || (fromUrl && fromUrl.chapter) || '';
+      let cover = absoluteUrl(metaContent('og:image'));
+      if (!cover) {
+        const page = chapterMedia().find(
+            el => el.tagName === 'IMG' && !isPlaceholder(el));
+        cover = page ? absoluteUrl(page.currentSrc || page.src) : '';
+      }
+      return {
+        key: location.hostname + '/' +
+            series.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-|-$/g, ''),
+        series,
+        chapter,
+        title: (document.title || '').trim().slice(0, 120),
