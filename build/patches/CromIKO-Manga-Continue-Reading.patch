+
+    // ---------------------------------------------------------------------
+    // Continue reading
+
+    // Scrolls to where the user stopped reading this chapter. The images
+    // above may still be loading and change size: keep the place until the
+    // user scrolls, or for RESTORE_MS.
+    function startRestore(position) {
+      const restore = {
+        index: Math.max(0, Math.floor(Number(position.index) || 0)),
+        offset: Math.min(1, Math.max(0, Number(position.offset) || 0)),
+        until: Date.now() + RESTORE_MS,
+        stop: () => stopRestore(),
+      };
+      reader.restore = restore;
+      for (const type of ['touchstart', 'wheel', 'keydown', 'mousedown']) {
+        window.addEventListener(type, restore.stop, {capture: true, passive: true});
+      }
+      restore.timer = setInterval(applyRestore, 200);
+      applyRestore();
+    }
+
+    function applyRestore() {
+      const restore = reader && reader.restore;
+      if (!restore) {
+        return;
+      }
+      if (Date.now() > restore.until) {
+        stopRestore();
+        return;
+      }
+      const target = chapterMedia()[restore.index];
+      if (!target) {
+        // Not there yet.
+        return;
+      }
+      const rect = target.getBoundingClientRect();
+      const y = Math.round(window.scrollY + rect.top + restore.offset * rect.height);
+      if (Math.abs(window.scrollY - y) > 2) {
+        window.scrollTo(0, y);
+      }
+    }
+
+    function stopRestore() {
+      const restore = reader && reader.restore;
+      if (!restore) {
+        return;
+      }
+      clearInterval(restore.timer);
+      for (const type of ['touchstart', 'wheel', 'keydown', 'mousedown']) {
+        window.removeEventListener(type, restore.stop, {capture: true});
+      }
+      reader.restore = null;
+      // Not again when the reader opens again on this page.
+      reader.cfg.resume = null;
+    }
+
+    // Where the user is: the image at the top of the screen (index), how far
+    // into it (offset), and how much of the chapter that is (progress).
+    function progressOf() {
+      const media = chapterMedia();
+      if (reader.restore) {
+        // Still going back to the saved place.
+        const {index, offset} = reader.restore;
+        return {
+          index,
+          offset,
+          progress: media.length ?
+              Math.round(Math.min(1, (index + offset) / media.length) * 1000) / 1000 :
+              0,
+        };
+      }
+      let index = 0;
+      let offset = 0;
+      for (let i = 0; i < media.length; i++) {
+        const rect = media[i].getBoundingClientRect();
+        index = i;
+        if (rect.bottom > 1) {
+          offset = rect.height > 0 ? Math.min(1, Math.max(0, -rect.top / rect.height)) : 0;
+          break;
+        }
+        offset = 1;
+      }
+      let progress = media.length ? (index + offset) / media.length : 0;
+      const last = media[media.length - 1];
+      if (last && !isPlaceholder(last) &&
+          last.getBoundingClientRect().bottom <= window.innerHeight + 2) {
+        // The end of the chapter is on the screen.
+        progress = 1;
+      }
+      return {
+        index,
+        offset: Math.round(offset * 1000) / 1000,
+        progress: Math.round(Math.min(1, progress) * 1000) / 1000,
+      };
+    }
+
+    function metaContent(property) {
+      const meta = document.querySelector(
+          'meta[property="' + property + '"], meta[name="' + property + '"]');
+      return meta ? (meta.getAttribute('content') || '').trim() : '';
+    }
+
+    function absoluteUrl(url, base) {
+      if (!url) {
+        return '';
+      }
+      try {
+        const parsed = new URL(url, base || location.href);
+        return /^https?:$/.test(parsed.protocol) ? parsed.href : '';
+      } catch (e) {
+        return '';
+      }
+    }
+
+    function nextChapterUrl() {
+      const el = findNav(reader.cfg.next);
+      const href = el && el.tagName === 'A' ? el.getAttribute('href') || '' : '';
+      if (!href || href.startsWith('#') || /^javascript:/i.test(href)) {
+        return '';
+      }
+      return absoluteUrl(el.href);
+    }
+
+    function titleCase(slug) {
+      return slug.replace(/[-_+]+/g, ' ').trim()
+          .replace(/\b\p{L}/gu, letter => letter.toUpperCase());
+    }
+
+    // The series and chapter number from a title like "Series - Chapter 12 |
+    // Site" or "Chapter 12 - Series", or null.
+    function parseTitle(text) {
+      text = (text || '').replace(/\s+/g, ' ').trim();
+      const match = CHAPTER_RE.exec(text);
+      if (!match) {
+        return null;
+      }
+      const start = match.index + match[1].length;
+      const before = text.slice(0, start).split(TITLE_SEPARATOR)
+                         .map(part => part.replace(/^read\s+/i, '')
+                                          .replace(/[\s\-:,(\[|]+$/, '').trim())
+                         .filter(Boolean);
+      const after = text.slice(match.index + match[0].length).split(TITLE_SEPARATOR)
+                        .map(part => part.replace(/^[\s\-:,)\]|]+/, '').trim())
+                        .filter(Boolean);
+      // The series comes right before the chapter, or after it when the title
+      // starts with the chapter.
+      const series = before.length ? before[before.length - 1] : after[0] || '';
+      return {series: series.slice(0, 80), chapter: match[3].replace(',', '.')};
+    }
+
+    // The series and chapter from the address, like
+    // /manga/one-piece/chapter-12/ or /read/one-piece-chapter-12.
+    function parseUrl() {
+      const segments = location.pathname.split('/').filter(Boolean)
+                           .map(segment => {
+                             try {
+                               return decodeURIComponent(segment);
+                             } catch (e) {
+                               return segment;
+                             }
+                           });
+      for (let i = segments.length - 1; i >= 0; i--) {
+        const match = /^(.*?)[-_]*(?:chapter|chap|ch|episode|ep|c)?[-_]*(\d+(?:[.-]\d+)?)(?:\.html?)?$/i
+                          .exec(segments[i]);
+        if (!match) {
+          continue;
+        }
+        const slug = match[1] || segments[i - 1] || '';
+        return {series: titleCase(slug), chapter: match[2].replace('-', '.')};
+      }
+      return null;
+    }
