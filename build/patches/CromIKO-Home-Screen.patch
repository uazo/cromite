--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoHomeScreen.java
@@ -0,0 +1,277 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.cromiko;
+
+import android.content.SharedPreferences;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.TextView;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.base.ObserverList;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.ntp_customization.NtpCustomizationConfigManager;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * CromIKO: the widgets of the new tab page, in the order, size and visibility that the user chose
+ * in the "Edit home screen" dialog (CromikoHomeScreenEditor). The widgets are direct children of
+ * NewTabPageLayout; {@link #apply} moves them between the places that they take in the layout, so
+ * the search box and the rest of the page stay where they are.
+ *
+ * <p>The layout is a setting of the app, kept like "shortcuts,-shield_stats,downloads:small": a
+ * leading '-' hides a widget, ":small" makes it compact. Most visited sites keep their own
+ * setting, the one of "Customize Chrome", so both stay the same.
+ */
+@NullMarked
+public final class CromikoHomeScreen {
+    /** A view of a widget that can be hidden and made compact. */
+    public interface WidgetView {
+        /**
+         * @param shown Whether the user wants to see the widget. A shown widget can still hide
+         *     itself when it has nothing to show.
+         * @param compact Whether the user chose the small size.
+         */
+        void setHomeWidgetState(boolean shown, boolean compact);
+    }
+
+    /** A widget as the user arranged it. */
+    public static final class Widget {
+        public final String id;
+        public boolean shown = true;
+        public boolean compact;
+
+        Widget(String id) {
+            this.id = id;
+        }
+    }
+
+    public static final String SHORTCUTS = "shortcuts";
+    public static final String SHIELD_STATS = "shield_stats";
+    public static final String CONTINUE_READING = "continue_reading";
+    public static final String MOST_VISITED = "most_visited";
+    public static final String DOWNLOADS = "downloads";
+
+    // The widgets and their order on a new home screen, and after a reset.
+    private static final String[] DEFAULT_ORDER = {
+        SHORTCUTS, SHIELD_STATS, CONTINUE_READING, MOST_VISITED, DOWNLOADS
+    };
+
+    private static final String LAYOUT_PREF = "cromiko_home_layout";
+    private static final String HIDDEN = "-";
+    private static final String SMALL = ":small";
+
+    private static final ObserverList<Runnable> sObservers = new ObserverList<>();
+
+    private CromikoHomeScreen() {}
+
+    /** Adds an observer that runs when the user changes the home screen. */
+    public static void addObserver(Runnable observer) {
+        sObservers.addObserver(observer);
+    }
+
+    public static void removeObserver(Runnable observer) {
+        sObservers.removeObserver(observer);
+    }
+
+    /** Returns the widgets in the order of the home screen. */
+    public static List<Widget> load() {
+        List<Widget> widgets = new ArrayList<>();
+        String saved = prefs().getString(LAYOUT_PREF, "");
+        for (String id : saved.split(",")) {
+            boolean shown = !id.startsWith(HIDDEN);
+            if (!shown) id = id.substring(HIDDEN.length());
+            boolean compact = id.endsWith(SMALL);
+            if (compact) id = id.substring(0, id.length() - SMALL.length());
+            if (!isKnown(id) || find(widgets, id) != null) continue;
+            Widget widget = new Widget(id);
+            widget.shown = shown;
+            widget.compact = compact && canResize(id);
+            widgets.add(widget);
+        }
+        // Widgets that are not saved yet, like the ones of a newer version, go where they are by
+        // default: after the widget before them.
+        for (int i = 0; i < DEFAULT_ORDER.length; i++) {
+            if (find(widgets, DEFAULT_ORDER[i]) != null) continue;
+            int index = 0;
+            for (int j = i - 1; j >= 0; j--) {
+                Widget before = find(widgets, DEFAULT_ORDER[j]);
+                if (before != null) {
+                    index = widgets.indexOf(before) + 1;
+                    break;
+                }
+            }
+            widgets.add(index, new Widget(DEFAULT_ORDER[i]));
+        }
+        Widget mostVisited = find(widgets, MOST_VISITED);
+        if (mostVisited != null) mostVisited.shown = isMostVisitedShown();
+        return widgets;
+    }
+
+    /** Saves the widgets, in the order of the home screen, and updates the new tab pages. */
+    public static void save(List<Widget> widgets) {
+        StringBuilder saved = new StringBuilder();
+        for (Widget widget : widgets) {
+            if (saved.length() > 0) saved.append(',');
+            if (!widget.shown) saved.append(HIDDEN);
+            saved.append(widget.id);
+            if (widget.compact) saved.append(SMALL);
+        }
+        prefs().edit().putString(LAYOUT_PREF, saved.toString()).apply();
+        Widget mostVisited = find(widgets, MOST_VISITED);
+        // This updates the new tab pages too, through their listener of the setting.
+        if (mostVisited != null && mostVisited.shown != isMostVisitedShown()) {
+            NtpCustomizationConfigManager.getInstance().setPrefIsMvtToggleOn(mostVisited.shown);
+        }
+        notifyObservers();
+    }
+
+    /** Puts back the default home screen: all widgets, large, in the default order. */
+    public static void reset() {
+        prefs().edit().remove(LAYOUT_PREF).apply();
+        if (!isMostVisitedShown()) {
+            NtpCustomizationConfigManager.getInstance().setPrefIsMvtToggleOn(true);
+        }
+        notifyObservers();
+    }
+
+    /** Whether the user can make the widget small. */
+    public static boolean canResize(String id) {
+        return !MOST_VISITED.equals(id);
+    }
+
+    /** The name of a widget, for the "Edit home screen" dialog. */
+    public static int getNameResource(String id) {
+        switch (id) {
+            case SHORTCUTS:
+                return R.string.cromiko_home_widget_shortcuts;
+            case SHIELD_STATS:
+                return R.string.cromiko_home_widget_shield_stats;
+            case CONTINUE_READING:
+                return R.string.cromiko_continue_reading_title;
+            case MOST_VISITED:
+                return R.string.cromiko_home_widget_most_visited;
+            default:
+                return R.string.cromiko_home_widget_downloads;
+        }
+    }
+
+    /** Returns the widgets that |layout|, a NewTabPageLayout, has. */
+    public static List<String> getAvailableWidgets(ViewGroup layout) {
+        List<String> ids = new ArrayList<>();
+        for (String id : DEFAULT_ORDER) {
+            View view = findView(layout, id);
+            // The shortcut row is only there with the simplified new tab page.
+            if (view != null && (!SHORTCUTS.equals(id) || view.getId() == R.id.shortcuts)) {
+                ids.add(id);
+            }
+        }
+        return ids;
+    }
+
+    /** Arranges the widgets of |layout|, a NewTabPageLayout, as the user chose. */
+    public static void apply(ViewGroup layout) {
+        List<Widget> widgets = load();
+
+        // The places of the widgets in the layout, and the widgets in the order to put there.
+        List<Integer> places = new ArrayList<>();
+        for (int i = 0; i < layout.getChildCount(); i++) {
+            if (idOf(layout.getChildAt(i)) != null) places.add(i);
+        }
+        List<View> views = new ArrayList<>();
+        for (Widget widget : widgets) {
+            View view = findView(layout, widget.id);
+            if (view != null) views.add(view);
+        }
+        if (places.size() == views.size()) {
+            boolean moved = false;
+            for (int i = 0; i < places.size(); i++) {
+                if (layout.getChildAt(places.get(i)) != views.get(i)) moved = true;
+            }
+            if (moved) {
+                for (View view : views) layout.removeView(view);
+                for (int i = 0; i < views.size(); i++) layout.addView(views.get(i), places.get(i));
+            }
+        }
+
+        for (Widget widget : widgets) {
+            View view = findView(layout, widget.id);
+            if (view instanceof WidgetView widgetView) {
+                widgetView.setHomeWidgetState(widget.shown, widget.compact);
+            } else if (view != null && view.getId() == R.id.shortcuts) {
+                applyToShortcuts((ViewGroup) view, widget);
+            }
+        }
+    }
+
+    // The shortcut row of the simplified new tab page: small shows only the icons.
+    private static void applyToShortcuts(ViewGroup shortcuts, Widget widget) {
+        shortcuts.setVisibility(widget.shown ? View.VISIBLE : View.GONE);
+        float density = shortcuts.getResources().getDisplayMetrics().density;
+        for (int i = 0; i < shortcuts.getChildCount(); i++) {
+            if (!(shortcuts.getChildAt(i) instanceof ViewGroup button)
+                    || button.getChildCount() == 0
+                    || !(button.getChildAt(0) instanceof TextView label)) {
+                continue;
+            }
+            // The text of the button, kept as its description while it only shows the icon.
+            if (button.getContentDescription() == null) {
+                button.setContentDescription(label.getText());
+            }
+            label.setText(widget.compact ? "" : button.getContentDescription());
+            label.setCompoundDrawablePadding(widget.compact ? 0 : Math.round(8 * density));
+        }
+    }
+
+    // The view of a widget in |layout|, the ViewStub of the widgets that are not inflated yet.
+    private static @Nullable View findView(ViewGroup layout, String id) {
+        for (int i = 0; i < layout.getChildCount(); i++) {
+            View child = layout.getChildAt(i);
+            if (id.equals(idOf(child))) return child;
+        }
+        return null;
+    }
+
+    private static @Nullable String idOf(View view) {
+        int viewId = view.getId();
+        if (viewId == R.id.shortcuts || viewId == R.id.shortcuts_stub) return SHORTCUTS;
+        if (viewId == R.id.cromiko_shield_stats) return SHIELD_STATS;
+        if (viewId == R.id.cromiko_continue_reading) return CONTINUE_READING;
+        if (viewId == R.id.mv_tiles_container || viewId == R.id.mv_tiles_layout_stub) {
+            return MOST_VISITED;
+        }
+        if (viewId == R.id.cromiko_downloads_widget) return DOWNLOADS;
+        return null;
+    }
+
+    private static boolean isKnown(String id) {
+        for (String known : DEFAULT_ORDER) {
+            if (known.equals(id)) return true;
+        }
+        return false;
+    }
+
+    private static @Nullable Widget find(List<Widget> widgets, String id) {
+        for (Widget widget : widgets) {
+            if (widget.id.equals(id)) return widget;
+        }
+        return null;
+    }
+
+    private static boolean isMostVisitedShown() {
+        return NtpCustomizationConfigManager.getInstance().getPrefIsMvtToggleOn();
+    }
+
+    private static void notifyObservers() {
+        for (Runnable observer : sObservers) observer.run();
+    }
+
+    private static SharedPreferences prefs() {
+        return ContextUtils.getAppSharedPreferences();
+    }
+}
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoHomeScreenEditor.java b/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoHomeScreenEditor.java
new file mode 100644
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoHomeScreenEditor.java
@@ -0,0 +1,265 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.cromiko;
+
+import android.annotation.SuppressLint;
+import android.app.Activity;
+import android.content.Context;
+import android.view.LayoutInflater;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ImageView;
+import android.widget.TextView;
+
+import androidx.appcompat.app.AlertDialog;
+import androidx.appcompat.widget.SwitchCompat;
+import androidx.core.view.ViewCompat;
+import androidx.recyclerview.widget.ItemTouchHelper;
+import androidx.recyclerview.widget.LinearLayoutManager;
+import androidx.recyclerview.widget.RecyclerView;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.cromiko.CromikoHomeScreen.Widget;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * CromIKO: the "Edit home screen" dialog of the new tab page. The user drags the widgets to move
+ * them, makes them small or large, and turns them off; the new tab page changes behind the dialog
+ * right away. Reset puts back the default home screen in one tap.
+ */
+@NullMarked
+public final class CromikoHomeScreenEditor {
+    private CromikoHomeScreenEditor() {}
+
+    /**
+     * Shows the dialog.
+     *
+     * @param availableWidgets The widgets of the new tab page, see {@link
+     *     CromikoHomeScreen#getAvailableWidgets}.
+     */
+    @SuppressLint("InflateParams")
+    public static void show(Activity activity, List<String> availableWidgets) {
+        View view = LayoutInflater.from(activity).inflate(R.layout.cromiko_home_edit, null);
+        RecyclerView list = view.findViewById(R.id.cromiko_home_edit_list);
+        Adapter adapter = new Adapter(availableWidgets);
+        list.setLayoutManager(new LinearLayoutManager(activity));
+        list.setAdapter(adapter);
+        ItemTouchHelper touchHelper =
+                new ItemTouchHelper(
+                        new ItemTouchHelper.SimpleCallback(
+                                ItemTouchHelper.UP | ItemTouchHelper.DOWN, 0) {
+                            @Override
+                            public boolean onMove(
+                                    RecyclerView recyclerView,
+                                    RecyclerView.ViewHolder from,
+                                    RecyclerView.ViewHolder to) {
+                                return adapter.move(
+                                        from.getBindingAdapterPosition(),
+                                        to.getBindingAdapterPosition());
+                            }
+
+                            @Override
+                            public void onSwiped(RecyclerView.ViewHolder holder, int direction) {}
+
+                            @Override
+                            public void onSelectedChanged(
+                                    RecyclerView.@Nullable ViewHolder holder, int actionState) {
+                                super.onSelectedChanged(holder, actionState);
+                                if (holder != null
+                                        && actionState == ItemTouchHelper.ACTION_STATE_DRAG) {
+                                    holder.itemView.setBackgroundResource(
+                                            R.drawable.cromiko_home_edit_drag_background);
+                                }
+                            }
+
+                            @Override
+                            public void clearView(
+                                    RecyclerView recyclerView, RecyclerView.ViewHolder holder) {
+                                super.clearView(recyclerView, holder);
+                                holder.itemView.setBackground(null);
+                                // Saves once the user drops the widget, and updates the
+                                // "Move up" and "Move down" actions of the rows.
+                                adapter.save();
+                                recyclerView.post(
+                                        () ->
+                                                adapter.notifyItemRangeChanged(
+                                                        0, adapter.getItemCount()));
+                            }
+                        });
+        touchHelper.attachToRecyclerView(list);
+        adapter.mTouchHelper = touchHelper;
+
+        AlertDialog dialog =
+                new AlertDialog.Builder(activity, R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                        .setTitle(R.string.cromiko_home_edit)
+                        .setView(view)
+                        .setPositiveButton(R.string.cromiko_home_done, null)
+                        .setNeutralButton(R.string.cromiko_home_reset, null)
+                        .create();
+        // Reset keeps the dialog open, to show the default home screen in it.
+        dialog.setOnShowListener(
+                shownDialog ->
+                        dialog.getButton(AlertDialog.BUTTON_NEUTRAL)
+                                .setOnClickListener(
+                                        button -> {
+                                            CromikoHomeScreen.reset();
+                                            adapter.reload();
+                                        }));
+        dialog.show();
+    }
+
+    private static final class Holder extends RecyclerView.ViewHolder {
+        final ImageView mHandle;
+        final TextView mName;
+        final TextView mSize;
+        final SwitchCompat mSwitch;
+        // The ids of the "Move up" and "Move down" accessibility actions.
+        final List<Integer> mActions = new ArrayList<>();
+
+        Holder(View itemView) {
+            super(itemView);
+            mHandle = itemView.findViewById(R.id.cromiko_home_edit_item_handle);
+            mName = itemView.findViewById(R.id.cromiko_home_edit_item_name);
+            mSize = itemView.findViewById(R.id.cromiko_home_edit_item_size);
+            mSwitch = itemView.findViewById(R.id.cromiko_home_edit_item_switch);
+        }
+    }
+
+    private static final class Adapter extends RecyclerView.Adapter<Holder> {
+        private final List<String> mAvailableWidgets;
+        // The widgets of the new tab page, in their order.
+        private final List<Widget> mWidgets = new ArrayList<>();
+        private @Nullable ItemTouchHelper mTouchHelper;
+
+        Adapter(List<String> availableWidgets) {
+            mAvailableWidgets = availableWidgets;
+            load();
+        }
+
+        private void load() {
+            mWidgets.clear();
+            for (Widget widget : CromikoHomeScreen.load()) {
+                if (mAvailableWidgets.contains(widget.id)) mWidgets.add(widget);
+            }
+        }
+
+        @SuppressLint("NotifyDataSetChanged")
+        void reload() {
+            load();
+            notifyDataSetChanged();
+        }
+
+        boolean move(int from, int to) {
+            if (from < 0 || to < 0 || from >= mWidgets.size() || to >= mWidgets.size()) {
+                return false;
+            }
+            Collections.swap(mWidgets, from, to);
+            notifyItemMoved(from, to);
+            return true;
+        }
+
+        // Saves the widgets of the dialog in their new order, in the places of the widgets that
+        // the new tab page has, so the others keep theirs.
+        void save() {
+            List<Widget> widgets = CromikoHomeScreen.load();
+            int next = 0;
+            for (int i = 0; i < widgets.size() && next < mWidgets.size(); i++) {
+                if (mAvailableWidgets.contains(widgets.get(i).id)) {
+                    widgets.set(i, mWidgets.get(next++));
+                }
+            }
+            CromikoHomeScreen.save(widgets);
+        }
+
+        @Override
+        public int getItemCount() {
+            return mWidgets.size();
+        }
+
+        @Override
+        public Holder onCreateViewHolder(ViewGroup parent, int viewType) {
+            return new Holder(
+                    LayoutInflater.from(parent.getContext())
+                            .inflate(R.layout.cromiko_home_edit_item, parent, false));
+        }
+
+        @SuppressLint("ClickableViewAccessibility")
+        @Override
+        public void onBindViewHolder(Holder holder, int position) {
+            Context context = holder.itemView.getContext();
+            Widget widget = mWidgets.get(position);
+            holder.mName.setText(CromikoHomeScreen.getNameResource(widget.id));
+
+            holder.mSize.setVisibility(
+                    CromikoHomeScreen.canResize(widget.id) ? View.VISIBLE : View.INVISIBLE);
+            holder.mSize.setText(
+                    widget.compact
+                            ? R.string.cromiko_home_size_small
+                            : R.string.cromiko_home_size_large);
+            holder.mSize.setEnabled(widget.shown);
+            holder.mSize.setContentDescription(
+                    holder.mName.getText() + ", " + holder.mSize.getText());
+            holder.mSize.setOnClickListener(
+                    view -> {
+                        widget.compact = !widget.compact;
+                        notifyItemChanged(holder.getBindingAdapterPosition());
+                        save();
+                    });
+
+            holder.mSwitch.setOnCheckedChangeListener(null);
+            holder.mSwitch.setChecked(widget.shown);
+            holder.mSwitch.setContentDescription(holder.mName.getText());
+            holder.mSwitch.setOnCheckedChangeListener(
+                    (button, checked) -> {
+                        widget.shown = checked;
+                        holder.mSize.setEnabled(checked);
+                        save();
+                    });
+
+            holder.mHandle.setOnTouchListener(
+                    (view, event) -> {
+                        if (event.getActionMasked() == MotionEvent.ACTION_DOWN
+                                && mTouchHelper != null) {
+                            mTouchHelper.startDrag(holder);
+                        }
+                        return false;
+                    });
+
+            // Moving without dragging, for TalkBack.
+            for (int action : holder.mActions) {
+                ViewCompat.removeAccessibilityAction(holder.itemView, action);
+            }
+            holder.mActions.clear();
+            if (position > 0) {
+                holder.mActions.add(
+                        ViewCompat.addAccessibilityAction(
+                                holder.itemView,
+                                context.getString(R.string.cromiko_home_move_up),
+                                (view, arguments) -> moveAndSave(holder, -1)));
+            }
+            if (position < mWidgets.size() - 1) {
+                holder.mActions.add(
+                        ViewCompat.addAccessibilityAction(
+                                holder.itemView,
+                                context.getString(R.string.cromiko_home_move_down),
+                                (view, arguments) -> moveAndSave(holder, 1)));
+            }
+        }
+
+        private boolean moveAndSave(Holder holder, int offset) {
+            int from = holder.getBindingAdapterPosition();
+            if (!move(from, from + offset)) return false;
+            // The first and last rows have other actions.
+            notifyItemRangeChanged(Math.min(from, from + offset), 2);
+            save();
+            return true;
+        }
+    }
+}
