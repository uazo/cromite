+        <ProgressBar
+            android:id="@+id/cromiko_downloads_widget_item_progress"
+            style="?android:attr/progressBarStyleHorizontal"
+            android:layout_width="match_parent"
+            android:layout_height="4dp"
+            android:layout_marginTop="4dp"
+            android:importantForAccessibility="no"
+            android:indeterminateTint="@color/cromiko_accent_color"
+            android:max="100"
+            android:progressTint="@color/cromiko_accent_color"
+            android:visibility="gone" />
+    </LinearLayout>
+</LinearLayout>
