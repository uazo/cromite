@@ -0,0 +1,276 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.cromiko;
+
+import android.content.Context;
+import android.util.AttributeSet;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.widget.LinearLayout;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.download.CromikoDownloadStatus;
+import org.chromium.chrome.browser.download.items.OfflineContentAggregatorFactory;
+import org.chromium.components.browser_ui.util.DownloadUtils;
+import org.chromium.components.offline_items_collection.ContentId;
+import org.chromium.components.offline_items_collection.LaunchLocation;
+import org.chromium.components.offline_items_collection.OfflineContentProvider;
+import org.chromium.components.offline_items_collection.OfflineItem;
+import org.chromium.components.offline_items_collection.OfflineItemState;
+import org.chromium.components.offline_items_collection.OpenParams;
+import org.chromium.components.offline_items_collection.UpdateDelta;
+
+import java.text.NumberFormat;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * CromIKO: the "Recent downloads" widget of the new tab page. It shows the downloads that run or
+ * wait, with their progress and speed from the CromIKO download manager, then the ones that
+ * finished this week. A tap opens a finished download, or the download manager.
+ */
+@NullMarked
+public class CromikoDownloadsWidgetView extends LinearLayout
+        implements CromikoHomeScreen.WidgetView, OfflineContentProvider.Observer {
+    private static final long RECENT_MS = TimeUnit.DAYS.toMillis(7);
+    private static final int MAX_ITEMS = 3;
+
+    // The downloads that the widget can show, by id.
+    private final Map<ContentId, OfflineItem> mItems = new HashMap<>();
+    private @Nullable Runnable mOpenDownloads;
+    private @Nullable LinearLayout mRows;
+    private boolean mAttached;
+    private boolean mObserving;
+    private boolean mShown = true;
+    private boolean mCompact;
+
+    /** Constructor for inflating from XML. */
+    public CromikoDownloadsWidgetView(Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+    }
+
+    /** Sets what opens the download manager, or null to hide the widget. */
+    public void setOpenDownloadsCallback(@Nullable Runnable openDownloads) {
+        mOpenDownloads = openDownloads;
+        updateObserving();
+        update();
+    }
+
+    @Override
+    public void setHomeWidgetState(boolean shown, boolean compact) {
+        mShown = shown;
+        mCompact = compact;
+        updateObserving();
+        update();
+    }
+
+    @Override
+    protected void onFinishInflate() {
+        super.onFinishInflate();
+        mRows = findViewById(R.id.cromiko_downloads_widget_items);
+        findViewById(R.id.cromiko_downloads_widget_header)
+                .setOnClickListener(view -> openDownloads());
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        mAttached = true;
+        updateObserving();
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        super.onDetachedFromWindow();
+        mAttached = false;
+        updateObserving();
+    }
+
+    // OfflineContentProvider.Observer:
+
+    @Override
+    public void onItemsAdded(List<OfflineItem> items) {
+        for (OfflineItem item : items) put(item);
+        update();
+    }
+
+    @Override
+    public void onItemRemoved(ContentId id) {
+        if (mItems.remove(id) != null) update();
+    }
+
+    @Override
+    public void onItemUpdated(OfflineItem item, UpdateDelta updateDelta) {
+        put(item);
+        update();
+    }
+
+    // Watches the downloads while the widget is on the screen.
+    private void updateObserving() {
+        boolean observe = mAttached && mShown && mOpenDownloads != null;
+        if (observe == mObserving) return;
+        mObserving = observe;
+        OfflineContentProvider provider = OfflineContentAggregatorFactory.get();
+        if (!observe) {
+            provider.removeObserver(this);
+            return;
+        }
+        provider.addObserver(this);
+        provider.getAllItems(
+                items -> {
+                    if (!mObserving) return;
+                    mItems.clear();
+                    for (OfflineItem item : items) put(item);
+                    update();
+                });
+    }
+
+    private void put(OfflineItem item) {
+        if (item.id == null) return;
+        if (item.isTransient || item.isSuggested || item.isOffTheRecord || item.isDangerous) {
+            mItems.remove(item.id);
+        } else {
+            mItems.put(item.id, item);
+        }
+    }
+
+    private void update() {
+        List<OfflineItem> items =
+                mShown && mOpenDownloads != null ? getRecentItems() : new ArrayList<>();
+        setVisibility(items.isEmpty() ? GONE : VISIBLE);
+        if (mRows == null) return;
+        // Keeps the rows, since running downloads update often.
+        while (mRows.getChildCount() > items.size()) mRows.removeViewAt(mRows.getChildCount() - 1);
+        LayoutInflater inflater = LayoutInflater.from(getContext());
+        for (int i = 0; i < items.size(); i++) {
+            if (i == mRows.getChildCount()) {
+                mRows.addView(
+                        inflater.inflate(R.layout.cromiko_downloads_widget_item, mRows, false));
+            }
+            bind(mRows.getChildAt(i), items.get(i));
+        }
+    }
+
+    // The downloads that run or wait, newest first, then the ones finished this week.
+    private List<OfflineItem> getRecentItems() {
+        long now = System.currentTimeMillis();
+        List<OfflineItem> running = new ArrayList<>();
+        List<OfflineItem> finished = new ArrayList<>();
+        for (OfflineItem item : mItems.values()) {
+            if (item.externallyRemoved) continue;
+            if (isRunning(item)) {
+                running.add(item);
+            } else if (item.state == OfflineItemState.COMPLETE
+                    && now - finishTime(item) < RECENT_MS) {
+                finished.add(item);
+            }
+        }
+        running.sort((a, b) -> Long.compare(b.creationTimeMs, a.creationTimeMs));
+        finished.sort((a, b) -> Long.compare(finishTime(b), finishTime(a)));
+        List<OfflineItem> items = new ArrayList<>(running);
+        items.addAll(finished);
+        int max = mCompact ? 1 : MAX_ITEMS;
+        return items.size() > max ? new ArrayList<>(items.subList(0, max)) : items;
+    }
+
+    private void bind(View row, OfflineItem item) {
+        Context context = getContext();
+        TextView title = row.findViewById(R.id.cromiko_downloads_widget_item_title);
+        title.setText(item.title);
+        TextView status = row.findViewById(R.id.cromiko_downloads_widget_item_status);
+        status.setText(getStatus(context, item));
+        ProgressBar progress = row.findViewById(R.id.cromiko_downloads_widget_item_progress);
+        boolean running = isRunning(item);
+        progress.setVisibility(running ? VISIBLE : GONE);
+        if (running) {
+            int percent = getPercentage(item);
+            progress.setIndeterminate(percent < 0 && item.state == OfflineItemState.IN_PROGRESS);
+            progress.setProgress(Math.max(percent, 0));
+        }
+        row.setContentDescription(item.title + ", " + status.getText());
+        ContentId id = item.id;
+        boolean canOpen = item.state == OfflineItemState.COMPLETE && item.isOpenable;
+        row.setOnClickListener(
+                view -> {
+                    if (canOpen && id != null) {
+                        OfflineContentAggregatorFactory.get()
+                                .openItem(new OpenParams(LaunchLocation.SUGGESTION), id);
+                    } else {
+                        openDownloads();
+                    }
+                });
+    }
+
+    // Like "45% • 2.4 MB/s", "In queue", "Paused" or "Done • 12 MB".
+    private static String getStatus(Context context, OfflineItem item) {
+        switch (item.state) {
+            case OfflineItemState.COMPLETE:
+                return join(
+                        context,
+                        context.getString(R.string.cromiko_home_download_done),
+                        item.totalSizeBytes > 0
+                                ? DownloadUtils.getStringForBytes(context, item.totalSizeBytes)
+                                : null);
+            case OfflineItemState.PAUSED:
+            case OfflineItemState.INTERRUPTED:
+                return context.getString(R.string.cromiko_home_download_paused);
+            default:
+                String waiting = CromikoDownloadStatus.getWaitText(context, item.id, false);
+                if (waiting != null) return waiting;
+                if (item.state == OfflineItemState.PENDING) {
+                    return context.getString(R.string.cromiko_home_download_pending);
+                }
+                int percent = getPercentage(item);
+                String done =
+                        percent >= 0
+                                ? NumberFormat.getPercentInstance().format(percent / 100.0)
+                                : DownloadUtils.getStringForBytes(context, item.receivedBytes);
+                return join(
+                        context,
+                        done,
+                        CromikoDownloadStatus.getSpeedText(context, item.id, false));
+        }
+    }
+
+    private static String join(Context context, String first, @Nullable String second) {
+        return second == null
+                ? first
+                : context.getString(R.string.cromiko_home_download_status, first, second);
+    }
+
+    // The progress of a download in percent, or -1 if it is not known.
+    private static int getPercentage(OfflineItem item) {
+        OfflineItem.Progress progress = item.progress;
+        return progress != null && !progress.isIndeterminate() ? progress.getPercentage() : -1;
+    }
+
+    // Whether the download runs or waits, or the user can resume it.
+    private static boolean isRunning(OfflineItem item) {
+        switch (item.state) {
+            case OfflineItemState.IN_PROGRESS:
+            case OfflineItemState.PENDING:
+            case OfflineItemState.PAUSED:
+                return true;
+            case OfflineItemState.INTERRUPTED:
+                return item.isResumable;
+            default:
+                return false;
+        }
+    }
+
+    private static long finishTime(OfflineItem item) {
+        return Math.max(item.completionTimeMs, item.creationTimeMs);
+    }
+
+    private void openDownloads() {
+        if (mOpenDownloads != null) mOpenDownloads.run();
+    }
+}
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoHomeScreen.java b/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoHomeScreen.java
