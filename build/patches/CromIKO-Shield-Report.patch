+  }
+  ScopedDictPrefUpdate update(prefs, pref);
+  update->Set(key, Add(update->FindInt(key).value_or(0), count));
+  if (update->size() > kMaxSites) {
+    // Forgets the sites with the smallest counts.
+    update.Get() = Top(*update, kSitesAfterTrim);
+  }
+}
