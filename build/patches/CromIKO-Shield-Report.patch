+package org.chromium.chrome.browser.cromiko;
+
+import android.content.Context;
+import android.util.AttributeSet;
+import android.view.View;
+import android.widget.TextView;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceViewHolder;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+
+import java.text.NumberFormat;
+
+/**
+ * CromIKO: the top of the weekly shield report: the mascot, the number of ads and trackers blocked
+ * this week, how it compares with last week, and the bars of the days.
+ */
+@NullMarked
+public class CromikoShieldReportHeader extends Preference {
+    private int mBlocked;
+    private @Nullable String mComparison;
+    private @Nullable String mLastWeek;
+    private int[] mDays = new int[7];
+    private int mToday;
+
+    /** Constructor for inflating from XML. */
+    public CromikoShieldReportHeader(Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+        setLayoutResource(R.layout.cromiko_shield_report_header);
+        setSelectable(false);
+    }
+
+    /**
+     * @param blocked The number of ads and trackers blocked this week.
+     * @param comparison How it compares with the same days of last week, or null.
+     * @param lastWeek The number blocked last week, as text, or null.
+     * @param days The counts of the days of this week, from Monday.
+     * @param today The index of today, from 0 for Monday.
+     */
+    public void setReport(
+            int blocked,
+            @Nullable String comparison,
+            @Nullable String lastWeek,
+            int[] days,
+            int today) {
+        mBlocked = blocked;
+        mComparison = comparison;
+        mLastWeek = lastWeek;
+        mDays = days.clone();
+        mToday = today;
+        notifyChanged();
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        TextView count = (TextView) holder.findViewById(R.id.cromiko_shield_report_count);
+        count.setText(NumberFormat.getIntegerInstance().format(mBlocked));
+        setText((TextView) holder.findViewById(R.id.cromiko_shield_report_comparison), mComparison);
+        setText((TextView) holder.findViewById(R.id.cromiko_shield_report_last_week), mLastWeek);
+        CromikoShieldReportChart chart =
+                (CromikoShieldReportChart) holder.findViewById(R.id.cromiko_shield_report_chart);
+        chart.setDays(mDays, mToday);
+    }
+
+    private static void setText(TextView view, @Nullable String text) {
+        view.setText(text);
+        view.setVisibility(text == null ? View.GONE : View.VISIBLE);
+    }
+}
