@@ -0,0 +1,203 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.cromiko;
+
+import android.os.Bundle;
+
+import androidx.annotation.VisibleForTesting;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import org.chromium.base.Log;
+import org.chromium.base.supplier.MonotonicObservableSupplier;
+import org.chromium.base.supplier.ObservableSuppliers;
+import org.chromium.base.supplier.SettableMonotonicObservableSupplier;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.components.browser_ui.settings.SettingsUtils;
+
+import java.text.NumberFormat;
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.List;
+
+/**
+ * CromIKO: the weekly shield report, opened from the shield card of the new tab page. It shows
+ * how many ads and trackers the ad blocker blocked this week, day by day and compared with last
+ * week, the sites where it blocked the most, and the trackers it blocked the most. The counts come
+ * from components/subresource_filter/content/browser/cromiko_shield_stats.cc.
+ */
+@NullMarked
+public class CromikoShieldReport extends ChromeBaseSettingsFragment {
+    private static final String TAG = "CromikoShield";
+
+    // The keys of the preferences in cromiko_shield_report_preferences.xml.
+    private static final String PREF_HEADER = "header";
+    private static final String PREF_SITES = "sites";
+    private static final String PREF_TRACKERS = "trackers";
+
+    // The sites and trackers listed.
+    private static final int TOP = 5;
+    // Changes smaller than this are "about the same".
+    private static final double SAME = 0.05;
+
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getString(R.string.cromiko_shield_report_title));
+        SettingsUtils.addPreferencesFromResource(this, R.xml.cromiko_shield_report_preferences);
+        JSONObject report;
+        try {
+            report = new JSONObject(CromikoShieldReportBridge.getReport(getProfile()));
+        } catch (JSONException e) {
+            Log.e(TAG, "Bad report", e);
+            report = new JSONObject();
+        }
+        showReport(report);
+    }
+
+    private void showReport(JSONObject report) {
+        int today = report.optInt("today");
+        int week = report.optInt("week");
+        int blocked = report.optInt("blocked");
+        JSONObject days = optObject(report, "days");
+        JSONObject lastWeek = report.optJSONObject("last_week");
+
+        // The days of this week and of last week, and the sums of the days before today, which
+        // are complete, to compare the same days.
+        int[] thisWeek = new int[7];
+        int thisWeekDays = 0;
+        int lastWeekDays = 0;
+        int thisWeekBeforeToday = 0;
+        int lastWeekBeforeToday = 0;
+        for (int i = 0; i < 7; i++) {
+            thisWeek[i] = days.optInt(String.valueOf(week + i));
+            int lastWeekDay = days.optInt(String.valueOf(week - 7 + i));
+            thisWeekDays += thisWeek[i];
+            lastWeekDays += lastWeekDay;
+            if (week + i < today) {
+                thisWeekBeforeToday += thisWeek[i];
+                lastWeekBeforeToday += lastWeekDay;
+            }
+        }
+
+        String comparison = null;
+        String lastWeekText = null;
+        if (lastWeek != null) {
+            int lastWeekBlocked = lastWeek.optInt("blocked");
+            lastWeekText =
+                    getString(
+                            R.string.cromiko_shield_report_last_week,
+                            NumberFormat.getIntegerInstance().format(lastWeekBlocked));
+            // Only when the days of both weeks are all there: older versions only kept the
+            // totals.
+            if (thisWeekDays == blocked
+                    && lastWeekDays == lastWeekBlocked
+                    && lastWeekBeforeToday > 0) {
+                comparison = getComparison(thisWeekBeforeToday, lastWeekBeforeToday);
+            }
+        }
+        CromikoShieldReportHeader header = (CromikoShieldReportHeader) findPreference(PREF_HEADER);
+        header.setReport(blocked, comparison, lastWeekText, thisWeek, today - week);
+
+        // Early in the week, the lists of last week say more.
+        JSONObject sites = optObject(report, "sites");
+        JSONObject trackers = optObject(report, "trackers");
+        boolean showLastWeek = sites.length() == 0 && lastWeek != null;
+        if (showLastWeek) {
+            sites = optObject(lastWeek, "sites");
+            trackers = optObject(lastWeek, "trackers");
+        }
+        fillList(
+                PREF_SITES,
+                showLastWeek
+                        ? R.string.cromiko_shield_report_sites_last_week
+                        : R.string.cromiko_shield_report_sites,
+                sites,
+                /* emptyText= */ R.string.cromiko_shield_report_empty);
+        fillList(
+                PREF_TRACKERS,
+                showLastWeek
+                        ? R.string.cromiko_shield_report_trackers_last_week
+                        : R.string.cromiko_shield_report_trackers,
+                trackers,
+                /* emptyText= */ 0);
+    }
+
+    private String getComparison(int thisWeek, int lastWeek) {
+        double change = (thisWeek - lastWeek) / (double) lastWeek;
+        if (Math.abs(change) < SAME) return getString(R.string.cromiko_shield_report_same);
+        String percent = NumberFormat.getPercentInstance().format(Math.abs(change));
+        return getString(
+                change > 0
+                        ? R.string.cromiko_shield_report_more
+                        : R.string.cromiko_shield_report_fewer,
+                percent);
+    }
+
+    // Lists the sites or trackers with the largest counts, or hides the list when it is empty
+    // and has no text for that.
+    private void fillList(String key, int title, JSONObject counts, int emptyText) {
+        PreferenceCategory category = (PreferenceCategory) findPreference(key);
+        category.setTitle(title);
+        List<String> top = getTop(counts, TOP);
+        if (top.isEmpty() && emptyText == 0) {
+            category.setVisible(false);
+            return;
+        }
+        if (top.isEmpty()) {
+            Preference empty = new Preference(getPreferenceManager().getContext());
+            empty.setSummary(emptyText);
+            empty.setSelectable(false);
+            category.addPreference(empty);
+            return;
+        }
+        NumberFormat format = NumberFormat.getIntegerInstance();
+        for (String domain : top) {
+            Preference row = new Preference(getPreferenceManager().getContext());
+            row.setTitle(domain);
+            row.setSummary(
+                    getString(
+                            R.string.cromiko_shield_report_blocked,
+                            format.format(counts.optInt(domain))));
+            row.setSelectable(false);
+            category.addPreference(row);
+        }
+    }
+
+    /** Returns the keys of |counts| with the largest counts, the largest first. */
+    @VisibleForTesting
+    static List<String> getTop(JSONObject counts, int max) {
+        List<String> keys = new ArrayList<>();
+        for (Iterator<String> it = counts.keys(); it.hasNext(); ) keys.add(it.next());
+        keys.sort(
+                (a, b) -> {
+                    int byCount = Integer.compare(counts.optInt(b), counts.optInt(a));
+                    return byCount != 0 ? byCount : a.compareTo(b);
+                });
+        return keys.size() > max ? new ArrayList<>(keys.subList(0, max)) : keys;
+    }
+
+    private static JSONObject optObject(JSONObject object, String key) {
+        JSONObject value = object.optJSONObject(key);
+        return value != null ? value : new JSONObject();
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    @Override
+    public @AnimationType int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }
+}
