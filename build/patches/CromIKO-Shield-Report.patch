+// Keeps the counts of the week before when a new week starts.
+void MaybeStartWeek(PrefService* prefs, int week) {
+  const int counted_week = prefs->GetInteger(kWeekPref);
+  if (counted_week == week) {
+    return;
+  }
+  if (prefs->GetInteger(kBlockedPref) > 0) {
+    base::DictValue last_week;
+    last_week.Set("week", counted_week);
+    last_week.Set("blocked", prefs->GetInteger(kBlockedPref));
+    last_week.Set("sites", Top(prefs->GetDict(kSitesPref), kTopSites));
+    last_week.Set("trackers", Top(prefs->GetDict(kTrackersPref), kTopSites));
+    prefs->SetDict(kLastWeekPref, std::move(last_week));
+  }
+  prefs->SetInteger(kWeekPref, week);
+  prefs->SetInteger(kBlockedPref, 0);
