+
+package org.chromium.chrome.browser.cromiko;
+
+import org.jni_zero.JniType;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.profiles.Profile;
+
+/**
+ * CromIKO: reads the weekly shield report that
+ * components/subresource_filter/content/browser/cromiko_shield_stats.cc keeps in the profile.
+ */
+@NullMarked
+public final class CromikoShieldReportBridge {
+    private CromikoShieldReportBridge() {}
+
+    /**
+     * Returns the report of the current week as JSON: "today" and "week" (day numbers, the week
+     * is the one of its Monday), "blocked", "days", "sites", "trackers" (counts by day number or
+     * by domain), and "last_week" with "blocked", "sites" and "trackers" when the week before has
+     * counts.
+     */
+    public static String getReport(Profile profile) {
+        return CromikoShieldReportBridgeJni.get().getReport(profile);
+    }
+
+    @NativeMethods
+    interface Natives {
+        @JniType("std::string")
+        String getReport(@JniType("Profile*") Profile profile);
+    }
+}
