+  }
+  std::string site = net::registry_controlled_domains::GetDomainAndRegistry(
+      url, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  return site.empty() ? std::string(url.host()) : site;
+}
+
+// The entries of `counts` with the largest counts first.
+std::vector<std::pair<std::string, int>> Sorted(const base::DictValue& counts) {
+  std::vector<std::pair<std::string, int>> sorted;
+  for (auto [key, value] : counts) {
+    if (value.is_int()) {
+      sorted.emplace_back(key, value.GetInt());
+    }
+  }
+  std::stable_sort(
+      sorted.begin(), sorted.end(),
+      [](const auto& a, const auto& b) { return a.second > b.second; });
+  return sorted;
+}
+
+base::DictValue Top(const base::DictValue& counts, size_t max) {
+  std::vector<std::pair<std::string, int>> sorted = Sorted(counts);
+  base::DictValue top;
+  for (size_t i = 0; i < sorted.size() && i < max; i++) {
+    top.Set(sorted[i].first, sorted[i].second);
+  }
+  return top;
+}
+
+void AddTo(PrefService* prefs, const char* pref, const std::string& key,
+           int count) {
+  if (key.empty()) {
