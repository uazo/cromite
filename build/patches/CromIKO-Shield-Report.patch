@@ -0,0 +1,116 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.cromiko;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.graphics.Typeface;
+import android.util.AttributeSet;
+import android.util.TypedValue;
+import android.view.View;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.components.browser_ui.styles.SemanticColorUtils;
+
+import java.text.NumberFormat;
+import java.time.DayOfWeek;
+import java.time.format.TextStyle;
+import java.util.Locale;
+
+/**
+ * CromIKO: the bars of the weekly shield report, one per day from Monday to Sunday, with the
+ * number of ads and trackers blocked that day. Today is in the CromIKO accent color, the days
+ * before it lighter, and the days to come are empty.
+ */
+@NullMarked
+public class CromikoShieldReportChart extends View {
+    private static final int DAYS = 7;
+
+    private final Paint mBarPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mLabelPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF mBar = new RectF();
+    private final String[] mLabels = new String[DAYS];
+    private final float mDensity;
+    private final int mAccentColor;
+    private int[] mCounts = new int[DAYS];
+    // The index of today, from 0 for Monday.
+    private int mToday = -1;
+
+    /** Constructor for inflating from XML. */
+    public CromikoShieldReportChart(Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+        mDensity = getResources().getDisplayMetrics().density;
+        mAccentColor = context.getColor(R.color.cromiko_accent_color);
+        mLabelPaint.setTextAlign(Paint.Align.CENTER);
+        mLabelPaint.setTextSize(
+                TypedValue.applyDimension(
+                        TypedValue.COMPLEX_UNIT_SP, 12, getResources().getDisplayMetrics()));
+        mLabelPaint.setColor(SemanticColorUtils.getDefaultTextColorSecondary(context));
+        for (int i = 0; i < DAYS; i++) {
+            mLabels[i] =
+                    DayOfWeek.of(i + 1).getDisplayName(TextStyle.NARROW, Locale.getDefault());
+        }
+    }
+
+    /**
+     * @param counts The counts of the days, from Monday.
+     * @param today The index of today, from 0 for Monday.
+     */
+    public void setDays(int[] counts, int today) {
+        mCounts = counts.clone();
+        mToday = today;
+        // TalkBack reads the counts of the days until today.
+        StringBuilder description = new StringBuilder();
+        NumberFormat format = NumberFormat.getIntegerInstance();
+        for (int i = 0; i <= today && i < DAYS; i++) {
+            if (description.length() > 0) description.append(", ");
+            description.append(
+                    getContext()
+                            .getString(
+                                    R.string.cromiko_shield_report_chart_day,
+                                    DayOfWeek.of(i + 1)
+                                            .getDisplayName(TextStyle.FULL, Locale.getDefault()),
+                                    format.format(mCounts[i])));
+        }
+        setContentDescription(description.toString());
+        invalidate();
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        float labelHeight = mLabelPaint.getTextSize() + 8 * mDensity;
+        float top = getPaddingTop();
+        float bottom = getHeight() - getPaddingBottom() - labelHeight;
+        float slot = (getWidth() - getPaddingLeft() - getPaddingRight()) / (float) DAYS;
+        float barWidth = Math.min(slot * 0.5f, 28 * mDensity);
+        float radius = Math.min(barWidth / 2, 8 * mDensity);
+        int max = 1;
+        for (int count : mCounts) max = Math.max(max, count);
+
+        for (int i = 0; i < DAYS; i++) {
+            // Right to left languages start the week on the right.
+            int position = getLayoutDirection() == LAYOUT_DIRECTION_RTL ? DAYS - 1 - i : i;
+            float center = getPaddingLeft() + slot * (position + 0.5f);
+            boolean future = i > mToday;
+            // Days without blocks still show a small bar, to see the week.
+            float height =
+                    future
+                            ? 0
+                            : Math.max(4 * mDensity, (bottom - top) * mCounts[i] / (float) max);
+            if (height > 0) {
+                mBarPaint.setColor(mAccentColor);
+                mBarPaint.setAlpha(i == mToday ? 255 : 110);
+                mBar.set(center - barWidth / 2, bottom - height, center + barWidth / 2, bottom);
+                canvas.drawRoundRect(mBar, radius, radius, mBarPaint);
+            }
+            mLabelPaint.setTypeface(i == mToday ? Typeface.DEFAULT_BOLD : Typeface.DEFAULT);
+            canvas.drawText(mLabels[i], center, getHeight() - getPaddingBottom(), mLabelPaint);
