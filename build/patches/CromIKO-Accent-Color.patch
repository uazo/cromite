diff --git a/chrome/android/java/res/layout/cromiko_accent_custom.xml b/chrome/android/java/res/layout/cromiko_accent_custom.xml
new file mode 100644
--- /dev/null
+++ b/chrome/android/java/res/layout/cromiko_accent_custom.xml
@@ -0,0 +1,76 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+Copyright 2026 The CromIKO Authors
+License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+-->
+
+<!-- The custom accent color dialog, see CromikoAccentSettings.CustomColor. -->
+<LinearLayout
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:orientation="vertical"
+    android:paddingStart="24dp"
+    android:paddingTop="8dp"
+    android:paddingEnd="24dp">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:gravity="center_vertical"
+        android:orientation="horizontal">
+
+        <View
+            android:id="@+id/cromiko_accent_custom_preview"
+            android:layout_width="56dp"
+            android:layout_height="56dp" />
+
+        <EditText
+            android:id="@+id/cromiko_accent_custom_hex"
+            android:layout_width="0dp"
+            android:layout_height="wrap_content"
+            android:layout_marginStart="16dp"
+            android:layout_weight="1"
+            android:digits="#0123456789abcdefABCDEF"
+            android:hint="@string/cromiko_accent_hex"
+            android:importantForAutofill="no"
+            android:inputType="textCapCharacters|textNoSuggestions"
+            android:maxLength="7"
+            android:singleLine="true"
+            android:textAppearance="@style/TextAppearance.TextLarge.Primary" />
+    </LinearLayout>
+
+    <TextView
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="20dp"
+        android:labelFor="@+id/cromiko_accent_custom_hue"
+        android:text="@string/cromiko_accent_hue"
+        android:textAppearance="@style/TextAppearance.TextMedium.Secondary" />
+
+    <SeekBar
+        android:id="@+id/cromiko_accent_custom_hue"
+        android:layout_width="match_parent"
+        android:layout_height="48dp"
+        android:max="359"
+        android:maxHeight="12dp"
+        android:minHeight="12dp"
+        android:splitTrack="false" />
+
+    <TextView
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="8dp"
+        android:labelFor="@+id/cromiko_accent_custom_vividness"
+        android:text="@string/cromiko_accent_vividness"
+        android:textAppearance="@style/TextAppearance.TextMedium.Secondary" />
+
+    <SeekBar
+        android:id="@+id/cromiko_accent_custom_vividness"
+        android:layout_width="match_parent"
+        android:layout_height="48dp"
+        android:max="100"
+        android:maxHeight="12dp"
+        android:minHeight="12dp"
+        android:splitTrack="false" />
+</LinearLayout>
