+package org.chromium.chrome.browser.cromiko;
+
+import android.annotation.SuppressLint;
+import android.content.Context;
+import android.graphics.Color;
+import android.graphics.drawable.GradientDrawable;
+import android.os.Bundle;
+import android.text.Editable;
+import android.text.TextWatcher;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.widget.Button;
+import android.widget.EditText;
+import android.widget.SeekBar;
+
+import androidx.annotation.ColorInt;
+import androidx.appcompat.app.AlertDialog;
+
+import org.chromium.base.supplier.MonotonicObservableSupplier;
+import org.chromium.base.supplier.ObservableSuppliers;
+import org.chromium.base.supplier.SettableMonotonicObservableSupplier;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.components.browser_ui.settings.SettingsUtils;
+
+/**
+ * CromIKO: Settings > Appearance > Accent color. The user picks one of the colors of
+ * CromikoAccentPicker, or a custom one with the hue and vividness sliders or a hex code; the
+ * browser restarts its windows in the new color. See CromikoAccent.
+ */
+@NullMarked
+public class CromikoAccentSettings extends ChromeBaseSettingsFragment {
+    // The keys of the preferences in cromiko_accent_preferences.xml.
+    private static final String PREF_PICKER = "picker";
+    private static final String PREF_UNAVAILABLE = "unavailable";
+
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getString(R.string.cromiko_accent_title));
+        SettingsUtils.addPreferencesFromResource(this, R.xml.cromiko_accent_preferences);
+        CromikoAccentPicker picker = (CromikoAccentPicker) findPreference(PREF_PICKER);
+        picker.setListener(
+                new CromikoAccentPicker.Listener() {
+                    @Override
+                    public void onColorPicked(@ColorInt int color) {
+                        CromikoAccent.setColor(color);
+                    }
+
+                    @Override
+                    public void onCustomClicked() {
+                        showCustomDialog();
+                    }
+                });
+        findPreference(PREF_UNAVAILABLE).setVisible(!CromikoAccent.isAvailable());
+    }
+
+    @SuppressLint("InflateParams")
+    private void showCustomDialog() {
+        Context context = getPreferenceManager().getContext();
+        View view = LayoutInflater.from(context).inflate(R.layout.cromiko_accent_custom, null);
+        CustomColor custom =
+                new CustomColor(
+                        view.findViewById(R.id.cromiko_accent_custom_preview),
+                        view.findViewById(R.id.cromiko_accent_custom_hex),
+                        view.findViewById(R.id.cromiko_accent_custom_hue),
+                        view.findViewById(R.id.cromiko_accent_custom_vividness),
+                        CromikoAccent.getColor());
+        AlertDialog dialog =
+                new AlertDialog.Builder(context, R.style.ThemeOverlay_BrowserUI_AlertDialog)
+                        .setTitle(R.string.cromiko_accent_custom_title)
+                        .setView(view)
+                        .setPositiveButton(
+                                R.string.cromiko_accent_use_color,
+                                (unused, which) -> {
+                                    Integer color = custom.getColor();
+                                    if (color != null) CromikoAccent.setColor(color);
+                                })
+                        .setNegativeButton(R.string.cancel, null)
+                        .create();
+        dialog.setOnShowListener(
+                unused -> custom.setUseButton(dialog.getButton(AlertDialog.BUTTON_POSITIVE)));
+        dialog.show();
+    }
+
+    /** The views of the custom color dialog, which follow each other. */
+    static final class CustomColor {
+        private final View mPreview;
+        private final EditText mHex;
+        private final SeekBar mHue;
+        private final SeekBar mVividness;
+        private final GradientDrawable mPreviewCircle = new GradientDrawable();
+        private final GradientDrawable mVividnessTrack = new GradientDrawable();
+        private @Nullable Button mUseButton;
+        // The color as hue, saturation and value; the sliders keep the value.
+        private final float[] mHsv = new float[3];
+        private boolean mValid = true;
+        private boolean mUpdating;
+
+        CustomColor(View preview, EditText hex, SeekBar hue, SeekBar vividness, int color) {
+            mPreview = preview;
+            mHex = hex;
+            mHue = hue;
+            mVividness = vividness;
+            mPreviewCircle.setShape(GradientDrawable.OVAL);
+            mPreview.setBackground(mPreviewCircle);
+
+            GradientDrawable hueTrack =
+                    new GradientDrawable(
+                            GradientDrawable.Orientation.LEFT_RIGHT, CromikoAccentPicker.rainbow());
+            float radius = 8 * preview.getResources().getDisplayMetrics().density;
+            hueTrack.setCornerRadius(radius);
+            mHue.setProgressDrawable(hueTrack);
+            mVividnessTrack.setOrientation(GradientDrawable.Orientation.LEFT_RIGHT);
+            mVividnessTrack.setCornerRadius(radius);
+            mVividness.setProgressDrawable(mVividnessTrack);
+
+            Color.colorToHSV(color, mHsv);
+            update(/* fromHex= */ false);
+
+            SeekBar.OnSeekBarChangeListener sliders =
+                    new SeekBar.OnSeekBarChangeListener() {
+                        @Override
+                        public void onProgressChanged(SeekBar bar, int progress, boolean byUser) {
+                            if (!byUser) return;
+                            mHsv[0] = mHue.getProgress();
+                            mHsv[1] = mVividness.getProgress() / 100f;
+                            // A black or gray color has no hue to show: give it some light.
+                            mHsv[2] = Math.max(mHsv[2], 0.5f);
+                            update(/* fromHex= */ false);
+                        }
+
+                        @Override
+                        public void onStartTrackingTouch(SeekBar bar) {}
+
+                        @Override
+                        public void onStopTrackingTouch(SeekBar bar) {}
+                    };
+            mHue.setOnSeekBarChangeListener(sliders);
+            mVividness.setOnSeekBarChangeListener(sliders);
+
+            mHex.addTextChangedListener(
+                    new TextWatcher() {
+                        @Override
+                        public void beforeTextChanged(
+                                CharSequence s, int start, int count, int after) {}
+
+                        @Override
+                        public void onTextChanged(
+                                CharSequence s, int start, int before, int count) {}
+
+                        @Override
+                        public void afterTextChanged(Editable text) {
+                            if (mUpdating) return;
+                            Integer parsed = CromikoAccent.parseHex(text.toString());
+                            mValid = parsed != null;
+                            if (parsed != null) {
+                                Color.colorToHSV(parsed, mHsv);
+                                update(/* fromHex= */ true);
+                            }
+                            if (mUseButton != null) mUseButton.setEnabled(mValid);
+                        }
+                    });
+        }
+
+        void setUseButton(Button useButton) {
+            mUseButton = useButton;
+            mUseButton.setEnabled(mValid);
+        }
+
+        /** Returns the color, or null while the hex code is not valid. */
+        @Nullable Integer getColor() {
+            return mValid ? Color.HSVToColor(mHsv) : null;
+        }
+
+        private void update(boolean fromHex) {
+            mUpdating = true;
+            @ColorInt int color = Color.HSVToColor(mHsv);
+            mPreviewCircle.setColor(color);
+            mHue.setProgress(Math.round(mHsv[0]));
+            mVividness.setProgress(Math.round(mHsv[1] * 100));
+            mVividnessTrack.setColors(
+                    new int[] {
+                        Color.HSVToColor(new float[] {mHsv[0], 0f, mHsv[2]}),
+                        Color.HSVToColor(new float[] {mHsv[0], 1f, mHsv[2]})
+                    });
+            if (!fromHex) {
+                mHex.setText(CromikoAccent.toHex(color));
+                mHex.setSelection(mHex.length());
+                mValid = true;
+                if (mUseButton != null) mUseButton.setEnabled(true);
+            }
+            mUpdating = false;
+        }
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    @Override
+    public @AnimationType int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }
+
+    @Override
+    public @Nullable String getMainMenuKey() {
+        return "appearance";
+    }
+}
