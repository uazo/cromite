diff --git a/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoAccent.java b/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoAccent.java
new file mode 100644
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoAccent.java
@@ -0,0 +1,147 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.cromiko;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import androidx.annotation.ColorInt;
+import androidx.annotation.StringRes;
+
+import com.google.android.material.color.DynamicColors;
+
+import org.chromium.base.ApplicationStatus;
+import org.chromium.base.ContextUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.ntp_customization.NtpCustomizationUtils;
+
+import java.util.Locale;
+
+/**
+ * CromIKO: the accent color of the browser, picked in Settings > Appearance > Accent color
+ * (CromikoAccentSettings). Periwinkle, the default, is the brand palette of CromIKO-Theme.patch;
+ * any other color becomes the seed of a Material palette, like the theme colors of "Customize new
+ * tab page", and wins over them. The mascot and the logo keep their periwinkle star.
+ */
+@NullMarked
+public final class CromikoAccent {
+    /** A color of the picker. */
+    public static final class Preset {
+        public final @StringRes int name;
+        public final @ColorInt int color;
+
+        Preset(@StringRes int name, @ColorInt int color) {
+            this.name = name;
+            this.color = color;
+        }
+    }
+
+    /** The CromIKO periwinkle, the color of the logo. */
+    public static final @ColorInt int DEFAULT_COLOR = 0xFF5C7CFC;
+
+    // Colors that go with the charcoal of the mascot, as seeds of Material palettes.
+    private static final Preset[] PRESETS = {
+        new Preset(R.string.cromiko_accent_periwinkle, DEFAULT_COLOR),
+        new Preset(R.string.cromiko_accent_lavender, 0xFF9D7BEA),
+        new Preset(R.string.cromiko_accent_grape, 0xFFB565D6),
+        new Preset(R.string.cromiko_accent_rose, 0xFFE0607E),
+        new Preset(R.string.cromiko_accent_coral, 0xFFF07A5A),
+        new Preset(R.string.cromiko_accent_amber, 0xFFE9A23B),
+        new Preset(R.string.cromiko_accent_lime, 0xFF8DBA3E),
+        new Preset(R.string.cromiko_accent_mint, 0xFF34B98A),
+        new Preset(R.string.cromiko_accent_teal, 0xFF23A6B0),
+        new Preset(R.string.cromiko_accent_sky, 0xFF3D9FE8),
+        new Preset(R.string.cromiko_accent_slate, 0xFF6B7A90),
+    };
+
+    private static final String ACCENT_PREF = "cromiko_accent_color";
+
+    private CromikoAccent() {}
+
+    /** Returns the colors of the picker, periwinkle first. */
+    public static Preset[] getPresets() {
+        return PRESETS.clone();
+    }
+
+    /** Returns the accent color, opaque. */
+    public static @ColorInt int getColor() {
+        return prefs().getInt(ACCENT_PREF, DEFAULT_COLOR) | 0xFF000000;
+    }
+
+    /** Returns the accent color like "#5C7CFC", for the page scripts. */
+    public static String getHex() {
+        return toHex(getColor());
+    }
+
+    /**
+     * Sets the accent color and recreates the activities to show it.
+     *
+     * @param color The color; its alpha is ignored.
+     */
+    public static void setColor(@ColorInt int color) {
+        color |= 0xFF000000;
+        if (color == getColor()) return;
+        if (color == DEFAULT_COLOR) {
+            prefs().edit().remove(ACCENT_PREF).apply();
+        } else {
+            prefs().edit().putInt(ACCENT_PREF, color).apply();
+        }
+        for (Activity activity : ApplicationStatus.getRunningActivities()) {
+            if (!activity.isFinishing()) activity.recreate();
+        }
+    }
+
+    /** Whether the phone can show other accent colors than periwinkle (Android 12 and newer). */
+    public static boolean isAvailable() {
+        return DynamicColors.isDynamicColorAvailable();
+    }
+
+    /**
+     * Applies the accent color to an activity that is being created, before its views.
+     *
+     * @return Whether an accent color other than periwinkle was applied.
+     */
+    public static boolean applyToActivity(Activity activity) {
+        @ColorInt int color = getColor();
+        if (color == DEFAULT_COLOR || !isAvailable()) return false;
+        NtpCustomizationUtils.applyDynamicColorToActivity(activity, color);
+        return true;
+    }
+
+    /** Returns the preset of |color|, or null for a custom color. */
+    public static @Nullable Preset findPreset(@ColorInt int color) {
+        for (Preset preset : PRESETS) {
+            if (preset.color == (color | 0xFF000000)) return preset;
+        }
+        return null;
+    }
+
+    /** Returns the name of |color|, like "Periwinkle" or "Custom (#3A7BD5)". */
+    public static String getName(Context context, @ColorInt int color) {
+        Preset preset = findPreset(color);
+        return preset != null
+                ? context.getString(preset.name)
+                : context.getString(R.string.cromiko_accent_custom_color, toHex(color));
+    }
+
+    /** Returns |color| like "#5C7CFC". */
+    public static String toHex(@ColorInt int color) {
+        return String.format(Locale.US, "#%06X", color & 0xFFFFFF);
+    }
+
+    /** Returns the opaque color of a text like "#5C7CFC" or "5c7cfc", or null if it is not one. */
+    public static @Nullable Integer parseHex(String text) {
+        String hex = text.trim();
+        if (hex.startsWith("#")) hex = hex.substring(1);
+        if (!hex.matches("[0-9a-fA-F]{6}")) return null;
+        return Integer.parseInt(hex, 16) | 0xFF000000;
+    }
+
+    private static SharedPreferences prefs() {
+        return ContextUtils.getAppSharedPreferences();
+    }
+}
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoAccentPicker.java b/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoAccentPicker.java
new file mode 100644
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoAccentPicker.java
@@ -0,0 +1,139 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.cromiko;
+
+import android.content.Context;
+import android.graphics.Color;
+import android.graphics.drawable.GradientDrawable;
+import android.util.AttributeSet;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.widget.GridLayout;
+import android.widget.ImageView;
+import android.widget.TextView;
+
+import androidx.annotation.ColorInt;
+import androidx.core.graphics.ColorUtils;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceViewHolder;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.cromiko.CromikoAccent.Preset;
+import org.chromium.components.browser_ui.styles.SemanticColorUtils;
+
+/**
+ * CromIKO: the colors of Settings > Appearance > Accent color, under the mascot: the presets, and
+ * "Custom", which opens the custom color dialog of CromikoAccentSettings.
+ */
+@NullMarked
+public class CromikoAccentPicker extends Preference {
+    /** Called when the user picks a color. */
+    public interface Listener {
+        void onColorPicked(@ColorInt int color);
+
+        void onCustomClicked();
+    }
+
+    private @Nullable Listener mListener;
+
+    /** Constructor for inflating from XML. */
+    public CromikoAccentPicker(Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+        setLayoutResource(R.layout.cromiko_accent_picker);
+        setSelectable(false);
+    }
+
+    public void setListener(Listener listener) {
+        mListener = listener;
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        GridLayout grid = (GridLayout) holder.findViewById(R.id.cromiko_accent_grid);
+        grid.removeAllViews();
+        @ColorInt int current = CromikoAccent.getColor();
+        boolean isCustom = CromikoAccent.findPreset(current) == null;
+        for (Preset preset : CromikoAccent.getPresets()) {
+            addSwatch(
+                    grid,
+                    getContext().getString(preset.name),
+                    circle(preset.color),
+                    preset.color,
+                    preset.color == current,
+                    view -> {
+                        if (mListener != null) mListener.onColorPicked(preset.color);
+                    });
+        }
+        // A rainbow, or the custom color when there is one.
+        GradientDrawable custom = isCustom ? circle(current) : circle(Color.WHITE);
+        if (!isCustom) {
+            custom.setGradientType(GradientDrawable.SWEEP_GRADIENT);
+            custom.setColors(rainbow());
+        }
+        addSwatch(
+                grid,
+                getContext().getString(R.string.cromiko_accent_custom),
+                custom,
+                current,
+                isCustom,
+                view -> {
+                    if (mListener != null) mListener.onCustomClicked();
+                });
+    }
+
+    private void addSwatch(
+            GridLayout grid,
+            String name,
+            GradientDrawable circle,
+            @ColorInt int color,
+            boolean selected,
+            View.OnClickListener onClick) {
+        Context context = getContext();
+        View swatch =
+                LayoutInflater.from(context).inflate(R.layout.cromiko_accent_swatch, grid, false);
+        View dot = swatch.findViewById(R.id.cromiko_accent_swatch_color);
+        if (selected) {
+            float density = context.getResources().getDisplayMetrics().density;
+            circle.setStroke(
+                    Math.round(3 * density), SemanticColorUtils.getDefaultTextColor(context));
+        }
+        dot.setBackground(circle);
+        ImageView check = swatch.findViewById(R.id.cromiko_accent_swatch_check);
+        check.setVisibility(selected ? View.VISIBLE : View.GONE);
+        // A dark check on light colors, a white one on dark colors.
+        check.setColorFilter(
+                ColorUtils.calculateLuminance(color) > 0.5 ? Color.BLACK : Color.WHITE);
+        TextView label = swatch.findViewById(R.id.cromiko_accent_swatch_name);
+        label.setText(name);
+        swatch.setContentDescription(
+                selected ? context.getString(R.string.cromiko_accent_selected, name) : name);
+        swatch.setOnClickListener(onClick);
+
+        GridLayout.LayoutParams params =
+                new GridLayout.LayoutParams(
+                        GridLayout.spec(GridLayout.UNDEFINED),
+                        GridLayout.spec(GridLayout.UNDEFINED, 1f));
+        params.width = 0;
+        grid.addView(swatch, params);
+    }
+
+    private static GradientDrawable circle(@ColorInt int color) {
+        GradientDrawable circle = new GradientDrawable();
+        circle.setShape(GradientDrawable.OVAL);
+        circle.setColor(color);
+        return circle;
+    }
+
+    /** Returns the colors of a rainbow, from red back to red. */
+    static int[] rainbow() {
+        int[] colors = new int[7];
+        for (int i = 0; i < colors.length; i++) {
+            colors[i] = Color.HSVToColor(new float[] {i * 60f % 360f, 0.75f, 0.95f});
+        }
+        return colors;
+    }
+}
