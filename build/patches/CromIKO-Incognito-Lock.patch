     /** Performs cleanup. Should be called when the owning activity/fragment is destroyed. */
+    /**
+     * CromIKO: sets up the choice of how long the user can leave the app before the incognito tabs
+     * lock. While the lock is on, changing it needs the screen lock, like turning the lock off.
+     */
+    public void setUpLockDelayPreference(Activity activity, ListPreference preference) {
+        if (!IncognitoReauthManager.isIncognitoReauthFeatureAvailable()) {
+            preference.setVisible(false);
+            return;
+        }
+        long[] delays = IncognitoReauthManager.LOCK_DELAYS_MS;
+        String[] entries = new String[delays.length];
+        String[] values = new String[delays.length];
+        for (int i = 0; i < delays.length; i++) {
+            int minutes = (int) (delays[i] / DateUtils.MINUTE_IN_MILLIS);
+            values[i] = String.valueOf(delays[i]);
+            if (minutes == 0) {
+                entries[i] = activity.getString(R.string.cromiko_incognito_lock_immediately);
+            } else if (minutes == 1) {
+                entries[i] = activity.getString(R.string.cromiko_incognito_lock_after_one_minute);
+            } else {
+                entries[i] =
+                        activity.getString(R.string.cromiko_incognito_lock_after_minutes, minutes);
+            }
+        }
+        preference.setEntries(entries);
+        preference.setEntryValues(values);
+        preference.setValue(String.valueOf(IncognitoReauthManager.getLockDelayMs()));
+        preference.setSummaryProvider(ListPreference.SimpleSummaryProvider.getInstance());
+        preference.setOnPreferenceChangeListener(
+                (changed, newValue) -> {
+                    long delayMs = Long.parseLong((String) newValue);
+                    if (!IncognitoReauthManager.isIncognitoReauthEnabled(mProfile)) {
+                        IncognitoReauthManager.setLockDelayMs(delayMs);
+                        return true;
+                    }
+                    if (mIncognitoReauthManager == null) {
+                        mIncognitoReauthManager = new IncognitoReauthManager(activity, mProfile);
+                    }
+                    mIncognitoReauthManager.startReauthenticationFlow(
+                            new IncognitoReauthManager.IncognitoReauthCallback() {
+                                @Override
+                                public void onIncognitoReauthNotPossible() {}
+
+                                @Override
+                                public void onIncognitoReauthSuccess() {
+                                    IncognitoReauthManager.setLockDelayMs(delayMs);
+                                    preference.setValue(String.valueOf(delayMs));
+                                }
+
+                                @Override
+                                public void onIncognitoReauthFailure() {}
+                            });
+                    // The value changes after the user unlocked.
+                    return false;
+                });
+    }
+
     public void destroy() {
         if (mIncognitoReauthManager != null) {
             mIncognitoReauthManager.destroy();
