+/* Copyright 2026 The CromIKO Authors
+ * License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+:host {
+  --cromiko-logo-ink: #1E212A;
+  --cromiko-logo-accent: #5C7CFC;
+  display: flex;
+  justify-content: center;
+}
+
+/* On dark themes and the colors of Customize Chrome, like the Google logo. */
+:host([single-colored]) {
+  --cromiko-logo-ink: var(--ntp-logo-color, white);
+  --cromiko-logo-accent: #8FA4FF;
+}
+
+#logo {
+  display: block;
+  height: 82px;
+  overflow: visible;
+  width: 281px;
+}
+
+.ink {
+  fill: var(--cromiko-logo-ink);
+}
+
+.accent {
+  fill: var(--cromiko-logo-accent);
+}
+
+/* The mascot floats up a little and the star twinkles when the pointer is
+   on the logo. */
+#mascot,
+#star {
+  transform-box: fill-box;
+  transform-origin: center;
+  transition: transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
+}
+
+:host(:hover) #mascot {
+  transform: translateY(-4%) rotate(-3deg);
+}
+
+:host(:hover) #star {
+  transform: rotate(72deg) scale(1.25);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  #mascot,
+  #star {
+    transition: none;
+  }
+
+  :host(:hover) #mascot,
+  :host(:hover) #star {
+    transform: none;
+  }
+}
