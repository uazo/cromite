+++ b/chrome/browser/resources/new_tab_page/cromiko_shield.ts
@@ -0,0 +1,77 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+import {loadTimeData} from 'chrome://resources/js/load_time_data.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './cromiko_shield.css.js';
+import {getHtml} from './cromiko_shield.html.js';
+
+// A day of the chart of the week on the shield card.
+export interface CromikoShieldDay {
+  // The first letter of the day, in the language of the page.
+  letter: string;
+  // The count of the day, as a part of the highest count of the week.
+  height: number;
+  isToday: boolean;
+  // A day of the week that has not come yet.
+  isFuture: boolean;
+}
+
+// CromIKO: the shield card of the new tab page and the CromIKO shortcuts
+// under it, like on Android. The card shows how many ads and trackers the ad
+// blocker blocked since Monday, with a small chart of the days of the week,
+// and opens the ad blocker settings. The counts come from
+// cromiko_shield_stats.cc through the strings of the page, so they are those
+// of the moment the page opened.
+export class CromikoShieldElement extends CrLitElement {
+  static get is() {
+    return 'ntp-cromiko-shield';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      count_: {type: String},
+      days_: {type: Array},
+    };
+  }
+
+  protected accessor count_: string =
+      loadTimeData.getString('cromikoShieldCount');
+  protected accessor days_: CromikoShieldDay[] = getDays(
+      loadTimeData.getString('cromikoShieldDays'),
+      document.documentElement.lang);
+}
+
+// The days of the chart from the counts of Monday to Sunday ("12,40,7,-1,..."),
+// -1 for the days to come.
+export function getDays(counts: string, lang: string): CromikoShieldDay[] {
+  const values = counts.split(',').map(Number);
+  const highest = Math.max(1, ...values);
+  const today = values.findLastIndex(value => value >= 0);
+  const format = new Intl.DateTimeFormat(
+      lang || undefined, {weekday: 'narrow', timeZone: 'UTC'});
+  return values.map((value, i) => ({
+                       // 2024-01-01 was a Monday.
+                       letter: format.format(new Date(Date.UTC(2024, 0, 1 + i))),
+                       height: Math.max(0, value) / highest,
+                       isToday: i === today,
+                       isFuture: value < 0,
+                     }));
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'ntp-cromiko-shield': CromikoShieldElement;
+  }
+}
+
+customElements.define(CromikoShieldElement.is, CromikoShieldElement);
