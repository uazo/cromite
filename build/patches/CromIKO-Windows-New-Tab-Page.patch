diff --git a/chrome/browser/resources/new_tab_page/cromiko_logo.ts b/chrome/browser/resources/new_tab_page/cromiko_logo.ts
new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/new_tab_page/cromiko_logo.ts
@@ -0,0 +1,44 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './cromiko_logo.css.js';
+import {getHtml} from './cromiko_logo.html.js';
+
+// CromIKO: the CromIKO logo (the mascot and the wordmark) at the top of the
+// new tab page, for every search engine, instead of the Google logo and
+// doodles. It is single-colored like the Google logo on dark themes and on
+// the colors of Customize Chrome: the ink takes --ntp-logo-color of the page.
+export class CromikoLogoElement extends CrLitElement {
+  static get is() {
+    return 'ntp-cromiko-logo';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      singleColored: {
+        reflect: true,
+        type: Boolean,
+      },
+    };
+  }
+
+  accessor singleColored: boolean = false;
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'ntp-cromiko-logo': CromikoLogoElement;
+  }
+}
+
+customElements.define(CromikoLogoElement.is, CromikoLogoElement);
diff --git a/chrome/browser/resources/new_tab_page/cromiko_shield.css b/chrome/browser/resources/new_tab_page/cromiko_shield.css
new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/new_tab_page/cromiko_shield.css
@@ -0,0 +1,187 @@
+/* Copyright 2026 The CromIKO Authors
+ * License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html */
+
+/* #css_wrapper_metadata_start
+ * #type=style-lit
+ * #scheme=relative
+ * #css_wrapper_metadata_end */
+
+:host {
+  --cromiko-accent: var(--color-sys-primary, #5C7CFC);
+  --cromiko-card: var(--color-new-tab-page-module-background, white);
+  --cromiko-ink: var(--color-new-tab-page-primary-foreground, #1F1F1F);
+  --cromiko-secondary: var(--color-new-tab-page-secondary-foreground, #474747);
+  --cromiko-tint: color-mix(in srgb, var(--cromiko-accent) 14%, var(--cromiko-card));
+  align-items: center;
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  width: var(--ntp-search-box-width, 561px);
+}
+
+a {
+  color: var(--cromiko-ink);
+  outline: none;
+  text-decoration: none;
+}
+
+a:focus-visible {
+  box-shadow: 0 0 0 2px var(--color-new-tab-page-focus-ring, var(--cromiko-accent));
+}
+
+.ink {
+  fill: var(--cromiko-ink);
+}
+
+.star {
+  fill: var(--cromiko-accent);
+}
+
+.stroke {
+  fill: none;
+  stroke: var(--cromiko-ink);
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  stroke-width: 2.6px;
+}
+
+/* The shield card. */
+#card {
+  align-items: center;
+  background: var(--cromiko-card);
+  border-radius: 24px;
+  box-sizing: border-box;
+  display: flex;
+  gap: 16px;
+  padding: 14px 22px 14px 14px;
+  transition: background-color 150ms;
+  width: 100%;
+}
+
+#card:hover {
+  background: color-mix(in srgb, var(--cromiko-accent) 6%, var(--cromiko-card));
+}
+
+#icon {
+  align-items: center;
+  background: var(--cromiko-tint);
+  border-radius: 18px;
+  display: flex;
+  flex: none;
+  height: 56px;
+  justify-content: center;
+  width: 56px;
+}
+
+#icon svg {
+  height: 32px;
+  width: 32px;
+}
+
+#text {
+  flex: 1;
+  min-width: 0;
+}
+
+#count {
+  font-size: 28px;
+  font-variant-numeric: tabular-nums;
+  font-weight: 500;
+  letter-spacing: -0.5px;
+  line-height: 34px;
+}
+
+#label {
+  color: var(--cromiko-secondary);
+  font-size: 13px;
+  line-height: 18px;
+}
+
+/* The chart of the week, from Monday to Sunday. */
+#week {
+  align-items: flex-end;
+  display: flex;
+  flex: none;
+  gap: 6px;
+}
+
+.day {
+  align-items: center;
+  display: flex;
+  flex-direction: column;
+  gap: 5px;
+}
+
+.track {
+  align-items: flex-end;
+  display: flex;
+  height: 34px;
+}
+
+.bar {
+  background: color-mix(in srgb, var(--cromiko-accent) 40%, transparent);
+  border-radius: 4px;
+  height: max(4px, calc(var(--height) * 34px));
+  transition: height 300ms ease-out;
+  width: 8px;
+}
+
+.today .bar {
+  background: var(--cromiko-accent);
+}
+
+.future .bar {
+  background: color-mix(in srgb, var(--cromiko-secondary) 22%, transparent);
+  height: 4px;
+}
+
+.letter {
+  color: var(--cromiko-secondary);
+  font-size: 10px;
+  line-height: 12px;
+}
+
+.today .letter {
+  color: var(--cromiko-accent);
+  font-weight: 700;
+}
+
+/* The CromIKO shortcuts. */
+#shortcuts {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+  justify-content: center;
+}
+
+.shortcut {
+  align-items: center;
+  background: var(--cromiko-card);
+  border-radius: 22px;
+  display: inline-flex;
+  font-size: 13px;
+  font-weight: 500;
+  gap: 10px;
+  height: 44px;
+  padding: 0 18px 0 6px;
+  transition: background-color 150ms;
+}
+
+.shortcut:hover {
+  background: color-mix(in srgb, var(--cromiko-accent) 8%, var(--cromiko-card));
+}
+
+.shortcut-icon {
+  align-items: center;
+  background: var(--cromiko-tint);
+  border-radius: 50%;
+  display: flex;
+  height: 32px;
+  justify-content: center;
+  width: 32px;
+}
+
+.shortcut-icon svg {
+  height: 20px;
+  width: 20px;
+}
