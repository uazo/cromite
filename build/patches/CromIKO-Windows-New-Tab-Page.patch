+// CromIKO: the strings of the CromIKO logo, the shield card and the CromIKO
+// shortcuts of the new tab page. The card shows the ads and trackers blocked
+// this week, and the counts of the days from Monday to Sunday ("12,40,7,-1,...")
+// with -1 for the days to come.
+void AddCromikoStrings(content::WebUIDataSource* source, Profile* profile) {
+  source->AddString("cromikoLogoLabel",
+                    l10n_util::GetStringUTF16(IDS_PRODUCT_NAME));
+
+  const base::DictValue report =
+      subresource_filter::cromiko_shield_stats::GetReport(profile->GetPrefs());
+  source->AddString("cromikoShieldCount",
+                    base::FormatNumber(report.FindInt("blocked").value_or(0)));
+  const int today = report.FindInt("today").value_or(0);
+  const int week = report.FindInt("week").value_or(today);
+  const base::DictValue* days = report.FindDict("days");
+  std::vector<std::string> counts;
+  for (int day = week; day < week + 7; ++day) {
+    int count = -1;
+    if (day <= today) {
+      count = days ? days->FindInt(base::NumberToString(day)).value_or(0) : 0;
+    }
+    counts.push_back(base::NumberToString(count));
+  }
+  source->AddString("cromikoShieldDays", base::JoinString(counts, ","));
+
+  static constexpr webui::LocalizedString kCromikoStrings[] = {
+      {"cromikoShieldLabel", IDS_CROMIKO_NTP_SHIELD_LABEL},
+      {"cromikoShortcutBookmarks", IDS_CROMIKO_NTP_SHORTCUT_BOOKMARKS},
+      {"cromikoShortcutDownloads", IDS_CROMIKO_NTP_SHORTCUT_DOWNLOADS},
+      {"cromikoShortcutDns", IDS_CROMIKO_SETTINGS_DNS_TITLE},
+  };
+  source->AddLocalizedStrings(kCromikoStrings);
+}
