+  border-radius: 16px;
+  display: flex;
+  gap: 16px;
+  margin: 8px var(--cr-section-padding);
+  padding: 14px 18px;
+}
+
+#cromikoIcon {
+  align-items: center;
+  background: var(--color-sys-primary, var(--cr-checked-color));
+  border-radius: 50%;
+  display: flex;
+  flex: none;
+  height: 44px;
+  justify-content: center;
+  width: 44px;
+}
+
+#cromikoIcon svg {
+  height: 26px;
+  width: 26px;
+}
+
+#cromikoIcon .stroke {
+  fill: none;
+  stroke: var(--color-sys-on-primary, white);
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  stroke-width: 2.6px;
+}
+
+#cromikoIcon .star {
+  fill: var(--color-sys-on-primary, white);
+}
+
+#cromikoHeaderText {
+  color: var(--cr-primary-text-color);
+  line-height: 20px;
+}
+
+/* CromIKO: the previews next to the settings, which follow the choices. */
+.cromiko-preview {
+  align-items: center;
+  display: flex;
+  flex: none;
+  gap: 4px;
+  margin-inline: 16px;
+  width: 112px;
+}
+
+/* One file as a bar, split into a part for each connection. */
+#connectionsPreview {
+  border-radius: 5px;
+  gap: 2px;
+  height: 10px;
+  overflow: hidden;
+}
+
+#connectionsPreview .part {
+  background: color-mix(in srgb,
+      var(--color-sys-primary, var(--cr-checked-color)) 18%,
+      var(--cr-card-background-color, white));
+  flex: 1;
+  height: 100%;
+}
+
+#connectionsPreview .fill {
+  background: var(--color-sys-primary, var(--cr-checked-color));
+  height: 100%;
+  overflow: hidden;
+  position: relative;
+  transition: width 300ms ease-out;
+  width: calc(var(--fill) * 100%);
+}
+
+/* A light that runs over the parts that download. */
+#connectionsPreview .fill::after {
+  animation: cromiko-shine 2.4s ease-in-out infinite;
+  background: linear-gradient(90deg, transparent,
+      color-mix(in srgb, var(--color-sys-on-primary, white) 45%, transparent),
+      transparent);
+  content: '';
+  inset: 0;
+  position: absolute;
+  transform: translateX(-100%);
+}
+
+@keyframes cromiko-shine {
+  60%, 100% {
+    transform: translateX(100%);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  #connectionsPreview .fill::after {
+    display: none;
+  }
+}
+
+#queuePreview {
+  gap: 5px;
+  justify-content: flex-end;
+}
+
+#queuePreview .file {
+  height: 18px;
+  stroke-linejoin: round;
+  stroke-width: 1.5px;
+  transition: fill 200ms, stroke 200ms;
+  width: 14px;
+}
+
+#queuePreview .file.running {
+  fill: var(--color-sys-primary, var(--cr-checked-color));
+  stroke: var(--color-sys-primary, var(--cr-checked-color));
+}
+
+#queuePreview .file.running .corner {
+  fill: none;
+  stroke: var(--color-sys-on-primary, white);
+}
+
+#queuePreview .file.waiting {
+  fill: none;
+  stroke: var(--cr-secondary-text-color);
+  stroke-dasharray: 2.5 2;
+}
+
+#queuePreview .file.waiting .corner {
+  stroke-dasharray: none;
+}
