+// static
+std::u16string CromikoDownloadQueue::GetPausedText(
+    const download::DownloadItem* item) {
+  switch (item ? GetWaitReason(item) : WaitReason::kNone) {
+    case WaitReason::kQueue:
+      return l10n_util::GetStringUTF16(IDS_CROMIKO_DOWNLOADS_IN_QUEUE);
+    case WaitReason::kWifi:
+      return l10n_util::GetStringUTF16(IDS_CROMIKO_DOWNLOADS_WAITING_UNMETERED);
+    case WaitReason::kNone:
+      break;
+  }
+  return l10n_util::GetStringUTF16(IDS_DOWNLOAD_PROGRESS_PAUSED);
+}
+
+// static
+std::u16string CromikoDownloadQueue::AddConnections(
+    const download::DownloadItem* item,
+    std::u16string progress) {
+  const int connections = item ? GetConnectionCount(item) : 0;
+  if (connections < 2) {
+    return progress;
+  }
+  return l10n_util::GetStringFUTF16(IDS_CROMIKO_DOWNLOADS_WITH_CONNECTIONS,
+                                    progress,
+                                    base::NumberToString16(connections));
+}
+
 void CromikoDownloadQueue::OnDownloadCreated(content::DownloadManager* manager,
