+/**
+ * CromIKO: the names of the choices of the CromIKO download manager, with
+ * "(default)" after the default ones (4 connections, 3 downloads at the same
+ * time). 0 downloads at the same time is no limit.
+ */
+function withDefault(name: string, isDefault: boolean): string {
+  return isDefault ? loadTimeData.getStringF('cromikoDownloadsDefault', name) :
+                     name;
+}
+
+function getConnectionsName(count: number): string {
+  return withDefault(
+      count === 1 ?
+          loadTimeData.getString('cromikoDownloadsOneConnection') :
+          loadTimeData.getStringF('cromikoDownloadsConnectionCount', count),
+      count === 4);
+}
+
+function getMaxActiveName(count: number): string {
+  return count === 0 ? loadTimeData.getString('cromikoDownloadsNoLimit') :
+                       withDefault(count.toString(), count === 3);
+}
+
+/**
+ * CromIKO: how far each connection of the preview of one file has come, so
+ * that the parts look like they download side by side.
