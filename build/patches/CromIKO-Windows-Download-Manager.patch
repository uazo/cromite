--- /dev/null
+++ b/components/cromite_components_strings_grd/CromIKO-Windows-Download-Manager.grdp
@@ -0,0 +1,53 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- The CromIKO download manager on the desktop. The texts of the downloads are
+     in the shared C++, compiled on Android too; the Android app has its own
+     strings for its screens. -->
+<grit-part>
+  <message name="IDS_CROMIKO_DOWNLOADS_IN_QUEUE" desc="Status of a download that waits in the queue of the CromIKO download manager until another download ends, instead of 'Paused'.">
+    In queue
+  </message>
+  <message name="IDS_CROMIKO_DOWNLOADS_WAITING_UNMETERED" desc="Status of a download that waits while the connection is metered (the user turned on 'Pause on metered connections'), instead of 'Paused'.">
+    Waiting for an unmetered connection
+  </message>
+  <message name="IDS_CROMIKO_DOWNLOADS_WITH_CONNECTIONS" desc="The progress of a running download, with the number of connections it uses (2 or more).">
+    <ph name="PROGRESS">$1<ex>2.4 MB/s - 12 MB of 300 MB, 2 mins left</ex></ph> • <ph name="COUNT">$2<ex>4</ex></ph> connections
+  </message>
+  <if expr="not is_android">
+    <message name="IDS_CROMIKO_SETTINGS_DOWNLOADS_TITLE" desc="Title of the settings of the CromIKO download manager in Settings > Downloads.">
+      CromIKO download manager
+    </message>
+    <message name="IDS_CROMIKO_SETTINGS_DOWNLOADS_HEADER" desc="Explanation at the top of the settings of the CromIKO download manager.">
+      Big files download faster over several connections at once. Downloads over the limit wait in a queue: resume one to start it right away.
+    </message>
+    <message name="IDS_CROMIKO_SETTINGS_DOWNLOADS_CONNECTIONS" desc="Setting: how many connections a download uses.">
+      Connections per file
+    </message>
+    <message name="IDS_CROMIKO_SETTINGS_DOWNLOADS_CONNECTIONS_DETAIL" desc="Explanation of the setting of the connections per file.">
+      More connections download big files faster, when the site allows it
+    </message>
+    <message name="IDS_CROMIKO_SETTINGS_DOWNLOADS_ONE_CONNECTION" desc="Choice of the connections per file: one.">
+      1 connection
+    </message>
+    <message name="IDS_CROMIKO_SETTINGS_DOWNLOADS_CONNECTION_COUNT" desc="Choice of the connections per file: more than one.">
+      <ph name="COUNT">$1<ex>4</ex></ph> connections
+    </message>
+    <message name="IDS_CROMIKO_SETTINGS_DOWNLOADS_AT_ONCE" desc="Setting: how many downloads run at the same time.">
+      Downloads at the same time
+    </message>
+    <message name="IDS_CROMIKO_SETTINGS_DOWNLOADS_AT_ONCE_DETAIL" desc="Explanation of the setting of the downloads at the same time.">
+      The others wait in a queue and start when one ends
+    </message>
+    <message name="IDS_CROMIKO_SETTINGS_DOWNLOADS_NO_LIMIT" desc="Choice of the downloads at the same time: any number.">
+      No limit
+    </message>
+    <message name="IDS_CROMIKO_SETTINGS_DOWNLOADS_DEFAULT" desc="A choice of a setting that is the default.">
+      <ph name="CHOICE">$1<ex>4 connections</ex></ph> (default)
+    </message>
+    <message name="IDS_CROMIKO_SETTINGS_DOWNLOADS_METERED" desc="Setting: downloads wait while the connection is metered.">
+      Pause on metered connections
+    </message>
+    <message name="IDS_CROMIKO_SETTINGS_DOWNLOADS_METERED_DETAIL" desc="Explanation of the setting that pauses downloads on metered connections.">
+      Downloads wait while your connection is metered or mobile, and continue on an unmetered one
+    </message>
+  </if>
+</grit-part>
