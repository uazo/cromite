+
+constexpr int kDialogIconSize = 20;
+
+// Empties Recent tabs of |profile|: the windows that were closed are kept
+// there when they close.
+void ClearRecentTabs(Profile* profile) {
+  sessions::TabRestoreService* recent_tabs =
+      TabRestoreServiceFactory::GetForProfile(profile);
+  if (recent_tabs) {
+    recent_tabs->ClearEntries();
+  }
+}
+
+void ShowDoneToast(BrowserWindowInterface* window) {
+  ToastController* toasts = ToastController::From(window);
+  if (!toasts) {
+    return;
+  }
+  // The toast of "Delete browsing data", with the CromIKO text and icon.
+  ToastParams params(ToastId::kClearBrowsingData);
+  params.body_string_override =
+      l10n_util::GetStringUTF16(IDS_CROMIKO_BURN_DONE);
+  params.image_override = ui::ImageModel::FromVectorIcon(
+      kCromikoFireIcon, ui::kColorToastForeground,
+      toasts::ToastView::GetIconSize());
+  toasts->MaybeShowToast(std::move(params));
+}
+
+// Deletes the browsing data of a profile, then empties Recent tabs and shows
+// the toast in the window that stays. It deletes itself when done.
+class BurnRemover : public content::BrowsingDataRemover::Observer {
+ public:
+  BurnRemover(Profile* profile, base::WeakPtr<BrowserWindowInterface> window)
+      : profile_(profile),
+        keep_alive_(profile, ProfileKeepAliveOrigin::kClearingBrowsingData),
+        window_(std::move(window)) {}
+  BurnRemover(const BurnRemover&) = delete;
+  BurnRemover& operator=(const BurnRemover&) = delete;
+  ~BurnRemover() override = default;
+
+  void Start() {
+    // The same data as "Delete browsing data" with history, cookies and site
+    // data and cached files, for all time. The history stays if a policy
+    // does not allow deleting it, as there.
+    uint64_t data_types = chrome_browsing_data_remover::DATA_TYPE_SITE_DATA |
+                          content::BrowsingDataRemover::DATA_TYPE_CACHE;
+    if (profile_->GetPrefs()->GetBoolean(
+            prefs::kAllowDeletingBrowserHistory)) {
+      data_types |= chrome_browsing_data_remover::DATA_TYPE_HISTORY;
+    }
+    profile_->GetBrowsingDataRemover()->RemoveAndReply(
+        base::Time(), base::Time::Max(), data_types,
+        content::BrowsingDataRemover::ORIGIN_TYPE_UNPROTECTED_WEB, this);
+  }
+
+  // content::BrowsingDataRemover::Observer:
+  void OnBrowsingDataRemoverDone(uint64_t failed_data_types) override {
+    ClearRecentTabs(profile_);
+    if (window_ && !window_->IsDeleteScheduled()) {
+      ShowDoneToast(window_.get());
+    }
+    delete this;
+  }
+
+ private:
+  raw_ptr<Profile> profile_;
+  ScopedProfileKeepAlive keep_alive_;
+  base::WeakPtr<BrowserWindowInterface> window_;
+};
+
+void Burn(base::WeakPtr<BrowserWindowInterface> from) {
+  if (!from || from->IsDeleteScheduled()) {
+    return;
+  }
+  Profile* profile = from->GetProfile()->GetOriginalProfile();
+
+  // The window that stays: the one of the menu with only a new tab, or a new
+  // window when the menu was of an incognito window.
+  BrowserWindowInterface* kept = nullptr;
+  if (from->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+      !from->GetProfile()->IsOffTheRecord()) {
+    kept = from.get();
+    content::WebContents* new_tab =
+        &chrome::NewTab(kept, NewTabTypes::kNewTabCommand);
+    // Without CLOSE_CREATE_HISTORICAL_TAB, the tabs are not kept in Recent
+    // tabs.
+    TabStripModel* tabs = kept->GetTabStripModel();
+    for (int i = tabs->count() - 1; i >= 0; --i) {
+      if (tabs->GetWebContentsAt(i) != new_tab) {
+        tabs->CloseWebContentsAt(i, TabCloseTypes::CLOSE_NONE);
+      }
+    }
+  } else {
+    kept = chrome::OpenEmptyWindow(profile,
+                                   /*should_trigger_session_restore=*/false);
+  }
+
+  // All other windows of the profile and of its incognito profiles. Closing
+  // one can close others with it (its DevTools windows), so they are held
+  // by weak pointers.
+  std::vector<base::WeakPtr<BrowserWindowInterface>> to_close;
+  for (BrowserWindowInterface* window : GetAllBrowserWindowInterfaces()) {
+    if (window != kept &&
+        window->GetProfile()->GetOriginalProfile() == profile) {
+      to_close.push_back(window->GetWeakPtr());
+    }
+  }
+  for (const base::WeakPtr<BrowserWindowInterface>& window : to_close) {
+    if (window && !window->IsDeleteScheduled()) {
+      chrome::CloseWindow(window.get());
+    }
+  }
+  ClearRecentTabs(profile);
+
+  (new BurnRemover(profile, kept ? kept->GetWeakPtr()
+                                 : base::WeakPtr<BrowserWindowInterface>()))
+      ->Start();
+}
+
+}  // namespace
+
+void ShowBurnDialog(BrowserWindowInterface* browser) {
+  // Burn() runs after the dialog closed, as it may close the dialog's window.
+  auto on_burn = base::BindOnce(
+      [](base::WeakPtr<BrowserWindowInterface> browser) {
+        base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE, base::BindOnce(&Burn, std::move(browser)));
+      },
+      browser->GetWeakPtr());
+  std::unique_ptr<ui::DialogModel> dialog =
+      ui::DialogModel::Builder()
+          .SetInternalName("CromikoBurnDialog")
+          .SetIcon(ui::ImageModel::FromVectorIcon(
+              kCromikoFireIcon, ui::kColorAccent, kDialogIconSize))
+          .SetTitle(l10n_util::GetStringUTF16(IDS_CROMIKO_BURN_DIALOG_TITLE))
+          .AddParagraph(ui::DialogModelLabel(IDS_CROMIKO_BURN_DIALOG_MESSAGE))
+          .AddOkButton(std::move(on_burn),
+                       ui::DialogModel::Button::Params().SetLabel(
+                           l10n_util::GetStringUTF16(IDS_CROMIKO_BURN_CONFIRM)))
+          .AddCancelButton(base::DoNothing())
+          .OverrideDefaultButton(ui::mojom::DialogButton::kCancel)
+          .Build();
+  constrained_window::ShowBrowserModal(std::move(dialog),
+                                       browser->GetWindow()->GetNativeWindow());
+}
+
+}  // namespace cromiko
