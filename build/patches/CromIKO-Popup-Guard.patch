diff --git a/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoHeldLink.java b/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoHeldLink.java
new file mode 100644
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoHeldLink.java
@@ -0,0 +1,114 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.cromiko;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import org.chromium.build.annotations.NullMarked;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * CromIKO: a pop-up or redirect that the pop-up guard holds, as cromiko_popup_guard.cc describes
+ * it.
+ */
+@NullMarked
+final class CromikoHeldLink {
+    final int id;
+    final boolean redirect;
+    final String url;
+    final String scheme;
+    final String host;
+    // The domain of the site, like "google.com" for accounts.google.com.
+    final String site;
+    final boolean ipAddress;
+    // The port, or 0 for the usual one.
+    final int port;
+    // Whether the address has a user name or password before the host.
+    final boolean userInfo;
+    final String path;
+    final String query;
+    // Whether a tap opened it.
+    final boolean userGesture;
+    // Whether Adblock Plus would close it.
+    final boolean adblocked;
+
+    CromikoHeldLink(
+            int id,
+            boolean redirect,
+            String url,
+            String scheme,
+            String host,
+            String site,
+            boolean ipAddress,
+            int port,
+            boolean userInfo,
+            String path,
+            String query,
+            boolean userGesture,
+            boolean adblocked) {
+        this.id = id;
+        this.redirect = redirect;
+        this.url = url;
+        this.scheme = scheme;
+        this.host = host;
+        this.site = site;
+        this.ipAddress = ipAddress;
+        this.port = port;
+        this.userInfo = userInfo;
+        this.path = path;
+        this.query = query;
+        this.userGesture = userGesture;
+        this.adblocked = adblocked;
+    }
+
+    /** Returns the address to show: the host and the path, without "https://". */
+    String getShortUrl() {
+        if (host.isEmpty()) return url;
+        String rest = "/".equals(path) ? "" : path;
+        return host + rest + (query.isEmpty() ? "" : "?…");
+    }
+
+    /** Returns the pop-ups and redirects in |state|, the JSON of cromiko_popup_guard.cc. */
+    static List<CromikoHeldLink> parseAll(String state) {
+        try {
+            JSONArray items = new JSONObject(state).getJSONArray("items");
+            List<CromikoHeldLink> links = new ArrayList<>(items.length());
+            for (int i = 0; i < items.length(); i++) {
+                JSONObject item = items.getJSONObject(i);
+                links.add(
+                        new CromikoHeldLink(
+                                item.getInt("id"),
+                                item.optBoolean("redirect"),
+                                item.optString("url"),
+                                item.optString("scheme"),
+                                item.optString("host"),
+                                item.optString("site"),
+                                item.optBoolean("ip"),
+                                item.optInt("port"),
+                                item.optBoolean("userinfo"),
+                                item.optString("path"),
+                                item.optString("query"),
+                                item.optBoolean("gesture"),
+                                item.optBoolean("adblock")));
+            }
+            return links;
+        } catch (JSONException e) {
+            return Collections.emptyList();
+        }
+    }
+
+    /** Returns the site of the tab in |state|, the JSON of cromiko_popup_guard.cc. */
+    static String parsePage(String state) {
+        try {
+            return new JSONObject(state).optString("page");
+        } catch (JSONException e) {
+            return "";
+        }
+    }
+}
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoPopupGuard.java b/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoPopupGuard.java
new file mode 100644
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoPopupGuard.java
@@ -0,0 +1,68 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.cromiko;
+
+import android.app.Activity;
+
+import org.chromium.base.ThreadUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.ui.base.WindowAndroid;
+
+import java.util.Map;
+import java.util.WeakHashMap;
+
+/**
+ * CromIKO: the pop-up guard. CromIKO holds every pop-up and every redirect to another site that the
+ * user did not ask for, before Adblock Plus closes it (see cromiko_popup_guard.h), and shows it in
+ * a toast in the window of its tab. The menu of the toast tells where it goes, who runs the site
+ * and how far to trust it, and the user decides whether to open it.
+ */
+@NullMarked
+public final class CromikoPopupGuard implements CromikoPopupGuardBridge.Observer {
+    private static @Nullable CromikoPopupGuard sInstance;
+
+    // The toast of each window.
+    private final Map<Activity, CromikoPopupGuardToast> mToasts = new WeakHashMap<>();
+
+    private CromikoPopupGuard() {}
+
+    /** Starts showing what the pop-up guard holds, once the browser runs. */
+    public static void init() {
+        ThreadUtils.assertOnUiThread();
+        if (sInstance != null) return;
+        sInstance = new CromikoPopupGuard();
+        CromikoPopupGuardBridge.setObserver(sInstance);
+    }
+
+    @Override
+    public void onChanged(WebContents webContents, String state, boolean added) {
+        Activity activity = getActivity(webContents);
+        if (activity == null || activity.isFinishing()) return;
+        CromikoPopupGuardToast toast = mToasts.get(activity);
+        if (toast == null) {
+            if (!added) return;
+            toast = new CromikoPopupGuardToast(activity);
+            mToasts.put(activity, toast);
+        }
+        toast.update(
+                webContents,
+                CromikoHeldLink.parseAll(state),
+                CromikoHeldLink.parsePage(state),
+                added);
+    }
+
+    @Override
+    public void onHidden(WebContents webContents) {
+        Activity activity = getActivity(webContents);
+        CromikoPopupGuardToast toast = activity != null ? mToasts.get(activity) : null;
+        if (toast != null) toast.onHidden(webContents);
+    }
+
+    private static @Nullable Activity getActivity(WebContents webContents) {
+        WindowAndroid window = webContents.getTopLevelNativeWindow();
+        return window != null ? window.getActivity().get() : null;
+    }
+}
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoPopupGuardMenu.java b/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoPopupGuardMenu.java
new file mode 100644
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoPopupGuardMenu.java
@@ -0,0 +1,447 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.cromiko;
+
+import android.animation.ValueAnimator;
+import android.annotation.SuppressLint;
+import android.app.Activity;
+import android.app.Dialog;
+import android.content.res.ColorStateList;
+import android.graphics.Color;
+import android.graphics.drawable.ColorDrawable;
+import android.view.Gravity;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.Window;
+import android.view.WindowManager;
+import android.view.animation.DecelerateInterpolator;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import androidx.annotation.ColorInt;
+import androidx.annotation.DrawableRes;
+import androidx.core.graphics.ColorUtils;
+
+import com.google.android.material.color.MaterialColors;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.cromiko.CromikoTrustScore.Level;
+import org.chromium.chrome.browser.cromiko.CromikoTrustScore.Reason;
+import org.chromium.chrome.browser.cromiko.CromikoTrustScore.Weight;
+import org.chromium.content_public.browser.WebContents;
+
+import java.text.NumberFormat;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * CromIKO: the menu of the pop-up guard, which grows out of the toast. It shows where a held pop-up
+ * or redirect goes, who runs that site, its trust score and the reasons for it, and lets the user
+ * open it, even past Adblock Plus, block it, or allow the site.
+ */
+@NullMarked
+final class CromikoPopupGuardMenu {
+    // The most reasons to list.
+    private static final int MAX_REASONS = 6;
+    // The color of the circle of the provider when its letter is better dark: the mascot charcoal.
+    private static final @ColorInt int CHARCOAL = 0xFF1E212A;
+
+    private final Activity mActivity;
+    private final WebContents mWebContents;
+    private final Runnable mOnClosed;
+    private final Dialog mDialog;
+    private final View mCard;
+    private final TextView mKind;
+    private final View mPrevious;
+    private final TextView mPager;
+    private final View mNext;
+    private final TextView mProviderIcon;
+    private final TextView mProvider;
+    private final TextView mHost;
+    private final TextView mUrl;
+    private final View mScoreRow;
+    private final CromikoTrustRing mRing;
+    private final TextView mLevel;
+    private final LinearLayout mReasons;
+    private final View mAdblockNote;
+    private final TextView mAllow;
+    private final TextView mOpen;
+    private List<CromikoHeldLink> mLinks;
+    private String mPage;
+    private int mIndex;
+    private boolean mClosed;
+
+    /**
+     * @param activity The window.
+     * @param webContents The tab that holds the pop-ups and redirects.
+     * @param links The held pop-ups and redirects.
+     * @param page The site of the tab, like "example.com".
+     * @param onClosed Called when the menu closes.
+     */
+    @SuppressLint("InflateParams")
+    CromikoPopupGuardMenu(
+            Activity activity,
+            WebContents webContents,
+            List<CromikoHeldLink> links,
+            String page,
+            Runnable onClosed) {
+        mActivity = activity;
+        mWebContents = webContents;
+        mOnClosed = onClosed;
+        mLinks = links;
+        mPage = page;
+        // The newest first, like the toast.
+        mIndex = links.size() - 1;
+
+        View view = LayoutInflater.from(activity).inflate(R.layout.cromiko_popup_guard_menu, null);
+        mCard = view.findViewById(R.id.cromiko_popup_guard_menu_card);
+        mKind = view.findViewById(R.id.cromiko_popup_guard_menu_kind);
+        mPrevious = view.findViewById(R.id.cromiko_popup_guard_menu_previous);
+        mPager = view.findViewById(R.id.cromiko_popup_guard_menu_pager);
+        mNext = view.findViewById(R.id.cromiko_popup_guard_menu_next);
+        mProviderIcon = view.findViewById(R.id.cromiko_popup_guard_menu_provider_icon);
+        mProvider = view.findViewById(R.id.cromiko_popup_guard_menu_provider);
+        mHost = view.findViewById(R.id.cromiko_popup_guard_menu_host);
+        mUrl = view.findViewById(R.id.cromiko_popup_guard_menu_url);
+        mScoreRow = view.findViewById(R.id.cromiko_popup_guard_menu_score_row);
+        mRing = view.findViewById(R.id.cromiko_popup_guard_menu_ring);
+        mLevel = view.findViewById(R.id.cromiko_popup_guard_menu_level);
+        mReasons = view.findViewById(R.id.cromiko_popup_guard_menu_reasons);
+        mAdblockNote = view.findViewById(R.id.cromiko_popup_guard_menu_adblock);
+        mAllow = view.findViewById(R.id.cromiko_popup_guard_menu_allow);
+        mOpen = view.findViewById(R.id.cromiko_popup_guard_menu_open);
+
+        mPrevious.setOnClickListener(v -> page(-1));
+        mNext.setOnClickListener(v -> page(1));
+        view.findViewById(R.id.cromiko_popup_guard_menu_close).setOnClickListener(v -> close());
+        view.findViewById(R.id.cromiko_popup_guard_menu_block)
+                .setOnClickListener(v -> CromikoPopupGuardBridge.dismiss(mWebContents, current().id));
+        mOpen.setOnClickListener(
+                v -> {
+                    int id = current().id;
+                    close();
+                    CromikoPopupGuardBridge.open(mWebContents, id);
+                });
+        mAllow.setOnClickListener(
+                v -> {
+                    int id = current().id;
+                    close();
+                    CromikoPopupGuardBridge.allowSite(mWebContents, id);
+                });
+
+        mDialog = new Dialog(activity);
+        mDialog.requestWindowFeature(Window.FEATURE_NO_TITLE);
+        mDialog.setContentView(view);
+        mDialog.setCanceledOnTouchOutside(true);
+        mDialog.setOnDismissListener(
+                dialog -> {
+                    mClosed = true;
+                    mOnClosed.run();
+                });
+        Window window = mDialog.getWindow();
+        if (window != null) {
+            window.setBackgroundDrawable(new ColorDrawable(Color.TRANSPARENT));
+            window.setLayout(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+            window.setGravity(Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL);
+            window.addFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND);
+            window.setDimAmount(0.32f);
+            window.setWindowAnimations(R.style.CromikoPopupGuardMenuAnimation);
+        }
+        if (activity.getResources().getConfiguration().screenWidthDp >= 600) {
+            mCard.getLayoutParams().width = Math.round(456 * density());
+        }
+    }
+
+    /** Shows the menu, growing out of the toast. */
+    void show() {
+        bind(/* animate= */ true);
+        mDialog.show();
+    }
+
+    /** Whether the menu is showing. */
+    boolean isShowing() {
+        return !mClosed;
+    }
+
+    /** Shows the pop-ups and redirects that the tab holds now; closes when there are none. */
+    void update(List<CromikoHeldLink> links, String page) {
+        if (mClosed) return;
+        if (links.isEmpty()) {
+            close();
+            return;
+        }
+        int id = current().id;
+        mLinks = links;
+        mPage = page;
+        int index = -1;
+        for (int i = 0; i < links.size(); i++) {
+            if (links.get(i).id == id) index = i;
+        }
+        // The shown one is gone (blocked): show the next older one, or the newest.
+        mIndex = index >= 0 ? index : Math.max(0, Math.min(mIndex - 1, links.size() - 1));
+        bind(/* animate= */ index < 0);
+    }
+
+    /** Closes the menu. */
+    void close() {
+        if (mClosed) return;
+        mClosed = true;
+        mDialog.dismiss();
+    }
+
+    private CromikoHeldLink current() {
+        return mLinks.get(mIndex);
+    }
+
+    private void page(int step) {
+        int index = mIndex - step;
+        if (index < 0 || index >= mLinks.size()) return;
+        mIndex = index;
+        bind(/* animate= */ true);
+        float shift = 24 * density() * (step > 0 ? 1 : -1);
+        if (mCard.getLayoutDirection() == View.LAYOUT_DIRECTION_RTL) shift = -shift;
+        if (ValueAnimator.areAnimatorsEnabled()) {
+            mCard.setTranslationX(shift);
+            mCard.setAlpha(0.4f);
+            mCard.animate()
+                    .translationX(0)
+                    .alpha(1)
+                    .setDuration(220)
+                    .setInterpolator(new DecelerateInterpolator())
+                    .start();
+        }
+    }
+
+    private void bind(boolean animate) {
+        CromikoHeldLink link = current();
+        CromikoTrustScore.Result trust = CromikoTrustScore.evaluate(link, mPage);
+
+        // The site of the page is on the button that allows it, so this stays short.
+        mKind.setText(
+                link.redirect
+                        ? R.string.cromiko_popup_guard_redirect_held
+                        : R.string.cromiko_popup_guard_popup_held);
+        int count = mLinks.size();
+        int pagerVisibility = count > 1 ? View.VISIBLE : View.GONE;
+        mPrevious.setVisibility(pagerVisibility);
+        mPager.setVisibility(pagerVisibility);
+        mNext.setVisibility(pagerVisibility);
+        // Next goes to older ones, which come first in the list.
+        mPager.setText(
+                mActivity.getString(R.string.cromiko_popup_guard_pager, count - mIndex, count));
+        mPrevious.setEnabled(mIndex < count - 1);
+        mPrevious.setAlpha(mIndex < count - 1 ? 1f : 0.38f);
+        mNext.setEnabled(mIndex > 0);
+        mNext.setAlpha(mIndex > 0 ? 1f : 0.38f);
+
+        bindProvider(link, trust.provider);
+        mHost.setText(link.host.isEmpty() ? link.url : link.host);
+        mUrl.setText(link.url);
+
+        @ColorInt int levelColor = getLevelColor(trust.level);
+        mRing.setScore(trust.score, levelColor, animate);
+        mLevel.setText(getLevelText(trust.level));
+        mLevel.setTextColor(levelColor);
+        mScoreRow.setContentDescription(
+                mActivity.getString(R.string.cromiko_popup_guard_score, trust.score)
+                        + ". "
+                        + mLevel.getText());
+
+        bindReasons(trust, animate);
+        mAdblockNote.setVisibility(link.adblocked ? View.VISIBLE : View.GONE);
+        mAllow.setVisibility(mPage.isEmpty() ? View.GONE : View.VISIBLE);
+        mAllow.setText(mActivity.getString(R.string.cromiko_popup_guard_allow_site, mPage));
+        mOpen.setText(
+                trust.score < CromikoTrustScore.CAREFUL_SCORE
+                        ? R.string.cromiko_popup_guard_open_anyway
+                        : R.string.cromiko_popup_guard_open);
+    }
+
+    private void bindProvider(
+            CromikoHeldLink link, CromikoUrlProviders.@Nullable Provider provider) {
+        String name;
+        String letterOf;
+        @ColorInt int color;
+        if (provider == null) {
+            name = mActivity.getString(R.string.cromiko_popup_guard_unknown_provider);
+            letterOf = link.site.isEmpty() ? link.scheme : link.site;
+            color = MaterialColors.getColor(mCard, R.attr.colorPrimary);
+        } else {
+            letterOf = provider.name;
+            color = provider.color;
+            if (provider.kind == CromikoUrlProviders.Kind.HOSTING) {
+                name = mActivity.getString(R.string.cromiko_popup_guard_hosted_by, provider.name);
+            } else if (provider.kind == CromikoUrlProviders.Kind.AD_NETWORK) {
+                name = mActivity.getString(R.string.cromiko_popup_guard_ad_network, provider.name);
+            } else {
+                name = provider.name;
+            }
+        }
+        mProvider.setText(name);
+        mProviderIcon.setText(getLetter(letterOf));
+        mProviderIcon.setBackgroundTintList(ColorStateList.valueOf(color));
+        mProviderIcon.setTextColor(
+                ColorUtils.calculateLuminance(color) > 0.45 ? CHARCOAL : Color.WHITE);
+    }
+
+    private void bindReasons(CromikoTrustScore.Result trust, boolean animate) {
+        mReasons.removeAllViews();
+        LayoutInflater inflater = LayoutInflater.from(mActivity);
+        int shown = Math.min(MAX_REASONS, trust.reasons.size());
+        for (int i = 0; i < shown; i++) {
+            @Reason int reason = trust.reasons.get(i);
+            View row = inflater.inflate(R.layout.cromiko_popup_guard_reason, mReasons, false);
+            ImageView icon = row.findViewById(R.id.cromiko_popup_guard_reason_icon);
+            @Weight int weight = CromikoTrustScore.getWeight(reason);
+            icon.setImageResource(getWeightIcon(weight));
+            icon.setImageTintList(ColorStateList.valueOf(getWeightColor(weight)));
+            TextView text = row.findViewById(R.id.cromiko_popup_guard_reason_text);
+            text.setText(getReasonText(reason, trust.provider));
+            mReasons.addView(row);
+            if (animate && ValueAnimator.areAnimatorsEnabled()) {
+                row.setAlpha(0f);
+                row.setTranslationY(6 * density());
+                row.animate()
+                        .alpha(1f)
+                        .translationY(0)
+                        .setStartDelay(140 + 45L * i)
+                        .setDuration(220)
+                        .setInterpolator(new DecelerateInterpolator())
+                        .start();
+            }
+        }
+    }
+
+    private String getReasonText(
+            @Reason int reason, CromikoUrlProviders.@Nullable Provider provider) {
+        switch (reason) {
+            case Reason.GENERATED_PAGE:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_generated_page);
+            case Reason.AD_NETWORK:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_ad_network);
+            case Reason.ADBLOCK_LIST:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_adblock_list);
+            case Reason.AD_SHORTENER:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_ad_shortener);
+            case Reason.HIDDEN_ADDRESS:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_hidden_address);
+            case Reason.NOT_SECURE:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_not_secure);
+            case Reason.IP_ADDRESS:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_ip_address);
+            case Reason.LOOKALIKE:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_lookalike);
+            case Reason.RISKY_ENDING:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_risky_ending);
+            case Reason.APP_DOWNLOAD:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_app_download);
+            case Reason.BLANK_WINDOW:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_blank_window);
+            case Reason.SHORT_LINK:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_short_link);
+            case Reason.UNUSUAL_PORT:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_unusual_port);
+            case Reason.FORWARDS:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_forwards);
+            case Reason.NO_TAP:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_no_tap);
+            case Reason.TRACKERS:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_trackers);
+            case Reason.TRACKING_CODES:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_tracking_codes);
+            case Reason.HOSTED:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_hosted);
+            case Reason.UNKNOWN_PROVIDER:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_unknown_provider);
+            case Reason.KNOWN_PROVIDER:
+                return mActivity.getString(
+                        R.string.cromiko_popup_guard_reason_known_provider,
+                        provider != null ? provider.name : "");
+            case Reason.SECURE:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_secure);
+            case Reason.SAME_SITE:
+            default:
+                return mActivity.getString(R.string.cromiko_popup_guard_reason_same_site);
+        }
+    }
+
+    private String getLevelText(@Level int level) {
+        switch (level) {
+            case Level.TRUSTED:
+                return mActivity.getString(R.string.cromiko_popup_guard_level_trusted);
+            case Level.TRACKED:
+                return mActivity.getString(R.string.cromiko_popup_guard_level_tracked);
+            case Level.CAREFUL:
+                return mActivity.getString(R.string.cromiko_popup_guard_level_careful);
+            case Level.RISKY:
+            default:
+                return mActivity.getString(R.string.cromiko_popup_guard_level_risky);
+        }
+    }
+
+    private @ColorInt int getLevelColor(@Level int level) {
+        switch (level) {
+            case Level.TRUSTED:
+            case Level.TRACKED:
+                return mActivity.getColor(R.color.cromiko_trust_good);
+            case Level.CAREFUL:
+                return mActivity.getColor(R.color.cromiko_trust_caution);
+            case Level.RISKY:
+            default:
+                return mActivity.getColor(R.color.cromiko_trust_risky);
+        }
+    }
+
+    private static @DrawableRes int getWeightIcon(@Weight int weight) {
+        switch (weight) {
+            case Weight.BAD:
+                return R.drawable.cromiko_ic_guard_bad;
+            case Weight.WARNING:
+                return R.drawable.cromiko_ic_guard_warning;
+            case Weight.NOTE:
+                return R.drawable.cromiko_ic_guard_note;
+            case Weight.GOOD:
+            default:
+                return R.drawable.cromiko_ic_guard_good;
+        }
+    }
+
+    private @ColorInt int getWeightColor(@Weight int weight) {
+        switch (weight) {
+            case Weight.BAD:
+                return mActivity.getColor(R.color.cromiko_trust_risky);
+            case Weight.WARNING:
+                return mActivity.getColor(R.color.cromiko_trust_caution);
+            case Weight.NOTE:
+                return MaterialColors.getColor(mCard, R.attr.colorOnSurfaceVariant);
+            case Weight.GOOD:
+            default:
+                return mActivity.getColor(R.color.cromiko_trust_good);
+        }
+    }
+
+    // The first letter or digit of |text|, for the circle of the provider.
+    private static String getLetter(String text) {
+        for (int i = 0; i < text.length(); i++) {
+            char c = text.charAt(i);
+            if (Character.isLetterOrDigit(c)) {
+                return String.valueOf(c).toUpperCase(Locale.getDefault());
+            }
+        }
+        return "?";
+    }
+
+    private float density() {
+        return mActivity.getResources().getDisplayMetrics().density;
+    }
+
+    /** Formats |number| with the digits of the language. */
+    static String format(int number) {
+        return NumberFormat.getIntegerInstance().format(number);
+    }
+}
