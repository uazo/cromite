+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.cromiko;
+
+import android.animation.Animator;
+import android.animation.AnimatorListenerAdapter;
+import android.animation.ObjectAnimator;
+import android.animation.ValueAnimator;
+import android.annotation.SuppressLint;
+import android.app.Activity;
+import android.view.Gravity;
+import android.view.LayoutInflater;
+import android.view.MotionEvent;
+import android.view.VelocityTracker;
+import android.view.View;
+import android.view.ViewConfiguration;
+import android.view.ViewGroup;
+import android.view.accessibility.AccessibilityManager;
+import android.view.animation.AccelerateInterpolator;
+import android.view.animation.DecelerateInterpolator;
+import android.view.animation.LinearInterpolator;
+import android.view.animation.OvershootInterpolator;
+import android.widget.FrameLayout;
+import android.widget.TextView;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.content_public.browser.Visibility;
+import org.chromium.content_public.browser.WebContents;
+
+import java.util.List;
+
+/**
+ * CromIKO: the toast of the pop-up guard in a window. It slides up above the toolbar when a tab
+ * holds a pop-up or redirect, shows where it wanted to go, and opens {@link CromikoPopupGuardMenu}
+ * with its button; it goes away by itself, or with a swipe.
+ */
+@NullMarked
+final class CromikoPopupGuardToast {
+    // How long the toast shows, unless the accessibility settings ask for longer.
+    private static final int SHOW_MS = 8000;
+
+    private final Activity mActivity;
+    private @Nullable View mView;
+    private @Nullable TextView mTitle;
+    private @Nullable TextView mUrl;
+    private @Nullable TextView mCount;
+    private @Nullable View mTimerBar;
+    private @Nullable ObjectAnimator mTimer;
+    private @Nullable CromikoPopupGuardMenu mMenu;
+    // The tab of the toast or the menu.
+    private @Nullable WebContents mWebContents;
+    private List<CromikoHeldLink> mLinks = List.of();
+    private String mPage = "";
+    private boolean mShowing;
+
+    CromikoPopupGuardToast(Activity activity) {
+        mActivity = activity;
+    }
+
+    /**
+     * Shows what |webContents| holds now.
+     *
+     * @param links The held pop-ups and redirects, the newest last.
+     * @param page The site of the tab.
+     * @param added Whether something was just held: then the toast shows.
+     */
+    void update(WebContents webContents, List<CromikoHeldLink> links, String page, boolean added) {
+        boolean sameTab = webContents.equals(mWebContents);
+        if (mMenu != null && mMenu.isShowing()) {
+            if (sameTab) {
+                mLinks = links;
+                mPage = page;
+                mMenu.update(links, page);
+            }
+            return;
+        }
+        if (links.isEmpty()) {
+            if (sameTab) hide(/* animate= */ true);
+            return;
+        }
+        if (added) {
+            // Only for the tab in front: a tab in the background waits silently.
+            if (webContents.getVisibility() != Visibility.VISIBLE) return;
+        } else if (!mShowing || !sameTab) {
+            return;
+        }
+        mWebContents = webContents;
+        mLinks = links;
+        mPage = page;
+        if (!ensureView()) return;
+        bind();
+        if (added) show();
+    }
+
+    /** Hides the toast and the menu of |webContents|, when its tab goes to the background. */
+    void onHidden(WebContents webContents) {
+        if (!webContents.equals(mWebContents)) return;
+        hide(/* animate= */ false);
+        if (mMenu != null) mMenu.close();
+    }
+
+    @SuppressLint("ClickableViewAccessibility")
+    private boolean ensureView() {
+        if (mView != null) return true;
+        ViewGroup parent = mActivity.findViewById(R.id.bottom_container);
+        if (parent == null) parent = mActivity.findViewById(android.R.id.content);
+        if (parent == null) return false;
+        View view = LayoutInflater.from(mActivity).inflate(R.layout.cromiko_popup_guard_toast, parent, false);
+        float density = mActivity.getResources().getDisplayMetrics().density;
+        int margin = Math.round(12 * density);
+        boolean wide = mActivity.getResources().getConfiguration().screenWidthDp >= 600;
+        FrameLayout.LayoutParams params =
+                new FrameLayout.LayoutParams(
+                        wide ? Math.round(456 * density) : ViewGroup.LayoutParams.MATCH_PARENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT,
+                        Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL);
+        params.setMargins(margin, margin, margin, margin);
+        view.setLayoutParams(params);
+        view.setClipToOutline(true);
+        mTitle = view.findViewById(R.id.cromiko_popup_guard_toast_title);
+        mUrl = view.findViewById(R.id.cromiko_popup_guard_toast_url);
+        mCount = view.findViewById(R.id.cromiko_popup_guard_toast_count);
+        mTimerBar = view.findViewById(R.id.cromiko_popup_guard_toast_timer);
+        view.findViewById(R.id.cromiko_popup_guard_toast_open).setOnClickListener(v -> openMenu());
+        view.setOnClickListener(v -> openMenu());
+        view.setOnTouchListener(new SwipeListener());
+        mView = view;
+        return true;
+    }
+
+    private void bind() {
+        if (mView == null || mTitle == null || mUrl == null || mCount == null) return;
+        CromikoHeldLink link = mLinks.get(mLinks.size() - 1);
+        String title =
+                mActivity.getString(
+                        link.redirect
+                                ? R.string.cromiko_popup_guard_redirect_held
+                                : R.string.cromiko_popup_guard_popup_held);
+        mTitle.setText(title);
+        mUrl.setText(link.getShortUrl());
+        int count = mLinks.size();
+        mCount.setVisibility(count > 1 ? View.VISIBLE : View.GONE);
+        mCount.setText(CromikoPopupGuardMenu.format(count));
+        mView.setContentDescription(
+                mActivity.getString(
+                        R.string.cromiko_popup_guard_toast_description,
+                        title,
+                        link.getShortUrl(),
+                        count));
+    }
+
+    private void show() {
+        View view = mView;
+        if (view == null) return;
+        boolean animate = ValueAnimator.areAnimatorsEnabled();
+        if (view.getParent() == null) {
+            ViewGroup parent = mActivity.findViewById(R.id.bottom_container);
+            if (parent == null) parent = mActivity.findViewById(android.R.id.content);
+            if (parent == null) return;
+            parent.addView(view);
+        }
+        view.animate().cancel();
+        if (!mShowing) {
+            mShowing = true;
+            view.setTranslationX(0);
+            if (animate) {
+                // Slides up from under the toolbar with a little bounce.
+                view.setAlpha(0f);
+                view.setTranslationY(96 * mActivity.getResources().getDisplayMetrics().density);
+                view.animate()
+                        .alpha(1f)
+                        .translationY(0)
+                        .setDuration(380)
+                        .setInterpolator(new OvershootInterpolator(0.9f))
+                        .start();
+            } else {
+                view.setAlpha(1f);
+                view.setTranslationY(0);
+            }
+        } else if (animate) {
+            // Already there: a little pulse for the new one.
+            view.setScaleX(1.03f);
+            view.setScaleY(1.03f);
+            view.animate().scaleX(1f).scaleY(1f).setDuration(240).start();
+        }
+        view.announceForAccessibility(view.getContentDescription());
+        startTimer();
+    }
+
+    private void startTimer() {
+        View bar = mTimerBar;
+        if (bar == null) return;
+        if (mTimer != null) mTimer.cancel();
+        AccessibilityManager accessibility = mActivity.getSystemService(AccessibilityManager.class);
+        int duration =
+                accessibility == null
+                        ? SHOW_MS
+                        : accessibility.getRecommendedTimeoutMillis(
+                                SHOW_MS,
+                                AccessibilityManager.FLAG_CONTENT_TEXT
+                                        | AccessibilityManager.FLAG_CONTENT_CONTROLS);
+        bar.setPivotX(bar.getLayoutDirection() == View.LAYOUT_DIRECTION_RTL ? bar.getWidth() : 0);
+        ObjectAnimator timer = ObjectAnimator.ofFloat(bar, View.SCALE_X, 1f, 0f);
+        timer.setDuration(duration);
+        timer.setInterpolator(new LinearInterpolator());
+        timer.addListener(
+                new AnimatorListenerAdapter() {
+                    private boolean mCanceled;
+
+                    @Override
+                    public void onAnimationCancel(Animator animation) {
+                        mCanceled = true;
+                    }
+
+                    @Override
+                    public void onAnimationEnd(Animator animation) {
+                        if (!mCanceled && mTimer == animation) hide(/* animate= */ true);
+                    }
+                });
+        mTimer = timer;
+        // With animations off, the animator ends at once: wait the same time instead.
+        if (ValueAnimator.areAnimatorsEnabled()) {
+            timer.start();
+        } else {
+            bar.setScaleX(1f);
+            bar.postDelayed(
+                    () -> {
+                        if (mTimer == timer) hide(/* animate= */ false);
+                    },
+                    duration);
+        }
+    }
+
+    private void hide(boolean animate) {
+        if (mTimer != null) {
+            ObjectAnimator timer = mTimer;
+            mTimer = null;
+            timer.cancel();
+        }
+        View view = mView;
+        if (!mShowing || view == null) return;
+        mShowing = false;
+        view.animate().cancel();
+        if (animate && ValueAnimator.areAnimatorsEnabled()) {
+            view.animate()
+                    .alpha(0f)
+                    .translationY(view.getHeight() * 0.6f)
+                    .setDuration(200)
+                    .setInterpolator(new AccelerateInterpolator())
+                    .withEndAction(() -> removeView(view))
+                    .start();
+        } else {
+            removeView(view);
+        }
+    }
+
+    private void removeView(View view) {
+        if (mShowing) return;
+        ViewGroup parent = (ViewGroup) view.getParent();
+        if (parent != null) parent.removeView(view);
+    }
+
+    private void openMenu() {
+        WebContents webContents = mWebContents;
+        if (webContents == null || webContents.isDestroyed() || mLinks.isEmpty()) return;
+        hide(/* animate= */ true);
+        CromikoPopupGuardMenu menu =
+                new CromikoPopupGuardMenu(
+                        mActivity,
+                        webContents,
+                        mLinks,
+                        mPage,
+                        () -> {
+                            mMenu = null;
+                        });
+        mMenu = menu;
+        menu.show();
+    }
+
+    /** Swipes the toast away to the side, pausing it while touched. */
+    private class SwipeListener implements View.OnTouchListener {
+        private final int mSlop = ViewConfiguration.get(mActivity).getScaledTouchSlop();
+        private float mDownX;
+        private boolean mSwiping;
+        private @Nullable VelocityTracker mVelocity;
+
+        @Override
+        public boolean onTouch(View view, MotionEvent event) {
+            switch (event.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN:
+                    mDownX = event.getRawX();
+                    mSwiping = false;
+                    mVelocity = VelocityTracker.obtain();
+                    mVelocity.addMovement(event);
+                    if (mTimer != null) mTimer.pause();
+                    return false;
+                case MotionEvent.ACTION_MOVE:
+                    if (mVelocity != null) mVelocity.addMovement(event);
+                    float dx = event.getRawX() - mDownX;
+                    if (!mSwiping && Math.abs(dx) > mSlop) {
+                        mSwiping = true;
+                        view.setPressed(false);
+                        view.getParent().requestDisallowInterceptTouchEvent(true);
+                    }
+                    if (mSwiping) {
+                        view.setTranslationX(dx);
+                        view.setAlpha(Math.max(0f, 1f - Math.abs(dx) / view.getWidth()));
+                        return true;
+                    }
+                    return false;
+                case MotionEvent.ACTION_UP:
+                case MotionEvent.ACTION_CANCEL:
+                    boolean swiped = false;
+                    if (mSwiping) {
+                        float distance = view.getTranslationX();
+                        float velocity = 0;
+                        if (mVelocity != null) {
+                            mVelocity.addMovement(event);
+                            mVelocity.computeCurrentVelocity(1000);
+                            velocity = mVelocity.getXVelocity();
+                        }
+                        float density = mActivity.getResources().getDisplayMetrics().density;
+                        swiped =
+                                event.getActionMasked() == MotionEvent.ACTION_UP
+                                        && (Math.abs(distance) > view.getWidth() / 3f
+                                                || (Math.abs(velocity) > 800 * density
+                                                        && Math.signum(velocity)
+                                                                == Math.signum(distance)));
+                        if (swiped) {
+                            swipeAway(view, distance);
+                        } else {
+                            view.animate()
+                                    .translationX(0)
+                                    .alpha(1f)
+                                    .setDuration(200)
+                                    .setInterpolator(new DecelerateInterpolator())
+                                    .start();
+                        }
+                    }
+                    if (mVelocity != null) {
+                        mVelocity.recycle();
+                        mVelocity = null;
+                    }
+                    if (!swiped && mTimer != null) mTimer.resume();
+                    boolean consumed = mSwiping;
+                    mSwiping = false;
+                    return consumed;
+                default:
+                    return false;
+            }
+        }
+
+        private void swipeAway(View view, float distance) {
+            if (mTimer != null) {
+                ObjectAnimator timer = mTimer;
+                mTimer = null;
+                timer.cancel();
+            }
+            mShowing = false;
+            view.animate()
+                    .translationX(Math.signum(distance) * view.getWidth())
+                    .alpha(0f)
+                    .setDuration(160)
+                    .withEndAction(() -> removeView(view))
+                    .start();
+        }
+    }
+}
