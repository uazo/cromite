@@ -0,0 +1,309 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.cromiko;
+
+import androidx.annotation.IntDef;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+import java.lang.annotation.Retention;
+import java.lang.annotation.RetentionPolicy;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+
+/**
+ * CromIKO: the trust score of a pop-up or redirect, from 0 to 100, with the reasons for it. It
+ * comes from what the browser knows, without asking anybody: who runs the site, whether Adblock
+ * Plus lists it, and what the address looks like. A login page of Google gets 80: Google is not
+ * malicious, but it tracks its visitors.
+ */
+@NullMarked
+final class CromikoTrustScore {
+    /** How far to trust it. */
+    @IntDef({Level.TRUSTED, Level.TRACKED, Level.CAREFUL, Level.RISKY})
+    @Retention(RetentionPolicy.SOURCE)
+    @interface Level {
+        int TRUSTED = 0;
+        // Trustworthy, but it tracks its visitors.
+        int TRACKED = 1;
+        int CAREFUL = 2;
+        int RISKY = 3;
+    }
+
+    /** The reasons for a score, from the worst to the best. */
+    @IntDef({
+        Reason.GENERATED_PAGE,
+        Reason.AD_NETWORK,
+        Reason.ADBLOCK_LIST,
+        Reason.AD_SHORTENER,
+        Reason.HIDDEN_ADDRESS,
+        Reason.NOT_SECURE,
+        Reason.IP_ADDRESS,
+        Reason.LOOKALIKE,
+        Reason.RISKY_ENDING,
+        Reason.APP_DOWNLOAD,
+        Reason.BLANK_WINDOW,
+        Reason.SHORT_LINK,
+        Reason.UNUSUAL_PORT,
+        Reason.FORWARDS,
+        Reason.NO_TAP,
+        Reason.TRACKERS,
+        Reason.TRACKING_CODES,
+        Reason.HOSTED,
+        Reason.UNKNOWN_PROVIDER,
+        Reason.KNOWN_PROVIDER,
+        Reason.SECURE,
+        Reason.SAME_SITE
+    })
+    @Retention(RetentionPolicy.SOURCE)
+    @interface Reason {
+        int GENERATED_PAGE = 0;
+        int AD_NETWORK = 1;
+        int ADBLOCK_LIST = 2;
+        int AD_SHORTENER = 3;
+        int HIDDEN_ADDRESS = 4;
+        int NOT_SECURE = 5;
+        int IP_ADDRESS = 6;
+        int LOOKALIKE = 7;
+        int RISKY_ENDING = 8;
+        int APP_DOWNLOAD = 9;
+        int BLANK_WINDOW = 10;
+        int SHORT_LINK = 11;
+        int UNUSUAL_PORT = 12;
+        int FORWARDS = 13;
+        int NO_TAP = 14;
+        int TRACKERS = 15;
+        int TRACKING_CODES = 16;
+        int HOSTED = 17;
+        int UNKNOWN_PROVIDER = 18;
+        int KNOWN_PROVIDER = 19;
+        int SECURE = 20;
+        int SAME_SITE = 21;
+    }
+
+    /** How a reason weighs. */
+    @IntDef({Weight.BAD, Weight.WARNING, Weight.NOTE, Weight.GOOD})
+    @Retention(RetentionPolicy.SOURCE)
+    @interface Weight {
+        int BAD = 0;
+        int WARNING = 1;
+        int NOTE = 2;
+        int GOOD = 3;
+    }
+
+    /** A trust score and its reasons. */
+    static final class Result {
+        final int score;
+        final @Level int level;
+        // From the worst to the best.
+        final List<Integer> reasons;
+        final CromikoUrlProviders.@Nullable Provider provider;
+
+        Result(
+                int score,
+                @Level int level,
+                List<Integer> reasons,
+                CromikoUrlProviders.@Nullable Provider provider) {
+            this.score = score;
+            this.level = level;
+            this.reasons = reasons;
+            this.provider = provider;
+        }
+    }
+
+    // The scores where the levels start.
+    static final int TRUSTED_SCORE = 75;
+    static final int CAREFUL_SCORE = 45;
+
+    // Domain endings that are cheap and full of spam and phishing.
+    private static final Set<String> RISKY_ENDINGS =
+            Set.of(
+                    "zip", "mov", "xyz", "top", "click", "cfd", "sbs", "gq", "tk", "ml", "ga", "cf",
+                    "buzz", "rest", "cam", "icu", "monster", "quest", "bond", "cyou", "autos",
+                    "boats", "hair", "beauty", "skin", "makeup", "mom", "lat", "pw", "work");
+
+    // Parameters of links that track who clicked.
+    private static final Set<String> TRACKING_PARAMETERS =
+            Set.of(
+                    "utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content", "gclid",
+                    "gbraid", "wbraid", "dclid", "fbclid", "msclkid", "yclid", "twclid", "ttclid",
+                    "li_fat_id", "mc_eid", "mc_cid", "igshid", "_hsenc", "_hsmi", "mkt_tok",
+                    "ref_src", "s_cid", "clickid", "click_id", "subid", "sub_id", "affid",
+                    "aff_id", "zoneid", "zone_id", "campaign_id", "pubid", "tracking_id");
+
+    // Files that install programs.
+    private static final String[] APP_FILES = {
+        ".apk", ".apks", ".xapk", ".exe", ".msi", ".scr", ".bat", ".cmd", ".dmg", ".pkg", ".jar",
+        ".vbs", ".ps1"
+    };
+
+    private CromikoTrustScore() {}
+
+    /** Returns the weight of |reason|. */
+    static @Weight int getWeight(@Reason int reason) {
+        if (reason <= Reason.APP_DOWNLOAD) return Weight.BAD;
+        if (reason <= Reason.NO_TAP) return Weight.WARNING;
+        if (reason <= Reason.UNKNOWN_PROVIDER) return Weight.NOTE;
+        return Weight.GOOD;
+    }
+
+    /**
+     * Returns the trust score of |link|.
+     *
+     * @param link The pop-up or redirect.
+     * @param pageSite The site of the page that opened it, like "example.com".
+     */
+    static Result evaluate(CromikoHeldLink link, String pageSite) {
+        List<Integer> reasons = new ArrayList<>();
+        String site = link.site.toLowerCase(Locale.ROOT);
+        String scheme = link.scheme.toLowerCase(Locale.ROOT);
+        boolean web = "https".equals(scheme) || "http".equals(scheme);
+        if (!web || link.host.isEmpty()) {
+            // about:blank is a window that the page fills; data: and blob: are pages it made.
+            boolean blank = "about".equals(scheme);
+            reasons.add(blank ? Reason.BLANK_WINDOW : Reason.GENERATED_PAGE);
+            if (!link.userGesture) reasons.add(Reason.NO_TAP);
+            int score = (blank ? 50 : 25) - (link.userGesture ? 0 : 10);
+            return finish(score, false, reasons, null);
+        }
+
+        String ending = site.substring(site.lastIndexOf('.') + 1);
+        boolean riskyEnding = RISKY_ENDINGS.contains(ending);
+        boolean lookalike = link.host.toLowerCase(Locale.ROOT).contains("xn--");
+        // A known name is no proof on an IP address, a look-alike or a risky domain.
+        CromikoUrlProviders.Provider provider =
+                link.ipAddress || lookalike || riskyEnding ? null : CromikoUrlProviders.find(site);
+
+        int score;
+        boolean tracked = false;
+        if (provider == null) {
+            score = 65;
+            reasons.add(Reason.UNKNOWN_PROVIDER);
+        } else if (provider.kind == CromikoUrlProviders.Kind.AD_NETWORK) {
+            score = 15;
+            reasons.add(Reason.AD_NETWORK);
+            tracked = true;
+        } else if (provider.kind == CromikoUrlProviders.Kind.HOSTING) {
+            score = 60;
+            reasons.add(Reason.HOSTED);
+        } else {
+            score = provider.tracks ? 80 : 95;
+            reasons.add(Reason.KNOWN_PROVIDER);
+            if (provider.tracks) {
+                reasons.add(Reason.TRACKERS);
+                tracked = true;
+            }
+        }
+
+        if ("https".equals(scheme)) {
+            reasons.add(Reason.SECURE);
+        } else {
+            score -= 25;
+            reasons.add(Reason.NOT_SECURE);
+        }
+        if (link.adblocked) {
+            score = Math.min(score - 40, 25);
+            reasons.add(Reason.ADBLOCK_LIST);
+        }
+        if (CromikoUrlProviders.isAdShortener(site)) {
+            score -= 30;
+            reasons.add(Reason.AD_SHORTENER);
+        } else if (CromikoUrlProviders.isShortener(site)) {
+            score -= 15;
+            reasons.add(Reason.SHORT_LINK);
+        }
+        if (link.ipAddress) {
+            score -= 20;
+            reasons.add(Reason.IP_ADDRESS);
+        }
+        if (lookalike) {
+            score -= 20;
+            reasons.add(Reason.LOOKALIKE);
+        }
+        if (riskyEnding) {
+            score -= 15;
+            reasons.add(Reason.RISKY_ENDING);
+        }
+        if (link.userInfo) {
+            score -= 30;
+            reasons.add(Reason.HIDDEN_ADDRESS);
+        }
+        if (link.port != 0) {
+            score -= 10;
+            reasons.add(Reason.UNUSUAL_PORT);
+        }
+        int trackingCodes = countTrackingParameters(link.query);
+        if (trackingCodes > 0) {
+            score -= Math.min(15, 5 * trackingCodes);
+            reasons.add(Reason.TRACKING_CODES);
+            tracked = true;
+        }
+        // Known companies send addresses along for logins; unknown sites to hide where you go.
+        if (provider == null && forwardsElsewhere(link.query)) {
+            score -= 10;
+            reasons.add(Reason.FORWARDS);
+        }
+        if (isAppDownload(link.path)) {
+            score -= 20;
+            reasons.add(Reason.APP_DOWNLOAD);
+        }
+        if (!link.userGesture) {
+            score -= 10;
+            reasons.add(Reason.NO_TAP);
+        }
+        if (!pageSite.isEmpty() && pageSite.equalsIgnoreCase(site)) {
+            score += 10;
+            reasons.add(Reason.SAME_SITE);
+        }
+        return finish(score, tracked, reasons, provider);
+    }
+
+    private static Result finish(
+            int score,
+            boolean tracked,
+            List<Integer> reasons,
+            CromikoUrlProviders.@Nullable Provider provider) {
+        score = Math.max(0, Math.min(100, score));
+        @Level int level;
+        if (score >= TRUSTED_SCORE) {
+            level = tracked ? Level.TRACKED : Level.TRUSTED;
+        } else {
+            level = score >= CAREFUL_SCORE ? Level.CAREFUL : Level.RISKY;
+        }
+        Collections.sort(reasons);
+        return new Result(score, level, reasons, provider);
+    }
+
+    // Counts the parameters of |query| that track who clicked.
+    private static int countTrackingParameters(String query) {
+        int count = 0;
+        for (String parameter : query.split("&")) {
+            int equals = parameter.indexOf('=');
+            String name = equals < 0 ? parameter : parameter.substring(0, equals);
+            if (TRACKING_PARAMETERS.contains(name.toLowerCase(Locale.ROOT))) count++;
+        }
+        return count;
+    }
+
+    // Whether |query| carries the address of another page, to send you on.
+    private static boolean forwardsElsewhere(String query) {
+        String lower = query.toLowerCase(Locale.ROOT);
+        return lower.contains("=http://")
+                || lower.contains("=https://")
+                || lower.contains("=http%3a%2f%2f")
+                || lower.contains("=https%3a%2f%2f");
+    }
+
+    private static boolean isAppDownload(String path) {
+        String lower = path.toLowerCase(Locale.ROOT);
+        for (String file : APP_FILES) {
+            if (lower.endsWith(file)) return true;
+        }
+        return false;
+    }
+}
