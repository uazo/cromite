diff --git a/chrome/browser/cromiko/android/cromiko_popup_guard.cc b/chrome/browser/cromiko/android/cromiko_popup_guard.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/cromiko/android/cromiko_popup_guard.cc
@@ -0,0 +1,399 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+#include "chrome/browser/cromiko/android/cromiko_popup_guard.h"
+
+#include <algorithm>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/android/jni_android.h"
+#include "base/android/jni_string.h"
+#include "base/android/scoped_java_ref.h"
+#include "base/json/json_writer.h"
+#include "base/strings/strcat.h"
+#include "base/values.h"
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "components/adblock/content/browser/adblock_filter_match.h"
+#include "components/adblock/content/browser/factories/resource_classification_runner_factory.h"
+#include "components/adblock/content/browser/factories/subscription_service_factory.h"
+#include "components/adblock/content/browser/resource_classification_runner.h"
+#include "components/adblock/core/configuration/filtering_configuration.h"
+#include "components/adblock/core/subscription/subscription_service.h"
+#include "components/blocked_content/popup_blocker_tab_helper.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/common/content_settings.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/navigation_throttle.h"
+#include "content/public/browser/navigation_throttle_registry.h"
+#include "content/public/browser/page_navigator.h"
+#include "content/public/browser/reload_type.h"
+#include "content/public/browser/visibility.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/origin.h"
+
+// Must come after all headers that specialize FromJniType() / ToJniType().
+#include "chrome/browser/cromiko/jni_headers/CromikoPopupGuardBridge_jni.h"
+
+using base::android::JavaRef;
+using net::registry_controlled_domains::GetDomainAndRegistry;
+using net::registry_controlled_domains::SameDomainOrHost;
+
+namespace cromiko {
+
+namespace {
+
+// The most pop-ups and redirects listed per tab, like the popup blocker.
+constexpr size_t kMaxItems = 25;
+
+// The longest part of an address sent to the toast: data: pop-ups can be huge.
+constexpr size_t kMaxShownLength = 2048;
+
+constexpr auto kSamePrivateSite =
+    net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES;
+
+// The site of |url|, for the provider and the trust score: "google.com" for
+// "https://accounts.google.com/", the host when it has no registry.
+std::string GetSite(const GURL& url) {
+  std::string site = GetDomainAndRegistry(
+      url, net::registry_controlled_domains::EXCLUDE_PRIVATE_REGISTRIES);
+  return site.empty() ? url.GetHost() : site;
+}
+
+// Cuts |text|, a part of an address, to the length the toast shows.
+std::string Shorten(std::string text) {
+  if (text.size() > kMaxShownLength) {
+    text.resize(kMaxShownLength);
+  }
+  return text;
+}
+
+adblock::SubscriptionService* GetSubscriptionService(
+    content::WebContents* web_contents) {
+  return adblock::SubscriptionServiceFactory::GetForBrowserContext(
+      web_contents->GetBrowserContext());
+}
+
+// Whether Adblock Plus would close a pop-up of |web_contents| to |url|.
+bool IsOnAdblockList(content::WebContents* web_contents, const GURL& url) {
+  adblock::SubscriptionService* subscriptions =
+      GetSubscriptionService(web_contents);
+  adblock::ResourceClassificationRunner* classifier =
+      adblock::ResourceClassificationRunnerFactory::GetForBrowserContext(
+          web_contents->GetBrowserContext());
+  if (!subscriptions || !classifier) {
+    return false;
+  }
+  return classifier->ShouldBlockPopup(subscriptions->GetCurrentSnapshot(), url,
+                                      web_contents->GetPrimaryMainFrame()) ==
+         adblock::FilterMatchResult::kBlockRule;
+}
+
+// Lets pages and pop-ups of the host of |url| through Adblock Plus until the
+// browser restarts, like "Proceed" on the page of Adblock Plus.
+void AllowThroughAdblock(content::WebContents* web_contents, const GURL& url) {
+  adblock::SubscriptionService* subscriptions =
+      GetSubscriptionService(web_contents);
+  adblock::FilteringConfiguration* configuration =
+      subscriptions ? subscriptions->GetAdblockFilteringConfiguration()
+                    : nullptr;
+  // Without a host, the filter would let everything through.
+  if (configuration && !url.host().empty()) {
+    configuration->AddTemporaryCustomFilter(
+        base::StrCat({"@@||", url.host(), "^$document,popup"}));
+  }
+}
+
+// Holds the redirects of a tab to another site that the user did not ask for:
+// without a tap, started by an ad, or started by another site, like a frame of
+// an ad or the pop-up of the page. A tap on a link of the page goes through.
+class RedirectThrottle : public content::NavigationThrottle {
+ public:
+  explicit RedirectThrottle(content::NavigationThrottleRegistry& registry)
+      : content::NavigationThrottle(registry) {}
+  RedirectThrottle(const RedirectThrottle&) = delete;
+  RedirectThrottle& operator=(const RedirectThrottle&) = delete;
+  ~RedirectThrottle() override = default;
+
+  // content::NavigationThrottle:
+  ThrottleCheckResult WillStartRequest() override {
+    content::NavigationHandle* handle = navigation_handle();
+    if (!ShouldHold(*handle)) {
+      return PROCEED;
+    }
+    PopupGuard::OnRedirectHeld(handle->GetWebContents(), handle->GetURL(),
+                               handle->HasUserGesture());
+    return CANCEL_AND_IGNORE;
+  }
+
+  const char* GetNameForLogging() override {
+    return "CromikoRedirectThrottle";
+  }
+
+ private:
+  static bool ShouldHold(content::NavigationHandle& handle) {
+    if (handle.IsSameDocument() || handle.IsPost() ||
+        handle.IsPageActivation() ||
+        handle.GetReloadType() != content::ReloadType::NONE ||
+        (handle.GetPageTransition() & ui::PAGE_TRANSITION_FORWARD_BACK)) {
+      return false;
+    }
+    content::WebContents* web_contents = handle.GetWebContents();
+    const GURL& page = web_contents->GetLastCommittedURL();
+    const GURL& target = handle.GetURL();
+    if (!page.SchemeIsHTTPOrHTTPS() || !target.SchemeIsHTTPOrHTTPS() ||
+        SameDomainOrHost(page, target, kSamePrivateSite)) {
+      return false;
+    }
+    const std::optional<url::Origin>& initiator = handle.GetInitiatorOrigin();
+    bool from_page =
+        initiator && SameDomainOrHost(page, *initiator, kSamePrivateSite);
+    if (handle.HasUserGesture() && !handle.StartedByAd() && from_page) {
+      return false;
+    }
+    return PopupGuard::HoldsAll(web_contents, page);
+  }
+};
+
+}  // namespace
+
+PopupGuard::PopupGuard(content::WebContents* web_contents)
+    : content::WebContentsObserver(web_contents),
+      content::WebContentsUserData<PopupGuard>(*web_contents) {}
+
+PopupGuard::~PopupGuard() = default;
+
+// static
+bool PopupGuard::HoldsAll(content::WebContents* web_contents,
+                          const GURL& page_url) {
+  HostContentSettingsMap* settings =
+      HostContentSettingsMapFactory::GetForProfile(
+          web_contents->GetBrowserContext());
+  return settings && page_url.is_valid() &&
+         settings->GetContentSetting(page_url, page_url,
+                                     ContentSettingsType::POPUPS) ==
+             CONTENT_SETTING_ASK;
+}
+
+// static
+void PopupGuard::OnPopupHeld(content::WebContents* web_contents,
+                             const GURL& url,
+                             bool user_gesture) {
+  auto* popup_blocker =
+      blocked_content::PopupBlockerTabHelper::FromWebContents(web_contents);
+  if (!popup_blocker) {
+    return;
+  }
+  // The pop-up that was just held is the last one: their ids go up.
+  blocked_content::PopupBlockerTabHelper::PopupIdMap popups =
+      popup_blocker->GetBlockedPopupRequests();
+  if (popups.empty()) {
+    return;
+  }
+  CreateForWebContents(web_contents);
+  FromWebContents(web_contents)
+      ->Add(/*redirect=*/false, url, user_gesture, popups.rbegin()->first);
+}
+
+// static
+void PopupGuard::OnRedirectHeld(content::WebContents* web_contents,
+                                const GURL& url,
+                                bool user_gesture) {
+  CreateForWebContents(web_contents);
+  FromWebContents(web_contents)
+      ->Add(/*redirect=*/true, url, user_gesture, /*popup_id=*/0);
+}
+
+// static
+void PopupGuard::MaybeAddThrottle(
+    content::NavigationThrottleRegistry& registry) {
+  content::NavigationHandle& handle = registry.GetNavigationHandle();
+  if (handle.IsInPrimaryMainFrame() && handle.IsRendererInitiated()) {
+    registry.AddThrottle(std::make_unique<RedirectThrottle>(registry));
+  }
+}
+
+void PopupGuard::Add(bool redirect,
+                     const GURL& url,
+                     bool user_gesture,
+                     int32_t popup_id) {
+  if (!url.is_valid()) {
+    return;
+  }
+  // Pages try the same pop-up again on every tap: keep the last one.
+  std::erase_if(items_, [&](const Item& item) {
+    return item.redirect == redirect && item.url == url;
+  });
+  if (items_.size() >= kMaxItems) {
+    items_.erase(items_.begin());
+  }
+  Item item;
+  item.id = next_id_++;
+  item.redirect = redirect;
+  item.url = url;
+  item.user_gesture = user_gesture;
+  item.adblocked = IsOnAdblockList(web_contents(), url);
+  item.popup_id = popup_id;
+  items_.push_back(std::move(item));
+  unseen_ = web_contents()->GetVisibility() != content::Visibility::VISIBLE;
+  Notify(/*added=*/true);
+}
+
+std::vector<PopupGuard::Item>::iterator PopupGuard::Find(int id) {
+  return std::ranges::find(items_, id, &Item::id);
+}
+
+void PopupGuard::Open(int id) {
+  auto it = Find(id);
+  if (it == items_.end()) {
+    return;
+  }
+  Item item = std::move(*it);
+  items_.erase(it);
+  if (item.adblocked) {
+    AllowThroughAdblock(web_contents(), item.url);
+  }
+  if (item.redirect) {
+    // Opened by the browser, so the redirect throttle lets it through.
+    web_contents()->OpenURL(
+        content::OpenURLParams(item.url, content::Referrer(),
+                               WindowOpenDisposition::CURRENT_TAB,
+                               ui::PAGE_TRANSITION_LINK,
+                               /*is_renderer_initiated=*/false),
+        /*navigation_handle_callback=*/{});
+  } else if (auto* popup_blocker =
+                 blocked_content::PopupBlockerTabHelper::FromWebContents(
+                     web_contents())) {
+    // CURRENT_TAB opens it the way the page asked for.
+    popup_blocker->ShowBlockedPopup(item.popup_id,
+                                    WindowOpenDisposition::CURRENT_TAB);
+  }
+  Notify(/*added=*/false);
+}
+
+void PopupGuard::Dismiss(int id) {
+  auto it = Find(id);
+  if (it == items_.end()) {
+    return;
+  }
+  items_.erase(it);
+  Notify(/*added=*/false);
+}
+
+void PopupGuard::AllowSite(int id) {
+  const GURL& page = web_contents()->GetLastCommittedURL();
+  HostContentSettingsMap* settings =
+      HostContentSettingsMapFactory::GetForProfile(
+          web_contents()->GetBrowserContext());
+  if (settings && page.SchemeIsHTTPOrHTTPS()) {
+    settings->SetContentSettingDefaultScope(
+        page, GURL(), ContentSettingsType::POPUPS, CONTENT_SETTING_ALLOW);
+  }
+  Open(id);
+}
+
+void PopupGuard::Notify(bool added) {
+  base::ListValue items;
+  for (const Item& item : items_) {
+    const GURL& url = item.url;
+    items.Append(base::DictValue()
+                     .Set("id", item.id)
+                     .Set("redirect", item.redirect)
+                     .Set("url", Shorten(url.spec()))
+                     .Set("scheme", url.GetScheme())
+                     .Set("host", url.GetHost())
+                     .Set("site", GetSite(url))
+                     .Set("ip", url.HostIsIPAddress())
+                     .Set("port", url.has_port() ? url.IntPort() : 0)
+                     .Set("userinfo", url.has_username() || url.has_password())
+                     .Set("path", Shorten(url.GetPath()))
+                     .Set("query", Shorten(url.GetQuery()))
+                     .Set("gesture", item.user_gesture)
+                     .Set("adblock", item.adblocked));
+  }
+  base::DictValue state;
+  state.Set("items", std::move(items));
+  state.Set("page", GetSite(web_contents()->GetLastCommittedURL()));
+  JNIEnv* env = base::android::AttachCurrentThread();
+  Java_CromikoPopupGuardBridge_onChanged(
+      env, web_contents()->GetJavaWebContents(),
+      base::WriteJson(state).value_or("{}"), added);
+}
+
+void PopupGuard::DidFinishNavigation(
+    content::NavigationHandle* navigation_handle) {
+  // A new page: the popup blocker forgets the pop-ups of the old one, too.
+  if (!navigation_handle->IsInPrimaryMainFrame() ||
+      !navigation_handle->HasCommitted() ||
+      navigation_handle->IsSameDocument() || items_.empty()) {
+    return;
+  }
+  items_.clear();
+  unseen_ = false;
+  Notify(/*added=*/false);
+}
+
+void PopupGuard::OnVisibilityChanged(content::Visibility visibility) {
+  if (visibility == content::Visibility::VISIBLE) {
+    if (unseen_ && !items_.empty()) {
+      unseen_ = false;
+      Notify(/*added=*/true);
+    }
+    return;
+  }
+  if (visibility == content::Visibility::HIDDEN) {
+    JNIEnv* env = base::android::AttachCurrentThread();
+    Java_CromikoPopupGuardBridge_onHidden(env,
+                                          web_contents()->GetJavaWebContents());
+  }
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(PopupGuard);
+
+}  // namespace cromiko
+
+namespace {
+
+cromiko::PopupGuard* GetPopupGuard(const JavaRef<jobject>& j_web_contents) {
+  content::WebContents* web_contents =
+      content::WebContents::FromJavaWebContents(j_web_contents);
+  return web_contents ? cromiko::PopupGuard::FromWebContents(web_contents)
+                      : nullptr;
+}
+
+}  // namespace
+
+static void JNI_CromikoPopupGuardBridge_Open(
+    JNIEnv* env,
+    const JavaRef<jobject>& j_web_contents,
+    jint id) {
+  if (cromiko::PopupGuard* guard = GetPopupGuard(j_web_contents)) {
+    guard->Open(id);
+  }
+}
+
+static void JNI_CromikoPopupGuardBridge_Dismiss(
+    JNIEnv* env,
+    const JavaRef<jobject>& j_web_contents,
+    jint id) {
+  if (cromiko::PopupGuard* guard = GetPopupGuard(j_web_contents)) {
+    guard->Dismiss(id);
+  }
+}
+
+static void JNI_CromikoPopupGuardBridge_AllowSite(
+    JNIEnv* env,
+    const JavaRef<jobject>& j_web_contents,
+    jint id) {
+  if (cromiko::PopupGuard* guard = GetPopupGuard(j_web_contents)) {
+    guard->AllowSite(id);
+  }
+}
