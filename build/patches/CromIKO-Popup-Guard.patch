@@ -0,0 +1,82 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.cromiko;
+
+import org.jni_zero.CalledByNative;
+import org.jni_zero.JniType;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.base.ThreadUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.content_public.browser.WebContents;
+
+/**
+ * CromIKO: the bridge of the pop-up guard, which holds the pop-ups and redirects of the tabs (see
+ * cromiko_popup_guard.h). The browser shows them with the {@link Observer}, and opens or forgets
+ * them here.
+ */
+@NullMarked
+public final class CromikoPopupGuardBridge {
+    /** Shows what the pop-up guard holds. */
+    public interface Observer {
+        /**
+         * Called when the pop-ups and redirects held in a tab change.
+         *
+         * @param webContents The tab.
+         * @param state JSON: "items", the held pop-ups and redirects, and "page", the site of the
+         *     tab.
+         * @param added Whether something was just held.
+         */
+        void onChanged(WebContents webContents, String state, boolean added);
+
+        /** Called when the tab is hidden. */
+        void onHidden(WebContents webContents);
+    }
+
+    private static @Nullable Observer sObserver;
+
+    private CromikoPopupGuardBridge() {}
+
+    /** Sets the observer that shows what the pop-up guard holds. */
+    public static void setObserver(Observer observer) {
+        ThreadUtils.assertOnUiThread();
+        sObserver = observer;
+    }
+
+    /** Opens the pop-up or redirect |id| of |webContents|, even past Adblock Plus. */
+    public static void open(WebContents webContents, int id) {
+        CromikoPopupGuardBridgeJni.get().open(webContents, id);
+    }
+
+    /** Forgets the pop-up or redirect |id| of |webContents|. */
+    public static void dismiss(WebContents webContents, int id) {
+        CromikoPopupGuardBridgeJni.get().dismiss(webContents, id);
+    }
+
+    /** Allows the pop-ups and redirects of the site of |webContents|, and opens |id|. */
+    public static void allowSite(WebContents webContents, int id) {
+        CromikoPopupGuardBridgeJni.get().allowSite(webContents, id);
+    }
+
+    @CalledByNative
+    private static void onChanged(
+            WebContents webContents, @JniType("std::string") String state, boolean added) {
+        if (sObserver != null) sObserver.onChanged(webContents, state, added);
+    }
+
+    @CalledByNative
+    private static void onHidden(WebContents webContents) {
+        if (sObserver != null) sObserver.onHidden(webContents);
+    }
+
+    @NativeMethods
+    interface Natives {
+        void open(WebContents webContents, int id);
+
+        void dismiss(WebContents webContents, int id);
+
+        void allowSite(WebContents webContents, int id);
+    }
+}
