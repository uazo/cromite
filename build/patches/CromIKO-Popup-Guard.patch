diff --git a/chrome/android/java/res/layout/cromiko_popup_guard_toast.xml b/chrome/android/java/res/layout/cromiko_popup_guard_toast.xml
new file mode 100644
--- /dev/null
+++ b/chrome/android/java/res/layout/cromiko_popup_guard_toast.xml
@@ -0,0 +1,114 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+Copyright 2026 The CromIKO Authors
+License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+-->
+
+<!-- The toast of the CromIKO pop-up guard: what it held, and a button to decide. -->
+<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:background="@drawable/cromiko_popup_guard_toast_background"
+    android:elevation="6dp"
+    android:clickable="true"
+    android:focusable="true">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:minHeight="64dp"
+        android:gravity="center_vertical"
+        android:orientation="horizontal"
+        android:paddingStart="12dp"
+        android:paddingEnd="10dp"
+        android:paddingTop="10dp"
+        android:paddingBottom="10dp">
+
+        <FrameLayout
+            android:layout_width="44dp"
+            android:layout_height="44dp">
+
+            <ImageView
+                android:id="@+id/cromiko_popup_guard_toast_icon"
