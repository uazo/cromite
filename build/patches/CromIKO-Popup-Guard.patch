+        Provider proton = company("Proton", 0xFF6D4AFF, false);
+        brands(proton, "protonmail");
+        sites(proton, "proton.me");
+        brands(company("DuckDuckGo", 0xFFDE5833, false), "duckduckgo");
+
+        // Ad networks that open pop-ups and redirects.
+        sites(adNetwork("Google Ads"), "doubleclick.net", "googlesyndication.com",
+                "googleadservices.com");
+        sites(adNetwork("PopAds"), "popads.net");
+        sites(adNetwork("PopCash"), "popcash.net");
+        sites(adNetwork("PropellerAds"), "propellerads.com", "propellerclick.com",
+                "onclickads.net", "onclkds.com");
+        sites(adNetwork("Monetag"), "monetag.com");
+        sites(adNetwork("Adsterra"), "adsterra.com");
+        sites(adNetwork("ExoClick"), "exoclick.com", "exosrv.com");
+        sites(adNetwork("JuicyAds"), "juicyads.com");
+        sites(adNetwork("TrafficJunky"), "trafficjunky.net");
+        sites(adNetwork("Clickadu"), "clickadu.com");
+        sites(adNetwork("HilltopAds"), "hilltopads.net");
+        sites(adNetwork("Adcash"), "adcash.com");
+        sites(adNetwork("AdMaven"), "admaven.com", "ad-maven.com");
+        sites(adNetwork("Galaksion"), "galaksion.com");
+        sites(adNetwork("Taboola"), "taboola.com");
+        sites(adNetwork("Outbrain"), "outbrain.com");
+        sites(adNetwork("Criteo"), "criteo.com");
+        sites(adNetwork("Xandr"), "adnxs.com");
+    }
+
+    private CromikoUrlProviders() {}
+
+    /** Returns who runs |site|, a domain like "google.com", or null if CromIKO does not know. */
+    static @Nullable Provider find(String site) {
+        site = site.toLowerCase(Locale.ROOT);
+        Provider provider = BY_SITE.get(site);
+        if (provider != null) return provider;
+        int dot = site.indexOf('.');
+        if (dot <= 0 || !USUAL_ENDINGS.contains(site.substring(dot + 1))) return null;
+        return BY_NAME.get(site.substring(0, dot));
+    }
+
+    /** Whether |site| is a link shortener. */
+    static boolean isShortener(String site) {
+        return SHORTENERS.contains(site.toLowerCase(Locale.ROOT));
+    }
+
+    /** Whether |site| is a link shortener that shows ads first. */
+    static boolean isAdShortener(String site) {
+        return AD_SHORTENERS.contains(site.toLowerCase(Locale.ROOT));
+    }
+
+    private static Provider company(String name, @ColorInt int color, boolean tracks) {
+        return new Provider(name, color, tracks, Kind.COMPANY);
+    }
+
+    private static Provider hosting(String name, @ColorInt int color) {
+        return new Provider(name, color, false, Kind.HOSTING);
+    }
+
+    private static Provider adNetwork(String name) {
+        return new Provider(name, 0xFFD93025, true, Kind.AD_NETWORK);
+    }
+
+    private static void brands(Provider provider, String... names) {
+        for (String name : names) BY_NAME.put(name, provider);
+    }
+
+    private static void sites(Provider provider, String... sites) {
+        for (String site : sites) BY_SITE.put(site, provider);
+    }
+}
