diff --git a/chrome/android/java/res/layout/cromiko_popup_guard_menu.xml b/chrome/android/java/res/layout/cromiko_popup_guard_menu.xml
new file mode 100644
--- /dev/null
+++ b/chrome/android/java/res/layout/cromiko_popup_guard_menu.xml
@@ -0,0 +1,259 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+Copyright 2026 The CromIKO Authors
+License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+-->
+
+<!-- The menu of the CromIKO pop-up guard: where a held pop-up or redirect goes, who runs it, how
+     far to trust it, and whether to open it. -->
+<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:fillViewport="true">
+
+    <LinearLayout
+        android:id="@+id/cromiko_popup_guard_menu_card"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_margin="12dp"
+        android:background="@drawable/cromiko_popup_guard_menu_background"
+        android:elevation="8dp"
+        android:orientation="vertical"
+        android:paddingStart="20dp"
+        android:paddingEnd="12dp"
+        android:paddingTop="12dp"
+        android:paddingBottom="16dp">
+
+        <!-- What it is, the pager and the close button. -->
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:gravity="center_vertical"
+            android:orientation="horizontal">
+
+            <ImageView
+                android:layout_width="12dp"
+                android:layout_height="12dp"
+                android:layout_marginEnd="6dp"
+                android:src="@drawable/cromiko_ic_guard_star"
+                android:importantForAccessibility="no" />
+
+            <TextView
+                android:id="@+id/cromiko_popup_guard_menu_kind"
+                android:layout_width="0dp"
+                android:layout_height="wrap_content"
+                android:layout_weight="1"
+                android:maxLines="1"
+                android:ellipsize="end"
+                android:accessibilityHeading="true"
+                android:textAppearance="@style/TextAppearance.TextSmall.Secondary" />
+
+            <ImageView
+                android:id="@+id/cromiko_popup_guard_menu_previous"
+                android:layout_width="40dp"
+                android:layout_height="40dp"
+                android:padding="8dp"
+                android:rotation="180"
+                android:background="@drawable/cromiko_popup_guard_button_text"
+                android:src="@drawable/cromiko_ic_guard_chevron"
+                android:tint="?attr/colorOnSurfaceVariant"
+                android:contentDescription="@string/cromiko_popup_guard_previous" />
+
+            <TextView
+                android:id="@+id/cromiko_popup_guard_menu_pager"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:textAppearance="@style/TextAppearance.TextSmall.Secondary" />
+
+            <ImageView
+                android:id="@+id/cromiko_popup_guard_menu_next"
+                android:layout_width="40dp"
+                android:layout_height="40dp"
+                android:padding="8dp"
+                android:background="@drawable/cromiko_popup_guard_button_text"
+                android:src="@drawable/cromiko_ic_guard_chevron"
+                android:tint="?attr/colorOnSurfaceVariant"
+                android:contentDescription="@string/cromiko_popup_guard_next" />
+
+            <ImageView
+                android:id="@+id/cromiko_popup_guard_menu_close"
+                android:layout_width="40dp"
+                android:layout_height="40dp"
+                android:padding="8dp"
+                android:background="@drawable/cromiko_popup_guard_button_text"
+                android:src="@drawable/cromiko_ic_guard_close"
+                android:tint="?attr/colorOnSurfaceVariant"
+                android:contentDescription="@string/close" />
+        </LinearLayout>
+
+        <!-- Who runs it. -->
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="4dp"
+            android:layout_marginEnd="8dp"
+            android:gravity="center_vertical"
+            android:orientation="horizontal">
+
+            <TextView
+                android:id="@+id/cromiko_popup_guard_menu_provider_icon"
+                android:layout_width="40dp"
+                android:layout_height="40dp"
+                android:gravity="center"
+                android:background="@drawable/cromiko_popup_guard_circle"
+                android:textColor="@android:color/white"
+                android:textSize="18sp"
+                android:textStyle="bold"
+                android:importantForAccessibility="no" />
+
+            <LinearLayout
+                android:layout_width="0dp"
+                android:layout_height="wrap_content"
+                android:layout_weight="1"
+                android:layout_marginStart="12dp"
+                android:orientation="vertical">
+
+                <TextView
+                    android:id="@+id/cromiko_popup_guard_menu_provider"
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:maxLines="1"
+                    android:ellipsize="end"
+                    android:textAppearance="@style/TextAppearance.TextLarge.Primary" />
+
+                <TextView
+                    android:id="@+id/cromiko_popup_guard_menu_host"
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:maxLines="1"
+                    android:ellipsize="middle"
+                    android:textDirection="ltr"
+                    android:textAppearance="@style/TextAppearance.TextMedium.Secondary" />
+            </LinearLayout>
+        </LinearLayout>
+
+        <!-- The whole address. -->
+        <TextView
+            android:id="@+id/cromiko_popup_guard_menu_url"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="12dp"
+            android:layout_marginEnd="8dp"
+            android:background="@drawable/cromiko_popup_guard_field_background"
+            android:fontFamily="monospace"
+            android:maxLines="3"
+            android:ellipsize="end"
+            android:padding="10dp"
+            android:textDirection="ltr"
+            android:textAppearance="@style/TextAppearance.TextSmall.Secondary"
+            android:textSize="12sp" />
+
+        <!-- The trust score. -->
+        <LinearLayout
+            android:id="@+id/cromiko_popup_guard_menu_score_row"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="16dp"
+            android:gravity="center_vertical"
+            android:orientation="horizontal"
+            android:focusable="true">
+
+            <org.chromium.chrome.browser.cromiko.CromikoTrustRing
+                android:id="@+id/cromiko_popup_guard_menu_ring"
+                android:layout_width="68dp"
+                android:layout_height="68dp"
+                android:importantForAccessibility="no" />
+
+            <LinearLayout
+                android:layout_width="0dp"
+                android:layout_height="wrap_content"
+                android:layout_weight="1"
+                android:layout_marginStart="16dp"
+                android:orientation="vertical">
+
+                <TextView
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:text="@string/cromiko_popup_guard_trust_score"
+                    android:importantForAccessibility="no"
+                    android:textAppearance="@style/TextAppearance.TextSmall.Secondary" />
+
+                <TextView
+                    android:id="@+id/cromiko_popup_guard_menu_level"
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:importantForAccessibility="no"
+                    android:textAppearance="@style/TextAppearance.TextLarge.Primary"
+                    android:textStyle="bold" />
+            </LinearLayout>
+        </LinearLayout>
+
+        <!-- The reasons for the score, one row each. -->
+        <LinearLayout
+            android:id="@+id/cromiko_popup_guard_menu_reasons"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="12dp"
+            android:layout_marginEnd="8dp"
+            android:orientation="vertical" />
+
+        <TextView
+            android:id="@+id/cromiko_popup_guard_menu_adblock"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="8dp"
+            android:layout_marginEnd="8dp"
+            android:text="@string/cromiko_popup_guard_adblock_note"
+            android:textAppearance="@style/TextAppearance.TextSmall.Secondary" />
+
+        <TextView
+            android:id="@+id/cromiko_popup_guard_menu_allow"
+            android:layout_width="wrap_content"
+            android:layout_height="40dp"
+            android:layout_marginTop="8dp"
+            android:layout_marginStart="-8dp"
+            android:gravity="center_vertical"
+            android:paddingStart="8dp"
+            android:paddingEnd="8dp"
+            android:background="@drawable/cromiko_popup_guard_button_text"
+            android:maxLines="1"
+            android:ellipsize="middle"
+            android:textAppearance="@style/TextAppearance.TextMediumThick.Primary"
+            android:textColor="?attr/colorPrimary" />
+
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="8dp"
+            android:layout_marginEnd="8dp"
+            android:gravity="end"
+            android:orientation="horizontal">
+
+            <TextView
+                android:id="@+id/cromiko_popup_guard_menu_block"
+                android:layout_width="wrap_content"
+                android:layout_height="40dp"
+                android:minWidth="88dp"
+                android:gravity="center"
+                android:paddingStart="16dp"
+                android:paddingEnd="16dp"
+                android:background="@drawable/cromiko_popup_guard_button_text"
+                android:text="@string/cromiko_popup_guard_block"
+                android:textAppearance="@style/TextAppearance.TextMediumThick.Primary"
+                android:textColor="?attr/colorPrimary" />
+
+            <TextView
+                android:id="@+id/cromiko_popup_guard_menu_open"
+                android:layout_width="wrap_content"
+                android:layout_height="40dp"
+                android:layout_marginStart="8dp"
+                android:minWidth="96dp"
+                android:gravity="center"
+                android:paddingStart="20dp"
+                android:paddingEnd="20dp"
+                android:background="@drawable/cromiko_popup_guard_button_filled"
+                android:textAppearance="@style/TextAppearance.TextMediumThick.Primary"
+                android:textColor="?attr/colorOnPrimary" />
+        </LinearLayout>
+    </LinearLayout>
+</ScrollView>
