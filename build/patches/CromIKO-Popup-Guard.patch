+import com.google.android.material.color.MaterialColors;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+
+import java.text.NumberFormat;
+
+/**
+ * CromIKO: the ring of a trust score in the menu of the pop-up guard. It fills up to the score in
+ * the color of its level, counting up in the middle.
+ */
+@NullMarked
+public final class CromikoTrustRing extends View {
+    private final Paint mTrack = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mArc = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mNumber = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mOutOf = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF mOval = new RectF();
+    private final NumberFormat mFormat = NumberFormat.getIntegerInstance();
+    private final ValueAnimator mFill = ValueAnimator.ofFloat(0f, 1f);
+    private final float mStroke;
+    private int mScore;
+    // The score drawn, which counts up to the score.
+    private float mShown;
+
+    /** Constructor for inflating from XML. */
+    public CromikoTrustRing(Context context, @Nullable AttributeSet attrs) {
+        super(context, attrs);
+        mStroke = 6 * getResources().getDisplayMetrics().density;
+        mTrack.setStyle(Paint.Style.STROKE);
+        mTrack.setStrokeWidth(mStroke);
+        mArc.setStyle(Paint.Style.STROKE);
+        mArc.setStrokeWidth(mStroke);
+        mArc.setStrokeCap(Paint.Cap.ROUND);
+        mNumber.setTextAlign(Paint.Align.CENTER);
+        mNumber.setTypeface(Typeface.DEFAULT_BOLD);
+        mNumber.setTextSize(sp(22));
+        mOutOf.setTextAlign(Paint.Align.CENTER);
+        mOutOf.setTextSize(sp(10));
+        mFill.setDuration(900);
+        mFill.setInterpolator(new DecelerateInterpolator(1.6f));
+        mFill.addUpdateListener(
+                animator -> {
+                    mShown = mScore * (float) animator.getAnimatedValue();
+                    invalidate();
+                });
+    }
+
+    /** Shows |score|, from 0 to 100, in |color|; filling the ring unless |animate| is false. */
+    void setScore(int score, @ColorInt int color, boolean animate) {
+        mScore = score;
+        mArc.setColor(color);
+        mFill.cancel();
+        if (animate && ValueAnimator.areAnimatorsEnabled()) {
+            mShown = 0;
+            mFill.setStartDelay(120);
+            mFill.start();
+        } else {
+            mShown = score;
+            invalidate();
+        }
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        mFill.cancel();
+        super.onDetachedFromWindow();
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        float size = Math.min(getWidth(), getHeight());
+        float cx = getWidth() / 2f;
+        float cy = getHeight() / 2f;
+        float radius = size / 2f - mStroke / 2f;
+        mOval.set(cx - radius, cy - radius, cx + radius, cy + radius);
+        @ColorInt int onSurface = MaterialColors.getColor(this, R.attr.colorOnSurface);
+        mTrack.setColor(ColorUtils.setAlphaComponent(onSurface, 31));
+        canvas.drawArc(mOval, 0, 360, false, mTrack);
+        float sweep = 360f * mShown / 100f;
+        if (sweep > 0) canvas.drawArc(mOval, -90, sweep, false, mArc);
+
+        mNumber.setColor(onSurface);
+        mOutOf.setColor(MaterialColors.getColor(this, R.attr.colorOnSurfaceVariant));
+        float numberHeight = -mNumber.ascent();
+        float outOfHeight = -mOutOf.ascent();
+        float top = cy - (numberHeight + outOfHeight) / 2f;
+        canvas.drawText(mFormat.format(Math.round(mShown)), cx, top + numberHeight, mNumber);
+        canvas.drawText(
+                "/" + mFormat.format(100), cx, top + numberHeight + outOfHeight, mOutOf);
+    }
+
+    private float sp(float value) {
+        return TypedValue.applyDimension(
+                TypedValue.COMPLEX_UNIT_SP, value, getResources().getDisplayMetrics());
+    }
+}
