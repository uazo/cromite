@@ -0,0 +1,94 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+#ifndef CHROME_BROWSER_CROMIKO_ANDROID_CROMIKO_POPUP_GUARD_H_
+#define CHROME_BROWSER_CROMIKO_ANDROID_CROMIKO_POPUP_GUARD_H_
+
+#include <cstdint>
+#include <vector>
+
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "url/gurl.h"
+
+namespace content {
+class NavigationThrottleRegistry;
+}  // namespace content
+
+namespace cromiko {
+
+// CromIKO: the pop-up guard. The pop-ups and redirects of a tab that CromIKO
+// holds are listed here: the ones of the popup blocker, of the framebust and
+// tab-under interventions and of the redirect throttle of this file. CromIKO
+// shows them in a toast, and the user decides whether to open them, even the
+// ones that Adblock Plus would close. See CromikoPopupGuard.java.
+class PopupGuard : public content::WebContentsObserver,
+                   public content::WebContentsUserData<PopupGuard> {
+ public:
+  PopupGuard(const PopupGuard&) = delete;
+  PopupGuard& operator=(const PopupGuard&) = delete;
+  ~PopupGuard() override;
+
+  // Whether CromIKO holds every pop-up and every redirect to another site of
+  // the page at |page_url|: the "Block all pop-ups" setting, CromIKO's default.
+  static bool HoldsAll(content::WebContents* web_contents,
+                       const GURL& page_url);
+
+  // Called after the popup blocker held a pop-up of |web_contents| to |url|.
+  static void OnPopupHeld(content::WebContents* web_contents,
+                          const GURL& url,
+                          bool user_gesture);
+
+  // Called after a redirect of |web_contents| to |url| was held.
+  static void OnRedirectHeld(content::WebContents* web_contents,
+                             const GURL& url,
+                             bool user_gesture);
+
+  // Adds the throttle that holds redirects to the navigations of the tab.
+  static void MaybeAddThrottle(content::NavigationThrottleRegistry& registry);
+
+  // Opens the pop-up or redirect |id|, past Adblock Plus if it is on its list.
+  void Open(int id);
+  // Forgets the pop-up or redirect |id|.
+  void Dismiss(int id);
+  // Allows the pop-ups and redirects of the site of the page, and opens |id|.
+  void AllowSite(int id);
+
+ private:
+  friend class content::WebContentsUserData<PopupGuard>;
+
+  struct Item {
+    int id = 0;
+    bool redirect = false;
+    GURL url;
+    bool user_gesture = false;
+    // Whether Adblock Plus would close it.
+    bool adblocked = false;
+    // For pop-ups: the id of the pop-up in the PopupBlockerTabHelper.
+    int32_t popup_id = 0;
+  };
+
+  explicit PopupGuard(content::WebContents* web_contents);
+
+  void Add(bool redirect, const GURL& url, bool user_gesture, int32_t popup_id);
+  std::vector<Item>::iterator Find(int id);
+  // Sends the list to the toast; |added| when something was just held.
+  void Notify(bool added);
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(
+      content::NavigationHandle* navigation_handle) override;
+  void OnVisibilityChanged(content::Visibility visibility) override;
+
+  std::vector<Item> items_;
+  int next_id_ = 1;
+  // Whether something was held while the tab was in the background, like a
+  // tab-under: the toast shows it when the tab comes to the front.
+  bool unseen_ = false;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace cromiko
+
+#endif  // CHROME_BROWSER_CROMIKO_ANDROID_CROMIKO_POPUP_GUARD_H_
diff --git a/chrome/browser/cromiko/android/java/src/org/chromium/chrome/browser/cromiko/CromikoPopupGuardBridge.java b/chrome/browser/cromiko/android/java/src/org/chromium/chrome/browser/cromiko/CromikoPopupGuardBridge.java
new file mode 100644
