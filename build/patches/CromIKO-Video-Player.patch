+    function run(cmd, opts, txt) {
+      if (txt) {
+        t = txt;
+      }
+      switch (cmd) {
+        case 'scan':
+          startScanning();
+          return {state: 'scanning'};
+        case 'probe': {
+          const media = bestMedia();
+          return {token, score: media ? mediaScore(media) : 0};
+        }
+        case 'open': {
+          if (opts && opts.token && opts.token !== token) {
+            return {opened: false};
+          }
+          const media = bestMedia();
+          if (!media) {
+            return {opened: false};
+          }
+          openPlayer(media);
+          return {opened: true};
+        }
+        case 'close':
+          closePlayer();
+          return {state: 'closed'};
+        case 'state':
+          return {
+            state: player ? 'playing' : scanning ? 'scanning' : 'idle',
+            buttons: buttons ? buttons.map.size : 0,
+            controls: !!player && player.root.classList.contains('visible'),
+            locked: !!player && player.locked,
+            audio: !!player && player.isAudio,
+            sleepMinutes: player ? player.sleepMinutes : 0,
+          };
+      }
+      return {state: 'unknown'};
+    }
