+    function isPlaying(media) {
+      return !media.paused && !media.ended && media.readyState > 2;
+    }
+
+    function isCandidate(media) {
+      if (!media.isConnected) {
+        return false;
+      }
+      if (media.tagName === 'AUDIO') {
+        return !media.paused;
+      }
+      // Muted looping videos without controls are decoration.
+      if (media.loop && media.muted && !media.controls) {
+        return false;
+      }
+      const r = media.getBoundingClientRect();
+      return (r.width >= 160 && r.height >= 90) ||
+          (!media.paused && r.width >= 80 && r.height >= 45);
+    }
+
+    function visibleArea(media) {
+      const r = media.getBoundingClientRect();
+      const w = Math.min(r.right, innerWidth) - Math.max(r.left, 0);
+      const h = Math.min(r.bottom, innerHeight) - Math.max(r.top, 0);
+      return Math.max(0, w) * Math.max(0, h);
+    }
+
+    function mediaScore(media) {
+      return (isPlaying(media) ? 1e9 : 0) + visibleArea(media) + 1;
+    }
