+        element('span', '', b, text);
+        if (value) {
+          element('span', 'value', b, value);
+        }
+      };
+      if (kind === 'speed') {
+        for (const rate of SPEEDS) {
+          item('rate:' + rate, rate === 1 ? (t.normal || 'Normal') : rate + 'x', '',
+               Math.abs(m.playbackRate - rate) < 0.01);
+        }
+      } else {
+        const on = t.on || 'On';
+        const off = t.off || 'Off';
+        item('loop', t.loop || 'Loop', m.loop ? on : off);
+        item('background', t.background || 'Background play', p.background ? on : off);
+        item('sleep', t.sleep || 'Sleep timer',
+             p.sleepMinutes ? p.sleepMinutes + ' min' : off);
+      }
+      menu.classList.add('show');
+      showControls(true);
+    }
+
+    function closeMenu() {
+      if (player && player.els.menu.classList.contains('show')) {
+        player.els.menu.classList.remove('show');
+        scheduleHide();
+      }
+    }
+
+    function nextSubtitles() {
+      const tracks = [...player.media.textTracks].filter(
+          track => track.kind === 'subtitles' || track.kind === 'captions');
+      if (!tracks.length) {
+        return;
+      }
+      const current = tracks.findIndex(track => track.mode === 'showing');
+      for (const track of tracks) {
+        track.mode = 'disabled';
+      }
+      const next = current + 1 < tracks.length ? tracks[current + 1] : null;
+      if (next) {
+        next.mode = 'showing';
+      }
+      showToast(next ? (next.label || next.language || (t.subtitles || 'Subtitles')) :
+                       (t.subtitlesOff || 'Subtitles off'));
+    }
+
+    function setSleepTimer(minutes) {
+      const p = player;
+      clearTimeout(p.sleepTimer);
+      p.sleepMinutes = minutes;
+      if (minutes) {
+        p.sleepTimer = setTimeout(() => {
+          if (player) {
+            player.media.pause();
+            player.sleepMinutes = 0;
+            showToast(t.sleepDone || 'Sleep timer: paused');
+          }
+        }, minutes * 60000);
+        showToast((t.sleep || 'Sleep timer') + ': ' + minutes + ' min');
+      } else {
+        showToast((t.sleep || 'Sleep timer') + ': ' + (t.off || 'Off'));
+      }
+    }
+
+    function saveSetting(name, value) {
+      const s = readStore(SETTINGS_KEY);
+      s[name] = value;
+      writeStore(SETTINGS_KEY, s);
+    }
+
+    // ---------------------------------------------------------------------
+    // Background play: sites often pause their video when the page is hidden.
+    // Right after the app goes to the background, such a pause is undone.
+
+    function onVisibility() {
+      const p = player;
+      if (document.visibilityState === 'hidden') {
+        p.hiddenAt = performance.now();
+        p.playingWhenHidden = !p.media.paused;
+      }
+    }
+
+    function onPause() {
+      const p = player;
+      if (p.background && document.visibilityState === 'hidden' &&
+          p.playingWhenHidden && performance.now() - p.hiddenAt < 2000) {
+        p.playingWhenHidden = false;
+        p.media.play().catch(() => {});
+      }
+    }
+
+    // ---------------------------------------------------------------------
+    // Continue where you stopped
+
+    function positionKey() {
+      const d = player.media.duration;
+      return isFinite(d) && d > 60 ? location.origin + location.pathname + '#' + Math.round(d) : null;
+    }
+
+    function savePosition() {
+      const p = player;
+      if (!p) {
+        return;
+      }
+      const key = positionKey();
+      if (!key) {
+        return;
+      }
+      const positions = readStore(POSITIONS_KEY);
+      const m = p.media;
+      if (m.currentTime > 15 && m.currentTime < m.duration - 20) {
+        positions[key] = {time: Math.floor(m.currentTime), at: Date.now()};
+      } else {
+        delete positions[key];
+      }
+      // Keep the 40 most recent.
+      const keys = Object.keys(positions).sort((a, b) => positions[b].at - positions[a].at);
+      for (const old of keys.slice(40)) {
+        delete positions[old];
+      }
+      writeStore(POSITIONS_KEY, positions);
+    }
+
+    function showResume() {
+      const p = player;
+      const show = () => {
+        if (!player) {
+          return;
+        }
+        const key = positionKey();
+        const saved = key && readStore(POSITIONS_KEY)[key];
+        if (!saved || p.media.currentTime > 5) {
+          return;
+        }
+        const chip = p.els.chip;
+        chip.textContent = '';
+        icon(chip, 'play');
+        element('span', '', chip, (t.resume || 'Continue at') + ' ' + formatTime(saved.time));
+        chip.setAttribute('data-time', String(saved.time));
+        chip.classList.add('show');
+        setTimeout(() => chip.classList.remove('show'), 7000);
+      };
+      if (p.media.readyState >= 1) {
+        show();
+      } else {
+        p.media.addEventListener('loadedmetadata', show, {once: true});
+      }
+    }
+
+    return {run};
+  }
+})(__CROMIKO_ARGS__);
