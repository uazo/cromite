 #include "base/functional/bind.h"
 #include "base/json/json_writer.h"
 #include "base/values.h"
@@ -34,6 +36,16 @@ void OnScriptResult(const ScopedJavaGlobalRef<jobject>& callback,
   base::android::RunStringCallbackAndroid(callback, text);
 }
 
+void OnAllFramesResult(const ScopedJavaGlobalRef<jobject>& callback,
+                       std::vector<base::Value> results) {
+  base::ListValue list;
+  for (base::Value& result : results) {
+    list.Append(std::move(result));
+  }
+  base::android::RunStringCallbackAndroid(
+      callback, base::WriteJson(list).value_or("[]"));
+}
+
 }  // namespace
 
 static void JNI_CromikoPageScripts_Execute(
@@ -56,4 +68,34 @@ static void JNI_CromikoPageScripts_Execute(
       ISOLATED_WORLD_ID_CHROME_INTERNAL);
 }
 
+static void JNI_CromikoPageScripts_ExecuteInAllFrames(
+    JNIEnv* env,
+    const JavaRef<jobject>& j_web_contents,
+    const JavaRef<jstring>& j_script,
+    const JavaRef<jobject>& j_callback) {
+  ScopedJavaGlobalRef<jobject> callback(env, j_callback);
+  content::WebContents* web_contents =
+      content::WebContents::FromJavaWebContents(j_web_contents);
+  std::vector<content::RenderFrameHost*> frames;
+  if (web_contents) {
+    web_contents->GetPrimaryMainFrame()->ForEachRenderFrameHost(
+        [&frames](content::RenderFrameHost* frame) {
+          if (frame->IsRenderFrameLive()) {
+            frames.push_back(frame);
+          }
+        });
+  }
+  if (frames.empty()) {
+    base::android::RunStringCallbackAndroid(callback, "[]");
+    return;
+  }
+  std::u16string script = base::android::ConvertJavaStringToUTF16(env, j_script);
+  auto on_result = base::BarrierCallback<base::Value>(
+      frames.size(), base::BindOnce(&OnAllFramesResult, std::move(callback)));
+  for (content::RenderFrameHost* frame : frames) {
+    frame->ExecuteJavaScriptInIsolatedWorld(script, on_result,
+                                            ISOLATED_WORLD_ID_CHROME_INTERNAL);
+  }
+}
+
 DEFINE_JNI(CromikoPageScripts)
