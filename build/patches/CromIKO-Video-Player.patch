+/**
+ * CromIKO: the CromIKO video player. Videos on web pages (also in frames of other sites) get a
+ * small CromIKO button that opens them in a full screen player with tap gestures, without the
+ * site's controls, overlays and ads. The page script is res/raw/cromiko_video.js.
+ */
+@NullMarked
+public final class CromikoVideoPlayer {
+    private static final String TAG = "CromikoVideo";
+    private static final String ARGS_PLACEHOLDER = "__CROMIKO_ARGS__";
+
+    private static @Nullable String sScript;
+    private static @Nullable String sTexts;
+
+    private CromikoVideoPlayer() {}
+
+    /** Handles the "CromIKO player" item of the app menu on |tab|. */
+    public static void onMenuItemSelected(@Nullable Tab tab) {
+        WebContents webContents = tab != null ? tab.getWebContents() : null;
+        if (tab == null || webContents == null || !isWebPage(tab.getUrl())) {
+            showNoMediaToast();
+            return;
+        }
+        // Every frame says how good its video is, then only the best frame opens its player.
+        run(
+                webContents,
+                "probe",
+                null,
+                results -> {
+                    String token = bestFrame(results);
+                    if (token == null) {
+                        showNoMediaToast();
+                        return;
+                    }
+                    JSONObject options = new JSONObject();
+                    try {
+                        options.put("token", token);
+                    } catch (JSONException e) {
+                        return;
+                    }
+                    run(webContents, "open", options.toString(), null);
+                });
+    }
+
+    /**
+     * Puts the CromIKO button on the videos of web pages when they load. Frames often load their
+     * player after the page, so this runs again whenever a page stops loading.
+     *
+     * @return The observer, to destroy with the activity.
+     */
+    public static TabModelSelectorTabObserver observeTabs(TabModelSelector tabModelSelector) {
+        return new TabModelSelectorTabObserver(tabModelSelector) {
+            @Override
+            public void onPageLoadFinished(Tab tab, GURL url) {
+                scan(tab);
+            }
+
+            @Override
+            public void onLoadStopped(Tab tab, boolean toDifferentDocument) {
+                scan(tab);
+            }
+        };
+    }
+
+    private static void scan(Tab tab) {
+        WebContents webContents = tab.getWebContents();
+        if (webContents != null && !tab.isNativePage() && isWebPage(tab.getUrl())) {
+            run(webContents, "scan", null, null);
+        }
+    }
+
+    private static void run(
+            WebContents webContents,
+            String command,
+            @Nullable String options,
+            @Nullable Callback<String> callback) {
+        String script = getScript();
+        if (script == null) return;
+        String args =
+                JSONObject.quote(command)
+                        + ", "
+                        + (options != null ? options : "null")
+                        + ", "
+                        + getTexts();
+        CromikoPageScripts.executeInAllFrames(
+                webContents,
+                script.replace(ARGS_PLACEHOLDER, args),
+                callback != null ? callback : result -> {});
+    }
+
+    private static boolean isWebPage(@Nullable GURL url) {
+        if (url == null || !url.isValid()) return false;
+        String scheme = url.getScheme();
+        return UrlConstants.HTTP_SCHEME.equals(scheme) || UrlConstants.HTTPS_SCHEME.equals(scheme);
+    }
+
+    /**
+     * The token of the frame with the best video or audio.
+     *
+     * @param results A JSON array with the result of "probe" in each frame.
+     */
+    private static @Nullable String bestFrame(String results) {
+        String best = null;
+        double bestScore = 0;
+        try {
+            JSONArray frames = new JSONArray(results);
+            for (int i = 0; i < frames.length(); i++) {
+                JSONObject result = new JSONObject(frames.optString(i, "{}"));
+                double score = result.optDouble("score", 0);
+                if (score > bestScore) {
+                    bestScore = score;
+                    best = result.optString("token", null);
+                }
+            }
+        } catch (JSONException e) {
+            // The results of a frame are not valid: use the others.
+        }
+        return best;
+    }
+
+    private static void showNoMediaToast() {
+        Toast.makeText(
+                        ContextUtils.getApplicationContext(),
+                        R.string.cromiko_video_player_no_media,
+                        Toast.LENGTH_SHORT)
+                .show();
+    }
+
+    private static @Nullable String getScript() {
+        if (sScript == null) {
+            Context context = ContextUtils.getApplicationContext();
+            try (InputStream stream = context.getResources().openRawResource(R.raw.cromiko_video)) {
+                sScript = new String(FileUtils.readStream(stream), StandardCharsets.UTF_8);
+            } catch (IOException e) {
+                Log.e(TAG, "Cannot read the video player script", e);
+            }
+        }
+        return sScript;
+    }
+
+    /** The texts of the page script, in the language of the app. */
+    private static String getTexts() {
+        if (sTexts != null) return sTexts;
+        Context context = ContextUtils.getApplicationContext();
+        JSONObject texts = new JSONObject();
+        Object[][] entries = {
+            {"open", R.string.cromiko_video_player_open},
+            {"hiddenOnPage", R.string.cromiko_video_player_hidden_on_page},
+            {"subtitles", R.string.cromiko_video_player_subtitles},
+            {"subtitlesOff", R.string.cromiko_video_player_subtitles_off},
+            {"speed", R.string.cromiko_video_player_speed},
+            {"normal", R.string.cromiko_video_player_normal_speed},
+            {"pip", R.string.cromiko_video_player_pip},
+            {"pipFailed", R.string.cromiko_video_player_pip_failed},
+            {"more", R.string.cromiko_video_player_more},
+            {"close", R.string.cromiko_video_player_close},
+            {"back", R.string.cromiko_video_player_back},
+            {"forward", R.string.cromiko_video_player_forward},
+            {"play", R.string.cromiko_video_player_play},
+            {"pause", R.string.cromiko_video_player_pause},
+            {"seek", R.string.cromiko_video_player_seek},
+            {"live", R.string.cromiko_video_player_live},
+            {"lock", R.string.cromiko_video_player_lock},
+            {"unlock", R.string.cromiko_video_player_unlock},
+            {"locked", R.string.cromiko_video_player_locked},
+            {"unlocked", R.string.cromiko_video_player_unlocked},
+            {"fit", R.string.cromiko_video_player_fit},
+            {"fitScreen", R.string.cromiko_video_player_fit_screen},
+            {"zoom", R.string.cromiko_video_player_zoom},
+            {"stretch", R.string.cromiko_video_player_stretch},
+            {"rotate", R.string.cromiko_video_player_rotate},
+            {"rotateFailed", R.string.cromiko_video_player_rotate_failed},
+            {"on", R.string.cromiko_video_player_on},
+            {"off", R.string.cromiko_video_player_off},
+            {"loop", R.string.cromiko_video_player_loop},
+            {"loopOn", R.string.cromiko_video_player_loop_on},
+            {"loopOff", R.string.cromiko_video_player_loop_off},
+            {"background", R.string.cromiko_video_player_background},
+            {"backgroundOn", R.string.cromiko_video_player_background_on},
+            {"backgroundOff", R.string.cromiko_video_player_background_off},
+            {"sleep", R.string.cromiko_video_player_sleep},
+            {"sleepDone", R.string.cromiko_video_player_sleep_done},
+            {"resume", R.string.cromiko_video_player_resume},
+        };
+        try {
+            for (Object[] entry : entries) {
+                texts.put((String) entry[0], context.getString((Integer) entry[1]));
+            }
+        } catch (JSONException e) {
+            // Not reached: the names and values are never null.
+        }
+        sTexts = texts.toString();
+        return sTexts;
+    }
+}
