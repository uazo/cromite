diff --git a/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoSettings.java b/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoSettings.java
new file mode 100644
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/cromiko/CromikoSettings.java
@@ -0,0 +1,164 @@
+// Copyright 2026 The CromIKO Authors
+// License: GPL-3.0-only - https://spdx.org/licenses/GPL-3.0-only.html
+
+package org.chromium.chrome.browser.cromiko;
+
+import android.app.StatusBarManager;
+import android.content.ComponentName;
+import android.content.Context;
+import android.graphics.drawable.Icon;
+import android.os.Build;
+import android.os.Bundle;
+
+import androidx.annotation.RequiresApi;
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import org.chromium.base.Log;
+import org.chromium.base.supplier.MonotonicObservableSupplier;
+import org.chromium.base.supplier.ObservableSuppliers;
+import org.chromium.base.supplier.SettableMonotonicObservableSupplier;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.incognito.reauth.IncognitoReauthSettingSwitchPreference;
+import org.chromium.chrome.browser.privacy.secure_dns.SecureDnsSettings;
+import org.chromium.chrome.browser.privacy.settings.IncognitoLockSettings;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.components.browser_ui.settings.SettingsUtils;
+import org.chromium.ui.widget.Toast;
+
+import java.text.NumberFormat;
+
+/**
+ * CromIKO: Settings > CromIKO, all CromIKO features in one place, with the icons of the logo. Most
+ * rows open the settings of a feature, which are also where Chromium has them (CromIKO DNS in
+ * Privacy, the accent color in Appearance, the download manager in Downloads). The incognito lock
+ * is set here, "Edit home screen" opens its dialog, the incognito tab tile asks Android to add it,
+ * and the features without settings say where to find them.
+ */
+@NullMarked
+public class CromikoSettings extends ChromeBaseSettingsFragment {
+    private static final String TAG = "CromikoSettings";
+
+    // The keys of the preferences in cromiko_preferences.xml.
+    private static final String PREF_DNS = "dns";
+    private static final String PREF_SHIELD_REPORT = "shield_report";
+    private static final String PREF_INCOGNITO_LOCK = "incognito_lock";
+    private static final String PREF_INCOGNITO_LOCK_DELAY = "incognito_lock_delay";
+    private static final String PREF_INCOGNITO_TILE = "incognito_tile";
+    private static final String PREF_HOME_SCREEN = "home_screen";
+
+    private final SettableMonotonicObservableSupplier<String> mPageTitle =
+            ObservableSuppliers.createMonotonic();
+    private @Nullable IncognitoLockSettings mIncognitoLockSettings;
+
+    @Override
+    public void onCreatePreferences(@Nullable Bundle savedInstanceState, @Nullable String rootKey) {
+        mPageTitle.set(getString(R.string.cromiko_settings_title));
+        SettingsUtils.addPreferencesFromResource(this, R.xml.cromiko_preferences);
+
+        // Like in Privacy and security, which has the same settings.
+        mIncognitoLockSettings =
+                new IncognitoLockSettings(
+                        (IncognitoReauthSettingSwitchPreference) findPreference(PREF_INCOGNITO_LOCK),
+                        getProfile());
+        mIncognitoLockSettings.setUpIncognitoReauthPreference(getActivity());
+        mIncognitoLockSettings.setUpLockDelayPreference(
+                getActivity(), (ListPreference) findPreference(PREF_INCOGNITO_LOCK_DELAY));
+
+        findPreference(PREF_HOME_SCREEN)
+                .setOnPreferenceClickListener(
+                        preference -> {
+                            CromikoHomeScreenEditor.show(
+                                    getActivity(), CromikoHomeScreen.getKnownAvailableWidgets());
+                            return true;
+                        });
+
+        Preference tile = findPreference(PREF_INCOGNITO_TILE);
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            tile.setOnPreferenceClickListener(
+                    preference -> {
+                        requestAddIncognitoTile();
+                        return true;
+                    });
+        } else {
+            tile.setSummary(R.string.cromiko_settings_tile_summary_edit);
+            tile.setSelectable(false);
+        }
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        // The pages that this one opens change them.
+        findPreference(PREF_DNS).setSummary(SecureDnsSettings.getSummary(requireContext()));
+        showShieldReportSummary();
+        if (mIncognitoLockSettings != null) {
+            mIncognitoLockSettings.updateIncognitoReauthPreferenceIfNeeded(getActivity());
+        }
+    }
+
+    @Override
+    public void onDestroy() {
+        if (mIncognitoLockSettings != null) mIncognitoLockSettings.destroy();
+        super.onDestroy();
+    }
+
+    private void showShieldReportSummary() {
+        JSONObject report;
+        try {
+            report = new JSONObject(CromikoShieldReportBridge.getReport(getProfile()));
+        } catch (JSONException e) {
+            Log.e(TAG, "Bad report", e);
+            report = new JSONObject();
+        }
+        NumberFormat format = NumberFormat.getIntegerInstance();
+        findPreference(PREF_SHIELD_REPORT)
+                .setSummary(
+                        getString(
+                                R.string.cromiko_settings_report_summary,
+                                format.format(report.optInt("blocked")),
+                                format.format(report.optInt("held"))));
+    }
+
+    // Asks Android to add the incognito tab tile to Quick Settings; Android asks the user.
+    @RequiresApi(Build.VERSION_CODES.TIRAMISU)
+    private void requestAddIncognitoTile() {
+        Context context = requireContext();
+        StatusBarManager statusBar = context.getSystemService(StatusBarManager.class);
+        if (statusBar == null) return;
+        statusBar.requestAddTileService(
+                new ComponentName(context, CromikoIncognitoTileService.class),
+                context.getString(R.string.cromiko_incognito_tile_label),
+                Icon.createWithResource(context, R.drawable.cromiko_ic_incognito_tile),
+                context.getMainExecutor(),
+                result -> {
+                    if (result == StatusBarManager.TILE_ADD_REQUEST_RESULT_TILE_ALREADY_ADDED) {
+                        Toast.makeText(
+                                        context,
+                                        R.string.cromiko_settings_tile_already_added,
+                                        Toast.LENGTH_SHORT)
+                                .show();
+                    }
+                });
+    }
+
+    @Override
+    public MonotonicObservableSupplier<String> getPageTitle() {
+        return mPageTitle;
+    }
+
+    @Override
+    public @AnimationType int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }
+
+    @Override
+    public @Nullable String getMainMenuKey() {
+        return "cromiko";
+    }
+}
