# CromIKO build arguments.
# tools/cromiko/build-android.sh appends these after cromite.gn_args, so
# anything set here overrides the Cromite value.

if (target_os == "android") {
  # Own application id, so that CromIKO installs next to Cromite instead of
  # clashing with it. Do not change it after publishing a release: Android
  # treats a different id as a different app.
  chrome_public_manifest_package = "org.cromiko.cromiko"

  # Release signing key, provided by the build script from the GitHub secrets
  # (see docs/BUILD_CROMIKO.md). Without it, Chromium's public debug key is
  # used, which is fine for testing but not for releases.
  if (getenv("CROMIKO_KEYSTORE_PATH") != "") {
    android_keystore_path = getenv("CROMIKO_KEYSTORE_PATH")
    android_keystore_name = getenv("CROMIKO_KEYSTORE_ALIAS")
    android_keystore_password = getenv("CROMIKO_KEYSTORE_PASSWORD")
  }
}
